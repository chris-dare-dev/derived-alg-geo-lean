import Mathlib.CategoryTheory.ShrinkYoneda
import Mathlib.CategoryTheory.Sites.Descent.IsStack
import Mathlib.CategoryTheory.Sites.Hypercover.Zero
import Mathlib.CategoryTheory.Sites.PseudofunctorSheafOver
import Mathlib.CategoryTheory.Sites.SheafHom

/-!
# Sheaves on the slices of a site form a stack

Let `J` be a Grothendieck topology on a category `C`. Mathlib's
`GrothendieckTopology.pseudofunctorOver J A` sends `S : C` to the category of `A`-valued
sheaves on `Over S`, with pullback along `Over.map`. This file shows that it satisfies descent.

## Main results

* `GrothendieckTopology.isPrestack_pseudofunctorOver`: for every category `A`, morphisms of
  sheaves glue, that is `(J.pseudofunctorOver A).IsPrestack J`. The presheaf of morphisms between
  two pullbacks is identified with Mathlib's `presheafHom` through the iterated slice
  equivalence, and that presheaf is a sheaf by `Presheaf.IsSheaf.hom`.
* `GrothendieckTopology.isStack_pseudofunctorOver`: sheaves of types glue, that is
  `(J.pseudofunctorOver (Type w)).IsStack J`, when every covering sieve of `J` contains a
  `w`-small covering family (`Precoverage.Small.{w} J.toPrecoverage`). This holds for every site
  when `w` is `max u v`.

## Implementation notes

The glued sheaf is the formula of the proof of Stacks Tag 04TR. Given a covering sieve `R` of
`S` and descent data `D` for the arrows of `R`, its sections over `T : Over S` are the
families of sections `x i g ∈ (D.obj i)(𝟙)`, one for each member `i` of `R` and each morphism
`g : i ⟶ T`, that agree on overlaps through the transition morphisms of `D`. These families
form a sheaf in `Type (max u v w)`; the smallness hypothesis embeds them into a product of
sections over a `w`-small covering family, which shrinks the sheaf to `Type w`.

The hypothesis cannot be dropped. Let `C` have objects `S` and `X a`, for `a` in a type that is
not `w`-small, whose only morphisms besides identities are one arrow `X a ⟶ S` for each `a`, and
let the sieve generated by these arrows cover `S`. The descent datum with a two-element sheaf on
each `Over (X a)` has no glueing in `Type w`: its sections over `S` would be all functions from
that type to a two-element type. The Stacks Project avoids the issue by working with a
set-sized site.

## References

* [Stacks Project, Tag 04TR](https://stacks.math.columbia.edu/tag/04TR)
* [Stacks Project, Tag 026F](https://stacks.math.columbia.edu/tag/026F)

## Tags

stack, descent, sheaf, glueing
-/

universe w v' v u' u

namespace CategoryTheory

open Opposite Bicategory Pseudofunctor.LocallyDiscreteOpToCat

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  (A : Type u') [Category.{v'} A]

namespace GrothendieckTopology

set_option backward.defeqAttrib.useBackward true in
private lemma mapComp'_hom_app_hom_app_aux {X₀ X₁ X₂ : C} (f : X₁ ⟶ X₀) (g : X₂ ⟶ X₁)
    (fg : X₂ ⟶ X₀) (h : g ≫ f = fg) (M : Sheaf (J.over X₀) A) (Z : Over X₂) :
    (((J.pseudofunctorOver A).mapComp' f.op.toLoc g.op.toLoc fg.op.toLoc
      (by rw [← Quiver.Hom.comp_toLoc, ← op_comp, h])).hom.toNatTrans.app M).hom.app (op Z) =
      M.obj.map (Over.homMk (𝟙 Z.left) (by simp [← h]) :
        Over.mk ((Z.hom ≫ g) ≫ f) ⟶ Over.mk (Z.hom ≫ fg)).op := by
  subst h
  simp [Pseudofunctor.mapComp'_eq_mapComp]
  congr 2

set_option backward.defeqAttrib.useBackward true in
private lemma mapComp'_inv_app_hom_app_aux {X₀ X₁ X₂ : C} (f : X₁ ⟶ X₀) (g : X₂ ⟶ X₁)
    (fg : X₂ ⟶ X₀) (h : g ≫ f = fg) (M : Sheaf (J.over X₀) A) (Z : Over X₂) :
    (((J.pseudofunctorOver A).mapComp' f.op.toLoc g.op.toLoc fg.op.toLoc
      (by rw [← Quiver.Hom.comp_toLoc, ← op_comp, h])).inv.toNatTrans.app M).hom.app (op Z) =
      M.obj.map (Over.homMk (𝟙 Z.left) (by simp [← h]) :
        Over.mk (Z.hom ≫ fg) ⟶ Over.mk ((Z.hom ≫ g) ≫ f)).op := by
  subst h
  simp [Pseudofunctor.mapComp'_eq_mapComp]
  congr 2

/-- The composition isomorphisms of `J.pseudofunctorOver A` are, on sections, restriction along
the identity between two presentations of the same object of `Over X₂`. -/
lemma pseudofunctorOver_mapComp'_hom_app_hom_app {X₀ X₁ X₂ : C} (f : X₁ ⟶ X₀) (g : X₂ ⟶ X₁)
    (fg : X₂ ⟶ X₀) (h : g ≫ f = fg) (M : (J.pseudofunctorOver A).obj (.mk (op X₀))) (Z : Over X₂) :
    (((J.pseudofunctorOver A).mapComp' f.op.toLoc g.op.toLoc fg.op.toLoc
      (by rw [← Quiver.Hom.comp_toLoc, ← op_comp, h])).hom.toNatTrans.app M).hom.app (op Z) =
      M.obj.map (Over.homMk (𝟙 Z.left) (by simp [← h]) :
        Over.mk ((Z.hom ≫ g) ≫ f) ⟶ Over.mk (Z.hom ≫ fg)).op :=
  mapComp'_hom_app_hom_app_aux J A f g fg h M Z

/-- The inverse of `pseudofunctorOver_mapComp'_hom_app_hom_app`. -/
lemma pseudofunctorOver_mapComp'_inv_app_hom_app {X₀ X₁ X₂ : C} (f : X₁ ⟶ X₀) (g : X₂ ⟶ X₁)
    (fg : X₂ ⟶ X₀) (h : g ≫ f = fg) (M : (J.pseudofunctorOver A).obj (.mk (op X₀))) (Z : Over X₂) :
    (((J.pseudofunctorOver A).mapComp' f.op.toLoc g.op.toLoc fg.op.toLoc
      (by rw [← Quiver.Hom.comp_toLoc, ← op_comp, h])).inv.toNatTrans.app M).hom.app (op Z) =
      M.obj.map (Over.homMk (𝟙 Z.left) (by simp [← h]) :
        Over.mk (Z.hom ≫ fg) ⟶ Over.mk ((Z.hom ≫ g) ≫ f)).op :=
  mapComp'_inv_app_hom_app_aux J A f g fg h M Z

variable {J A}

/-- Composition in the fibres of `J.pseudofunctorOver A` is composition of sheaf morphisms. -/
lemma pseudofunctorOver_comp_hom_app {X : C} {M₁ M₂ M₃ : (J.pseudofunctorOver A).obj (.mk (op X))}
    (a : M₁ ⟶ M₂) (b : M₂ ⟶ M₃) (Z : (Over X)ᵒᵖ) :
    (a ≫ b).hom.app Z = a.hom.app Z ≫ b.hom.app Z := rfl

set_option backward.defeqAttrib.useBackward true in
/-- `pullHom` for `J.pseudofunctorOver A`, on sections: the components of the pulled back
morphism are those of the original one, conjugated by restrictions along identities. -/
lemma pseudofunctorOver_pullHom_hom_app {X₁ X₂ Y Y' : C}
    {M₁ : (J.pseudofunctorOver A).obj (.mk (op X₁))}
    {M₂ : (J.pseudofunctorOver A).obj (.mk (op X₂))} {f₁ : Y ⟶ X₁} {f₂ : Y ⟶ X₂}
    (φ : ((J.pseudofunctorOver A).map f₁.op.toLoc).toFunctor.obj M₁ ⟶
      ((J.pseudofunctorOver A).map f₂.op.toLoc).toFunctor.obj M₂)
    (g : Y' ⟶ Y) (gf₁ : Y' ⟶ X₁) (gf₂ : Y' ⟶ X₂) (hgf₁ : g ≫ f₁ = gf₁) (hgf₂ : g ≫ f₂ = gf₂)
    (Z : Over Y') :
    (pullHom φ g gf₁ gf₂ hgf₁ hgf₂).hom.app (op Z) =
      M₁.obj.map (Over.homMk (𝟙 Z.left) (by simp [← hgf₁]) :
          Over.mk ((Z.hom ≫ g) ≫ f₁) ⟶ Over.mk (Z.hom ≫ gf₁)).op ≫
        φ.hom.app (op ((Over.map g).obj Z)) ≫
          M₂.obj.map (Over.homMk (𝟙 Z.left) (by simp [← hgf₂]) :
            Over.mk (Z.hom ≫ gf₂) ⟶ Over.mk ((Z.hom ≫ g) ≫ f₂)).op := by
  dsimp only [pullHom]
  rw [pseudofunctorOver_comp_hom_app, pseudofunctorOver_comp_hom_app,
    pseudofunctorOver_mapComp'_hom_app_hom_app _ _ _ _ _ hgf₁,
    pseudofunctorOver_mapComp'_inv_app_hom_app _ _ _ _ _ hgf₂]
  rfl

/-- A morphism of the restrictions to `Over T`, as a morphism of the pullbacks to
`Over T.left`, through the iterated slice equivalence. -/
private def presheafHomToPseudofunctorOver {S : C}
    (M N : (J.pseudofunctorOver A).obj (.mk (op S))) (T : Over S)
    (ψ : (presheafHom M.obj N.obj).obj (op T)) :
    ((J.pseudofunctorOver A).presheafHom M N).obj (op T) :=
  ObjectProperty.homMk (Functor.whiskerLeft (Over.iteratedSliceBackward T).op ψ)

private lemma bijective_presheafHomToPseudofunctorOver {S : C}
    (M N : (J.pseudofunctorOver A).obj (.mk (op S))) (T : Over S) :
    Function.Bijective (presheafHomToPseudofunctorOver M N T) :=
  (Equiv.bijective ⟨ObjectProperty.homMk, fun φ ↦ φ.hom, fun _ ↦ rfl, fun _ ↦ rfl⟩).comp
    (((Over.iteratedSliceEquiv T).op.congrLeft (E := A)).fullyFaithfulFunctor.map_bijective _ _)

set_option backward.defeqAttrib.useBackward true in
private lemma presheafHomToPseudofunctorOver_naturality {S : C}
    (M N : (J.pseudofunctorOver A).obj (.mk (op S)))
    {T T' : Over S} (h : T' ⟶ T) (ψ : (presheafHom M.obj N.obj).obj (op T)) :
    presheafHomToPseudofunctorOver M N T' (Functor.whiskerLeft (Over.map h).op ψ) =
      pullHom (F := J.pseudofunctorOver A) (presheafHomToPseudofunctorOver M N T ψ)
        h.left T'.hom T'.hom (Over.w h) (Over.w h) := by
  refine Sheaf.hom_ext ?_
  ext Z
  rw [pseudofunctorOver_pullHom_hom_app]
  change ψ.app (op ((Over.map h).obj ((Over.iteratedSliceBackward T').obj Z.unop))) =
    M.obj.map (Over.homMk (𝟙 Z.unop.left) (by simp) :
        Over.mk ((Z.unop.hom ≫ h.left) ≫ T.hom) ⟶ Over.mk (Z.unop.hom ≫ T'.hom)).op ≫
      ψ.app (op ((Over.iteratedSliceBackward T).obj ((Over.map h.left).obj Z.unop))) ≫
        N.obj.map (Over.homMk (𝟙 Z.unop.left) (by simp) :
          Over.mk (Z.unop.hom ≫ T'.hom) ⟶ Over.mk ((Z.unop.hom ≫ h.left) ≫ T.hom)).op
  let u : (Over.iteratedSliceBackward T).obj ((Over.map h.left).obj Z.unop) ⟶
      (Over.map h).obj ((Over.iteratedSliceBackward T').obj Z.unop) :=
    Over.homMk (Over.homMk (𝟙 _) (by simp)) (by ext; simp)
  have := ψ.naturality u.op
  dsimp only [u, Over.homMk_left] at this
  erw [reassoc_of% this, ← Functor.map_comp, ← op_comp]
  refine (Category.comp_id _).symm.trans ?_
  congr 1
  refine (N.obj.map_id _).symm.trans ?_
  congr 1
  apply Quiver.Hom.unop_inj
  ext
  simp

variable (J A) in
/-- Morphisms of sheaves on the slices of a site glue, for every coefficient category `A`: the
presheaf of morphisms between two pullbacks is a sheaf. -/
instance isPrestack_pseudofunctorOver : (J.pseudofunctorOver A).IsPrestack J where
  isSheaf {S} M N := by
    refine (Presheaf.isSheaf_of_iso_iff (NatIso.ofComponents
      (fun T ↦ (Equiv.ofBijective _
        (bijective_presheafHomToPseudofunctorOver M N T.unop)).toIso) ?_)).1
      (N.property.hom M.obj)
    rintro ⟨T⟩ ⟨T'⟩ ⟨h : T' ⟶ T⟩
    ext ψ
    exact presheafHomToPseudofunctorOver_naturality M N h ψ

namespace PseudofunctorOver

private lemma homMk_id_op_comp {X W : C} {p₁ p₂ p₃ : W ⟶ X} (h₁ : 𝟙 W ≫ p₁ = p₂)
    (h₂ : 𝟙 W ≫ p₂ = p₃) (h₃ : 𝟙 W ≫ p₁ = p₃) :
    (Over.homMk (𝟙 W) h₁ : Over.mk p₂ ⟶ Over.mk p₁).op ≫
        (Over.homMk (𝟙 W) h₂ : Over.mk p₃ ⟶ Over.mk p₂).op =
      (Over.homMk (𝟙 W) h₃ : Over.mk p₃ ⟶ Over.mk p₁).op := by
  apply Quiver.Hom.unop_inj
  ext
  simp

/-- Sections of a sheaf on `Over X` at an arrow `a : W ⟶ X`. -/
private abbrev sec {X : C} (N : Sheaf (J.over X) (Type w)) {W : C} (a : W ⟶ X) : Type w :=
  N.obj.obj (op (Over.mk a))

/-- Restriction of sections along a morphism `c` over `X`. -/
private def res {X : C} (N : Sheaf (J.over X) (Type w)) {W W' : C} {a : W ⟶ X} {a' : W' ⟶ X}
    (c : W' ⟶ W) (h : c ≫ a = a') (y : sec N a) : sec N a' :=
  N.obj.map (Over.homMk c h : Over.mk a' ⟶ Over.mk a).op y

section res

variable {X : C} (N : Sheaf (J.over X) (Type w))

@[simp]
private lemma res_res {W W' W'' : C} {a : W ⟶ X} {a' : W' ⟶ X} {a'' : W'' ⟶ X}
    (c : W' ⟶ W) (h : c ≫ a = a') (c' : W'' ⟶ W') (h' : c' ≫ a' = a'') (y : sec N a) :
    res N c' h' (res N c h y) = res N (c' ≫ c) (by simp [h, h']) y := by
  simp only [res, ← comp_apply, ← Functor.map_comp, ← op_comp]
  rfl

private lemma res_eq_self {W : C} {a : W ⟶ X} (c : W ⟶ W) (h : c ≫ a = a) (hc : c = 𝟙 W)
    (y : sec N a) : res N c h y = y := by
  subst hc
  have : (Over.homMk (𝟙 W) h : Over.mk a ⟶ Over.mk a) = 𝟙 _ := by ext; simp
  simp [res, this]

private lemma res_congr {W W' : C} {a : W ⟶ X} {a' : W' ⟶ X} {c c' : W' ⟶ W} (hc : c = c')
    (h : c ≫ a = a') (y : sec N a) : res N c h y = res N c' (hc ▸ h) y := by
  subst hc
  rfl

private lemma res_eq_res_res {W W' : C} {a : W ⟶ X} {a' : W' ⟶ X} (c : W' ⟶ W) (h : c ≫ a = a')
    (y : sec N a) : res N c h y = res N (𝟙 W') (by simp [h]) (res N c rfl y) := by
  rw [res_res, res_congr _ (Category.id_comp c)]

private lemma map_eq_res {Z Z' : Over X} (u : Z' ⟶ Z) (y : N.obj.obj (op Z)) :
    N.obj.map u.op y = res N (a := Z.hom) u.left (Over.w u) y :=
  rfl

private lemma isSheafFor {Z : Over X} (s : Sieve Z.left) (hs : s ∈ J Z.left) :
    Presieve.IsSheafFor N.obj ((Sieve.overEquiv Z).symm s).arrows :=
  (isSheaf_iff_isSheaf_of_type _ _).1 N.property _
    (J.overEquiv_symm_mem_over Z s hs)

/-- Sections at `b : W ⟶ X` are determined by their restrictions along a covering sieve
of `W`. -/
private lemma sec_ext {W : C} (b : W ⟶ X) (s : Sieve W) (hs : s ∈ J W) {y y' : sec N b}
    (H : ∀ ⦃W' : C⦄ (c : W' ⟶ W), s c → res N c rfl y = res N c rfl y') : y = y' := by
  refine (isSheafFor N (Z := Over.mk b) s hs).isSeparatedFor.ext fun Z u hu ↦ ?_
  rw [map_eq_res, map_eq_res]
  have e (t : sec N b) : res N (a := (Over.mk b).hom) u.left (Over.w u) t =
      res N (𝟙 Z.left) (by simpa using Over.w u) (res N u.left rfl t) := by
    rw [res_res, res_congr _ (Category.id_comp u.left)]
  rw [e, e, H u.left hu]

/-- Base-point sections are determined by their restrictions along a covering sieve. -/
private lemma base_ext (s : Sieve X) (hs : s ∈ J X) {y y' : sec N (𝟙 X)}
    (H : ∀ ⦃W : C⦄ (c : W ⟶ X), s c →
      res N c (Category.comp_id c) y = res N c (Category.comp_id c) y') : y = y' := by
  refine sec_ext N (𝟙 X) s hs fun W c hc ↦ ?_
  have e (t : sec N (𝟙 X)) : res N c rfl t =
      res N (𝟙 W) (by simp) (res N c (Category.comp_id c) t) := by
    rw [res_res, res_congr _ (Category.id_comp c)]
  rw [e, e, H c hc]

/-- Sections at the base point are glued from compatible sections along a covering
sieve. -/
private lemma exists_glue (s : Sieve X) (hs : s ∈ J X) (y : ∀ ⦃W : C⦄ (a : W ⟶ X), s a → sec N a)
    (hy : ∀ ⦃W W' : C⦄ (a : W ⟶ X) (ha : s a) (c : W' ⟶ W),
      res N c rfl (y a ha) = y (c ≫ a) (s.downward_closed ha c)) :
    ∃ t : sec N (𝟙 X), ∀ ⦃W : C⦄ (a : W ⟶ X) (ha : s a),
      res N a (Category.comp_id a) t = y a ha := by
  let fam : Presieve.FamilyOfElements N.obj ((Sieve.overEquiv (Over.mk (𝟙 X))).symm s).arrows :=
    fun Z u hu ↦ res N (𝟙 Z.left) (by simpa using Over.w u) (y u.left hu)
  have hfam : fam.Compatible := by
    rw [Presieve.compatible_iff_sieveCompatible]
    intro Z Z' u v hu
    simp only [fam]
    rw [map_eq_res, res_res, res_congr _ (Category.comp_id v.left), res_eq_res_res _ v.left,
      hy u.left hu v.left]
    rfl
  obtain ⟨t, ht, -⟩ := isSheafFor N (Z := Over.mk (𝟙 X)) s hs fam hfam
  refine ⟨t, fun W a ha ↦ ?_⟩
  have := ht (Over.homMk a (Category.comp_id a) : Over.mk a ⟶ Over.mk (𝟙 X)) ha
  rw [map_eq_res] at this
  exact this.trans (res_eq_self _ _ _ rfl _)

end res

variable {S : C} {R : Sieve S}
  (D : (J.pseudofunctorOver (Type w)).DescentData (fun (f : R.arrows.category) ↦ f.obj.hom))

/-- The objects of a descent datum, as sheaves. -/
private abbrev dobj (i : R.arrows.category) : Sheaf (J.over i.obj.left) (Type w) := D.obj i

/-- The transition morphisms of a descent datum, on sections. -/
private def dapp {Y : C} (q : Y ⟶ S) {i₁ i₂ : R.arrows.category} (f₁ : Y ⟶ i₁.obj.left)
    (f₂ : Y ⟶ i₂.obj.left) (hf₁ : f₁ ≫ i₁.obj.hom = q) (hf₂ : f₂ ≫ i₂.obj.hom = q)
    (Z : Over Y) (y : sec (dobj D i₁) (Z.hom ≫ f₁)) : sec (dobj D i₂) (Z.hom ≫ f₂) :=
  (D.hom q f₁ f₂ hf₁ hf₂).hom.app (op Z) y

section dapp

variable {Y : C} (q : Y ⟶ S) {i₁ i₂ : R.arrows.category} (f₁ : Y ⟶ i₁.obj.left)
  (f₂ : Y ⟶ i₂.obj.left) (hf₁ : f₁ ≫ i₁.obj.hom = q) (hf₂ : f₂ ≫ i₂.obj.hom = q)

private lemma dapp_res {Z Z' : Over Y} (c : Z'.left ⟶ Z.left) (hc : c ≫ Z.hom = Z'.hom)
    (h₁ : c ≫ Z.hom ≫ f₁ = Z'.hom ≫ f₁) (h₂ : c ≫ Z.hom ≫ f₂ = Z'.hom ≫ f₂)
    (y : sec (dobj D i₁) (Z.hom ≫ f₁)) :
    dapp D q f₁ f₂ hf₁ hf₂ Z' (res _ c h₁ y) = res _ c h₂ (dapp D q f₁ f₂ hf₁ hf₂ Z y) :=
  NatTrans.naturality_apply (D.hom q f₁ f₂ hf₁ hf₂).hom (Over.homMk c hc : Z' ⟶ Z).op y

private lemma dapp_self (Z : Over Y) (y : sec (dobj D i₁) (Z.hom ≫ f₁)) :
    dapp D q f₁ f₁ hf₁ hf₁ Z y = y := by
  rw [dapp, D.hom_self q f₁ hf₁]
  rfl

private lemma dapp_comp {i₃ : R.arrows.category} (f₃ : Y ⟶ i₃.obj.left) (hf₃ : f₃ ≫ i₃.obj.hom = q)
    (Z : Over Y) (y : sec (dobj D i₁) (Z.hom ≫ f₁)) :
    dapp D q f₂ f₃ hf₂ hf₃ Z (dapp D q f₁ f₂ hf₁ hf₂ Z y) = dapp D q f₁ f₃ hf₁ hf₃ Z y := by
  rw [dapp, dapp, dapp, ← D.hom_comp q f₁ f₂ f₃ hf₁ hf₂ hf₃]
  rfl

private lemma dapp_pull {Y' : C} (g : Y' ⟶ Y) (q' : Y' ⟶ S) (hq : g ≫ q = q')
    (gf₁ : Y' ⟶ i₁.obj.left) (gf₂ : Y' ⟶ i₂.obj.left) (hgf₁ : g ≫ f₁ = gf₁)
    (hgf₂ : g ≫ f₂ = gf₂) (hgf₁' : gf₁ ≫ i₁.obj.hom = q') (hgf₂' : gf₂ ≫ i₂.obj.hom = q')
    (Z : Over Y') (y : sec (dobj D i₁) (Z.hom ≫ gf₁)) :
    dapp D q' gf₁ gf₂ hgf₁' hgf₂' Z y =
      res _ (𝟙 Z.left) (by simp [← hgf₂])
        (dapp D q f₁ f₂ hf₁ hf₂ ((Over.map g).obj Z) (res _ (𝟙 Z.left) (by simp [← hgf₁]) y)) := by
  rw [dapp, ← D.pullHom_hom g q q' hq f₁ f₂ hf₁ hf₂ gf₁ gf₂ hgf₁ hgf₂]
  erw [pseudofunctorOver_pullHom_hom_app]
  rfl

private lemma dapp_congr {q' : Y ⟶ S} (hq : q = q') (hf₁' : f₁ ≫ i₁.obj.hom = q')
    (hf₂' : f₂ ≫ i₂.obj.hom = q') (Z : Over Y) (y : sec (dobj D i₁) (Z.hom ≫ f₁)) :
    dapp D q f₁ f₂ hf₁ hf₂ Z y = dapp D q' f₁ f₂ hf₁' hf₂' Z y := by
  subst hq
  rfl

end dapp

/-- The transition maps of a descent datum, at a base point `W`. -/
private def transit {W : C} {i j : R.arrows.category} (a : W ⟶ i.obj.left) (b : W ⟶ j.obj.left)
    (h : a ≫ i.obj.hom = b ≫ j.obj.hom) (y : sec (dobj D i) a) : sec (dobj D j) b :=
  res _ (𝟙 W) (by simp)
    (dapp D (a ≫ i.obj.hom) a b rfl h.symm (Over.mk (𝟙 W)) (res _ (𝟙 W) (by simp) y))

section transit

variable {W : C} {i j k : R.arrows.category}

private lemma dapp_eq_transit {Y : C} (q : Y ⟶ S) (f₁ : Y ⟶ i.obj.left) (f₂ : Y ⟶ j.obj.left)
    (hf₁ : f₁ ≫ i.obj.hom = q) (hf₂ : f₂ ≫ j.obj.hom = q) (Z : Over Y)
    (y : sec (dobj D i) (Z.hom ≫ f₁)) :
    dapp D q f₁ f₂ hf₁ hf₂ Z y = transit D (Z.hom ≫ f₁) (Z.hom ≫ f₂) (by simp [hf₁, hf₂]) y := by
  simp only [transit]
  rw [dapp_pull D q f₁ f₂ hf₁ hf₂ Z.hom _ (by simp [hf₁]) _ _ rfl rfl, res_res, res_res,
    dapp_res D q f₁ f₂ hf₁ hf₂ (Z := Z) _ (by simp) (by simp) (by simp), res_res,
    res_eq_self _ _ _ (by simp)]

private lemma transit_self (a : W ⟶ i.obj.left) (h : a ≫ i.obj.hom = a ≫ i.obj.hom)
    (y : sec (dobj D i) a) :
    transit D a a h y = y := by
  simp only [transit]
  rw [dapp_self, res_res, res_eq_self _ _ _ (by simp)]

private lemma transit_comp (a : W ⟶ i.obj.left) (b : W ⟶ j.obj.left) (c : W ⟶ k.obj.left)
    (h₁ : a ≫ i.obj.hom = b ≫ j.obj.hom) (h₂ : b ≫ j.obj.hom = c ≫ k.obj.hom)
    (h₃ : a ≫ i.obj.hom = c ≫ k.obj.hom) (y : sec (dobj D i) a) :
    transit D b c h₂ (transit D a b h₁ y) = transit D a c h₃ y := by
  simp only [transit]
  rw [res_res, res_eq_self _ _ _ (by simp),
    dapp_congr D (b ≫ j.obj.hom) _ _ _ _ h₁.symm h₁.symm h₃.symm,
    dapp_comp]

private lemma transit_res {W' : C} (a : W ⟶ i.obj.left) (b : W ⟶ j.obj.left)
    (h : a ≫ i.obj.hom = b ≫ j.obj.hom) (c : W' ⟶ W) {a' : W' ⟶ i.obj.left}
    {b' : W' ⟶ j.obj.left} (ha : c ≫ a = a') (hb : c ≫ b = b')
    (h' : a' ≫ i.obj.hom = b' ≫ j.obj.hom) (y : sec (dobj D i) a) :
    transit D a' b' h' (res _ c ha y) = res _ c hb (transit D a b h y) := by
  subst ha hb
  have e₁ := dapp_eq_transit D (a ≫ i.obj.hom) a b rfl h.symm (Over.mk c) (res _ c rfl y)
  have e₂ := dapp_res D (a ≫ i.obj.hom) a b rfl h.symm (Z := Over.mk (𝟙 W)) (Z' := Over.mk c)
    c (by simp) (by simp) (by simp) (res _ (𝟙 W) (by simp) y)
  rw [res_res, res_congr _ (Category.comp_id c)] at e₂
  conv_rhs => unfold transit
  rw [res_res, res_congr _ (Category.comp_id c)]
  exact e₁.symm.trans e₂

private lemma transit_eq_res (a b : W ⟶ i.obj.left) (hab : a = b)
    (h : a ≫ i.obj.hom = b ≫ i.obj.hom)
    (y : sec (dobj D i) a) : transit D a b h y = res _ (𝟙 W) (by simp [hab]) y := by
  subst hab
  rw [transit_self, res_eq_self _ _ _ rfl]

private lemma transit_symm (a : W ⟶ i.obj.left) (b : W ⟶ j.obj.left)
    (h : a ≫ i.obj.hom = b ≫ j.obj.hom)
    (y : sec (dobj D i) a) : transit D b a h.symm (transit D a b h y) = y := by
  rw [transit_comp D a b a h h.symm rfl, transit_self]

private lemma transit_injective (a : W ⟶ i.obj.left) (b : W ⟶ j.obj.left)
    (h : a ≫ i.obj.hom = b ≫ j.obj.hom) : Function.Injective (transit D a b h) :=
  Function.LeftInverse.injective (transit_symm D a b h)

end transit

/-- The object of `R.arrows.category` obtained by restricting `i` along `c`. -/
private abbrev restr (i : R.arrows.category) {W : C} (c : W ⟶ i.obj.left) : R.arrows.category :=
  ⟨Over.mk (c ≫ i.obj.hom), R.downward_closed i.property c⟩

/-- The morphism from `restr i c` to `i`. -/
private abbrev restrι (i : R.arrows.category) {W : C} (c : W ⟶ i.obj.left) :
    (restr i c).obj ⟶ i.obj :=
  Over.homMk c rfl

private lemma mem_iff_overEquiv_left {T : Over S} (Q : Sieve T) {A : Over S}
    (f : A ⟶ T) : Q f ↔ Sieve.overEquiv T Q f.left := by
  rw [← Sieve.overEquiv_symm_iff, OrderIso.symm_apply_apply]

private lemma glue_aux {T : Over S} {i₁ i₂ : R.arrows.category} (g₁ : i₁.obj ⟶ T) (g₂ : i₂.obj ⟶ T)
    {W : C} (a : W ⟶ i₁.obj.left) (b : W ⟶ i₂.obj.left) (h : a ≫ g₁.left = b ≫ g₂.left) :
    a ≫ i₁.obj.hom = b ≫ i₂.obj.hom := by
  rw [← Over.w g₁, ← Over.w g₂, reassoc_of% h]

/-- Compatible families of base-point sections of a descent datum over `T : Over S`. -/
@[ext]
private structure Glue (T : Over S) : Type (max u v w) where
  /-- The section at each member of the sieve mapping to `T`. -/
  val (i : R.arrows.category) (g : i.obj ⟶ T) : sec (dobj D i) (𝟙 i.obj.left)
  compat (i₁ i₂ : R.arrows.category) (g₁ : i₁.obj ⟶ T) (g₂ : i₂.obj ⟶ T) (W : C)
    (a : W ⟶ i₁.obj.left) (b : W ⟶ i₂.obj.left) (h : a ≫ g₁.left = b ≫ g₂.left) :
    transit D a b (glue_aux g₁ g₂ a b h) (res _ a (Category.comp_id a) (val i₁ g₁)) =
      res _ b (Category.comp_id b) (val i₂ g₂)

/-- The presheaf of compatible families of a descent datum. -/
@[simps]
private def gluePresheaf : (Over S)ᵒᵖ ⥤ Type (max u v w) where
  obj T := Glue D T.unop
  map {T T'} h := ↾fun x ↦ ⟨fun i g ↦ x.val i (g ≫ h.unop),
    fun i₁ i₂ g₁ g₂ W a b hab ↦ x.compat i₁ i₂ _ _ W a b (by simp [reassoc_of% hab])⟩
  map_id T := by
    ext x i g
    change x.val i (g ≫ 𝟙 _) = x.val i g
    rw [Category.comp_id]
  map_comp f g := by
    ext x i k
    change x.val i (k ≫ g.unop ≫ f.unop) = x.val i ((k ≫ g.unop) ≫ f.unop)
    rw [Category.assoc]

section sheaf

variable {T : Over S} {Q : Sieve T} (z : Presieve.FamilyOfElements (gluePresheaf D) Q.arrows)

/-- The value at the identity of an element of a family of compatible families. -/
private def atId (j : R.arrows.category) (φ : j.obj ⟶ T) (hφ : Q φ) :
    sec (dobj D j) (𝟙 j.obj.left) :=
  (z φ hφ).val j (𝟙 _)

private lemma atId_congr (j : R.arrows.category) {φ φ' : j.obj ⟶ T} (e : φ = φ') (hφ : Q φ)
    (hφ' : Q φ') : atId D z j φ hφ = atId D z j φ' hφ' := by
  subst e
  rfl

variable {z}

private lemma atId_compat (hz : z.Compatible) {T' : Over S} (f : T' ⟶ T) (hf : Q f)
    (j : R.arrows.category) (g : j.obj ⟶ T') :
    (z f hf).val j g = atId D z j (g ≫ f) (Q.downward_closed hf g) := by
  have := (Presieve.compatible_iff_sieveCompatible _).1 hz f g hf
  simp only [atId, this]
  change _ = (z f hf).val j (𝟙 _ ≫ g)
  rw [Category.id_comp]

private lemma atId_nat (hz : z.Compatible) {j j' : R.arrows.category} (u : j.obj ⟶ j'.obj)
    (c : j.obj.left ⟶ j'.obj.left) (hc : u.left = c) (φ' : j'.obj ⟶ T) (hφ' : Q φ') :
    transit D (𝟙 j.obj.left) c (by simp [← hc, Over.w u])
        (atId D z j (u ≫ φ') (Q.downward_closed hφ' u)) =
      res _ c (Category.comp_id _) (atId D z j' φ' hφ') := by
  subst hc
  rw [← atId_compat D hz φ' hφ' j u]
  have := (z φ' hφ').compat j j' u (𝟙 _) j.obj.left (𝟙 _) u.left (by simp)
  rw [res_eq_self _ _ _ rfl] at this
  exact this

private lemma atId_glue (hz : z.Compatible) {j₁ j₂ : R.arrows.category} (φ₁ : j₁.obj ⟶ T)
    (φ₂ : j₂.obj ⟶ T) (h₁ : Q φ₁) (h₂ : Q φ₂) {W : C} (a₁ : W ⟶ j₁.obj.left)
    (a₂ : W ⟶ j₂.obj.left) (h : a₁ ≫ φ₁.left = a₂ ≫ φ₂.left) :
    transit D a₁ a₂ (glue_aux φ₁ φ₂ a₁ a₂ h) (res _ a₁ (Category.comp_id a₁) (atId D z j₁ φ₁ h₁)) =
      res _ a₂ (Category.comp_id a₂) (atId D z j₂ φ₂ h₂) := by
  let g₂ : (restr j₁ a₁).obj ⟶ j₂.obj :=
    Over.homMk a₂ (glue_aux φ₁ φ₂ a₁ a₂ h).symm
  have e : restrι j₁ a₁ ≫ φ₁ = g₂ ≫ φ₂ := by ext; simpa [g₂] using h
  have e₁ := atId_nat D hz (restrι j₁ a₁) a₁ rfl φ₁ h₁
  have e₂ := atId_nat D hz g₂ a₂ rfl φ₂ h₂
  rw [atId_congr D z _ e _ (Q.downward_closed h₂ g₂)] at e₁
  exact (congrArg (transit D a₁ a₂ (glue_aux φ₁ φ₂ a₁ a₂ h)) e₁.symm).trans
    ((transit_comp D _ _ _ _ _ _ _).trans e₂)

variable (Q) in
private lemma mem_restr {i : R.arrows.category} (g : i.obj ⟶ T) {W : C} (c : W ⟶ i.obj.left)
    (hc : (Sieve.overEquiv T Q).pullback g.left c) : Q (restrι i c ≫ g) :=
  (mem_iff_overEquiv_left Q _).2 hc

private lemma exists_amalgamate_component (hz : z.Compatible) (hQ : Q ∈ J.over S T)
    (i : R.arrows.category) (g : i.obj ⟶ T) :
    ∃ t : sec (dobj D i) (𝟙 i.obj.left), ∀ ⦃W : C⦄ (c : W ⟶ i.obj.left)
      (hc : (Sieve.overEquiv T Q).pullback g.left c),
      res _ c (Category.comp_id c) t =
        transit D (i := restr i c) (𝟙 _) c (Category.id_comp _)
          (atId D z (restr i c) (restrι i c ≫ g)
          (mem_restr Q g c hc)) :=
  exists_glue (dobj D i) _ (J.pullback_stable g.left hQ) _ (fun W W' c hc c' ↦ by
    rw [← transit_res D (i := restr i c) (𝟙 _) c (Category.id_comp _) c' (Category.comp_id c') rfl
      (by simp)]
    have := atId_glue D hz (restrι i c ≫ g) (restrι i (c' ≫ c) ≫ g) (mem_restr Q g c hc)
      (mem_restr Q g _ (((Sieve.overEquiv T Q).pullback g.left).downward_closed hc c'))
      c' (𝟙 W') (by simp)
    refine (transit_comp D (i := restr i c) (j := restr i (c' ≫ c)) (k := i) c' (𝟙 W') (c' ≫ c)
      (by simp) (by simp) (by simp) _).symm.trans ?_
    rw [this]
    exact congrArg _ (res_eq_self _ _ _ rfl _))

/-- Compatible families are separated for the topology on `Over S`. -/
private lemma glue_ext (hQ : Q ∈ J.over S T) {x x' : Glue D T}
    (H : ∀ ⦃T' : Over S⦄ (h : T' ⟶ T), Q h → ∀ (j : R.arrows.category) (g : j.obj ⟶ T'),
      x.val j (g ≫ h) = x'.val j (g ≫ h)) : x = x' := by
  refine Glue.ext (funext fun i ↦ funext fun g ↦ ?_)
  refine base_ext (dobj D i) ((Sieve.overEquiv T Q).pullback g.left)
    (J.pullback_stable g.left hQ) fun W c hc ↦ ?_
  have e₁ := x.compat i (restr i c) g (restrι i c ≫ g) W c (𝟙 W) (by simp)
  have e₂ := x'.compat i (restr i c) g (restrι i c ≫ g) W c (𝟙 W) (by simp)
  have e := H _ (mem_restr Q g c hc) (restr i c) (𝟙 _)
  rw [Category.id_comp] at e
  rw [e] at e₁
  exact transit_injective D _ _ _ (e₁.trans e₂.symm)

/-- The components of the amalgamation of a compatible family. -/
private noncomputable def amalgamateComponent (hz : z.Compatible) (hQ : Q ∈ J.over S T)
    (i : R.arrows.category) (g : i.obj ⟶ T) : sec (dobj D i) (𝟙 i.obj.left) :=
  (exists_amalgamate_component D hz hQ i g).choose

private lemma res_amalgamateComponent (hz : z.Compatible) (hQ : Q ∈ J.over S T)
    (i : R.arrows.category) (g : i.obj ⟶ T) {W : C} (c : W ⟶ i.obj.left)
    (hc : (Sieve.overEquiv T Q).pullback g.left c) :
    res _ c (Category.comp_id c) (amalgamateComponent D hz hQ i g) =
      transit D (i := restr i c) (𝟙 _) c (Category.id_comp _)
        (atId D z (restr i c) (restrι i c ≫ g) (mem_restr Q g c hc)) :=
  (exists_amalgamate_component D hz hQ i g).choose_spec c hc

private lemma transit_atId_eq (hz : z.Compatible) {i₁ i₂ k : R.arrows.category} {W : C}
    (a₁ : W ⟶ i₁.obj.left) (a₂ : W ⟶ i₂.obj.left) (φ₁ : (restr i₁ a₁).obj ⟶ T)
    (φ₂ : (restr i₂ a₂).obj ⟶ T) (h₁ : Q φ₁) (h₂ : Q φ₂) (h : φ₁.left = φ₂.left)
    (b : W ⟶ k.obj.left) (hb₁ : 𝟙 W ≫ (restr i₁ a₁).obj.hom = b ≫ k.obj.hom)
    (hb₂ : 𝟙 W ≫ (restr i₂ a₂).obj.hom = b ≫ k.obj.hom) :
    transit D (i := restr i₁ a₁) (𝟙 _) b hb₁ (atId D z _ φ₁ h₁) =
      transit D (i := restr i₂ a₂) (𝟙 _) b hb₂ (atId D z _ φ₂ h₂) := by
  have := atId_glue D hz φ₁ φ₂ h₁ h₂ (𝟙 W) (𝟙 W) (by simp [h])
  calc transit D (i := restr i₁ a₁) (𝟙 _) b hb₁ (atId D z _ φ₁ h₁)
      = transit D (i := restr i₁ a₁) (𝟙 _) b hb₁
          (res _ (𝟙 W) (Category.comp_id _) (atId D z _ φ₁ h₁)) :=
        congrArg _ (res_eq_self _ _ _ rfl _).symm
    _ = transit D (i := restr i₂ a₂) (𝟙 _) b hb₂ (transit D (i := restr i₁ a₁) (j := restr i₂ a₂)
          (𝟙 W) (𝟙 W) (by simpa using hb₁.trans hb₂.symm)
          (res _ (𝟙 W) (Category.comp_id _) (atId D z _ φ₁ h₁))) :=
        (transit_comp D _ _ _ _ _ _ _).symm
    _ = transit D (i := restr i₂ a₂) (𝟙 _) b hb₂
          (res _ (𝟙 W) (Category.comp_id _) (atId D z _ φ₂ h₂)) := by
        rw [this]
    _ = transit D (i := restr i₂ a₂) (𝟙 _) b hb₂ (atId D z _ φ₂ h₂) :=
        congrArg _ (res_eq_self _ _ _ rfl _)

/-- The amalgamation of a compatible family of compatible families. -/
private noncomputable def amalgamate (hz : z.Compatible) (hQ : Q ∈ J.over S T) : Glue D T :=
  ⟨amalgamateComponent D hz hQ, fun i₁ i₂ g₁ g₂ W a b h ↦ by
    refine sec_ext (dobj D i₂) b ((Sieve.overEquiv T Q).pullback (a ≫ g₁.left))
      (J.pullback_stable _ hQ) fun W' c hc ↦ ?_
    have hc₁ : (Sieve.overEquiv T Q).pullback g₁.left (c ≫ a) := by simpa using hc
    have hc₂ : (Sieve.overEquiv T Q).pullback g₂.left (c ≫ b) := by simpa [h] using hc
    rw [← transit_res D a b _ c rfl rfl
        (by simpa using glue_aux g₁ g₂ (c ≫ a) (c ≫ b) (by simp [h])),
      res_res, res_res, res_amalgamateComponent D hz hQ i₁ g₁ (c ≫ a) hc₁,
      res_amalgamateComponent D hz hQ i₂ g₂ (c ≫ b) hc₂,
      transit_comp (h₃ := by simpa using glue_aux g₁ g₂ (c ≫ a) (c ≫ b) (by simp [h]))]
    exact transit_atId_eq D hz _ _ _ _ _ _ (by simp [h]) _ _ _⟩

private lemma isAmalgamation_amalgamate (hz : z.Compatible) (hQ : Q ∈ J.over S T) :
    z.IsAmalgamation (amalgamate D hz hQ) := by
  intro T' h hh
  refine Glue.ext (funext fun j ↦ funext fun g' ↦ ?_)
  change amalgamateComponent D hz hQ j (g' ≫ h) = (z h hh).val j g'
  rw [atId_compat D hz h hh j g']
  refine base_ext (dobj D j) ((Sieve.overEquiv T Q).pullback (g' ≫ h).left)
    (J.pullback_stable _ hQ) fun W c hc ↦ ?_
  rw [res_amalgamateComponent D hz hQ j (g' ≫ h) c hc]
  exact atId_nat D hz (restrι j c) c rfl (g' ≫ h) _

end sheaf

section small

omit [Category.{v'} A]

variable [Precoverage.Small.{w} J.toPrecoverage]

variable (J) in
/-- Under the smallness hypothesis, every covering sieve contains a `w`-small covering
family. -/
private lemma exists_small_family {X : C} (s : Sieve X) (hs : s ∈ J X) :
    ∃ (ι : Type w) (Y : ι → C) (f : ∀ k, Y k ⟶ X),
      (∀ k, s (f k)) ∧ Sieve.ofArrows Y f ∈ J X := by
  obtain ⟨E, hE⟩ := Precoverage.mem_iff_exists_zeroHypercover.1
    ((J.arrows_mem_toPrecoverage_iff s).2 hs)
  obtain ⟨ι, g, hg⟩ := Precoverage.ZeroHypercover.Small.exists_restrictIndex_mem.{w} E
  refine ⟨ι, fun k ↦ E.X (g k), fun k ↦ E.f (g k), fun k ↦ ?_, hg⟩
  have : s.arrows (E.f (g k)) := by rw [hE]; exact Presieve.ofArrows.mk _
  exact this

private lemma small_glue (hR : R ∈ J S) (T : Over S) : Small.{w} (Glue D T) := by
  obtain ⟨ι, Y, f, hf, hcov⟩ := exists_small_family J (R.pullback T.hom) (J.pullback_stable _ hR)
  let j (k : ι) : R.arrows.category := ⟨Over.mk (f k ≫ T.hom), hf k⟩
  let gk (k : ι) : (j k).obj ⟶ T := Over.homMk (f k)
  refine small_of_injective (β := ∀ k : ι, sec (dobj D (j k)) (𝟙 _))
    (f := fun x k ↦ x.val (j k) (gk k)) fun x x' hxx' ↦ ?_
  refine Glue.ext (funext fun i ↦ funext fun g ↦ ?_)
  refine base_ext (dobj D i) ((Sieve.ofArrows Y f).pullback g.left)
    (J.pullback_stable _ hcov) fun W c hc ↦ ?_
  obtain ⟨k, d, hd⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hc
  have e₁ := x.compat i (j k) g (gk k) W c d hd
  have e₂ := x'.compat i (j k) g (gk k) W c d hd
  have e : x.val (j k) (gk k) = x'.val (j k) (gk k) := congr_fun hxx' k
  rw [e] at e₁
  exact transit_injective D _ _ _ (e₁.trans e₂.symm)

end small

private lemma isSheaf_gluePresheaf : Presheaf.IsSheaf (J.over S) (gluePresheaf D) := by
  rw [isSheaf_iff_isSheaf_of_type]
  intro T Q hQ z hz
  refine ⟨amalgamate D hz hQ, isAmalgamation_amalgamate D hz hQ,
    fun t ht ↦ glue_ext D hQ fun T' h hh j g ↦ ?_⟩
  exact (congr_arg (fun x ↦ x.val j g) (ht h hh)).trans
    (congr_arg (fun x ↦ x.val j g) (isAmalgamation_amalgamate D hz hQ h hh)).symm

section restriction

variable (i : R.arrows.category) (Z : Over i.obj.left)

private lemma transit_res_congr {k : R.arrows.category} (y : sec (dobj D i) Z.hom) {W : C}
    (κ κ' : W ⟶ Z.left) (e : κ = κ') {t t' : W ⟶ i.obj.left} (ht : κ ≫ Z.hom = t)
    (ht' : κ' ≫ Z.hom = t') (b : W ⟶ k.obj.left) (hb : t ≫ i.obj.hom = b ≫ k.obj.hom)
    (hb' : t' ≫ i.obj.hom = b ≫ k.obj.hom) :
    transit D t b hb (res _ κ ht y) = transit D t' b hb' (res _ κ' ht' y) := by
  subst e ht ht'
  rfl

/-- Restricting the compatible families over `Over.mk (Z.hom ≫ i.obj.hom)` to the member
`i` of the sieve recovers the sections of `D.obj i` at `Z`. -/
private noncomputable def glueEquiv :
    Glue D (Over.mk (Z.hom ≫ i.obj.hom)) ≃ sec (dobj D i) Z.hom where
  toFun x := transit D (i := restr i Z.hom) (𝟙 _) Z.hom (Category.id_comp _)
    (x.val (restr i Z.hom) (𝟙 _))
  invFun y := ⟨fun j g ↦ transit D (g.left ≫ Z.hom) (𝟙 _) (by simpa using Over.w g)
      (res _ g.left rfl y), fun j₁ j₂ g₁ g₂ W a b h ↦ by
    rw [← transit_res D _ (𝟙 _) _ a rfl (Category.comp_id a) (by simp [← Over.w g₁]),
      ← transit_res D _ (𝟙 _) _ b rfl (Category.comp_id b) (by simp [← Over.w g₂]),
      transit_comp, res_res, res_res]
    · exact transit_res_congr D i Z y _ _ h _ _ _ _ _
    · simp [← Over.w g₂, reassoc_of% h]⟩
  left_inv x := by
    refine Glue.ext (funext fun j ↦ funext fun g ↦ ?_)
    dsimp only
    rw [← transit_res D _ Z.hom _ g.left (Category.comp_id g.left) rfl (by simp), transit_comp,
      x.compat (restr i Z.hom) j (𝟙 _) g j.obj.left g.left (𝟙 _) (by simp),
      res_eq_self _ _ _ rfl]
    simpa using Over.w g
  right_inv y := by
    dsimp only
    rw [transit_comp]
    · exact (transit_eq_res D _ _ (by simp) _ _).trans
        (by rw [res_res]; exact res_eq_self _ _ _ (by simp) _)
    · simp

private lemma glueEquiv_naturality {Z Z' : Over i.obj.left} (u : Z' ⟶ Z)
    (x : Glue D (Over.mk (Z.hom ≫ i.obj.hom))) :
    glueEquiv D i Z' ((gluePresheaf D).map ((Over.map i.obj.hom).map u).op x) =
      res _ u.left (Over.w u) (glueEquiv D i Z x) := by
  change transit D (i := restr i Z'.hom) (𝟙 _) Z'.hom (Category.id_comp _)
      (x.val (restr i Z'.hom) (𝟙 _ ≫ (Over.map i.obj.hom).map u)) =
    res _ u.left (Over.w u)
      (transit D (i := restr i Z.hom) (𝟙 _) Z.hom (Category.id_comp _)
        (x.val (restr i Z.hom) (𝟙 _)))
  rw [← transit_res D _ _ _ u.left (Category.comp_id _) (Over.w u) (by rw [← Over.w u]; simp),
    ← x.compat (restr i Z'.hom) (restr i Z.hom) (𝟙 _ ≫ (Over.map i.obj.hom).map u) (𝟙 _)
      Z'.left (𝟙 _) u.left (by simp), transit_comp]
  exact (congrArg _ (res_eq_self _ _ _ rfl _)).symm

private lemma glueEquiv_comm {Y : C} (q : Y ⟶ S) {i₁ i₂ : R.arrows.category} (f₁ : Y ⟶ i₁.obj.left)
    (f₂ : Y ⟶ i₂.obj.left) (hf₁ : f₁ ≫ i₁.obj.hom = q) (hf₂ : f₂ ≫ i₂.obj.hom = q)
    (Z : Over Y) (x : Glue D (Over.mk ((Z.hom ≫ f₁) ≫ i₁.obj.hom))) :
    dapp D q f₁ f₂ hf₁ hf₂ Z (glueEquiv D i₁ (Over.mk (Z.hom ≫ f₁)) x) =
      glueEquiv D i₂ (Over.mk (Z.hom ≫ f₂)) ((gluePresheaf D).map
        (Over.homMk (𝟙 Z.left) (by simp [hf₁, hf₂]) :
          Over.mk ((Z.hom ≫ f₂) ≫ i₂.obj.hom) ⟶ Over.mk ((Z.hom ≫ f₁) ≫ i₁.obj.hom)).op x) := by
  rw [dapp_eq_transit]
  change transit D _ _ _ (transit D (i := restr i₁ (Z.hom ≫ f₁)) (𝟙 _) _ (Category.id_comp _)
      (x.val (restr i₁ (Z.hom ≫ f₁)) (𝟙 _))) =
    transit D (i := restr i₂ (Z.hom ≫ f₂)) (𝟙 _) _ (Category.id_comp _)
      (x.val (restr i₂ (Z.hom ≫ f₂)) (𝟙 _ ≫ Over.homMk (𝟙 Z.left) (by simp [hf₁, hf₂])))
  have := x.compat (restr i₂ (Z.hom ≫ f₂)) (restr i₁ (Z.hom ≫ f₁))
    (𝟙 _ ≫ Over.homMk (𝟙 Z.left) (by simp [hf₁, hf₂])) (𝟙 _) Z.left (𝟙 _) (𝟙 _) (by simp)
  erw [res_eq_self _ _ _ rfl, res_eq_self _ _ _ rfl] at this
  rw [transit_comp, ← this]
  · exact transit_comp D _ _ _ _ _ _ _
  · simp [hf₁, hf₂]

end restriction

section essSurj

variable [Precoverage.Small.{w} J.toPrecoverage] (hR : R ∈ J S)

/-- The sheaf glued from a descent datum, shrunk to `Type w`. -/
private noncomputable def glueSheaf : Sheaf (J.over S) (Type w) :=
  letI : FunctorToTypes.Small.{w} (gluePresheaf D) := fun T ↦ small_glue D hR T.unop
  ⟨FunctorToTypes.shrink.{w} (gluePresheaf D), by
    rw [isSheaf_iff_isSheaf_of_type]
    intro T Q hQ
    refine Presieve.isSheafFor_of_nat_equiv (P₁ := gluePresheaf D) (fun T ↦ equivShrink _)
      (fun _ _ f x ↦ ?_) ((isSheaf_iff_isSheaf_of_type _ _).1 (isSheaf_gluePresheaf D) _ hQ)
    simp⟩

/-- The restriction of the glued sheaf to a member `i` of the sieve is `D.obj i`. -/
private noncomputable def glueIso (i : R.arrows.category) :
    (J.overMapPullback (Type w) i.obj.hom).obj (glueSheaf D hR) ≅ dobj D i :=
  letI (T : Over S) : Small.{w} (Glue D T) := small_glue D hR T
  ObjectProperty.isoMk _ (NatIso.ofComponents
    (fun Z ↦ ((equivShrink _).symm.trans (glueEquiv D i Z.unop)).toIso) (by
      rintro ⟨Z⟩ ⟨Z'⟩ ⟨u : Z' ⟶ Z⟩
      ext m
      exact (congrArg (glueEquiv D i Z') (Equiv.symm_apply_apply _ _)).trans
        (glueEquiv_naturality D i u _)))

private lemma symm_glueSheaf_map_comp {T₁ T₂ T₃ : (Over S)ᵒᵖ} (a : T₁ ⟶ T₂) (b : T₂ ⟶ T₃)
    (c : T₁ ⟶ T₃) (hc : a ≫ b = c) (m : (glueSheaf D hR).obj.obj T₁) :
    letI : FunctorToTypes.Small.{w} (gluePresheaf D) := fun T ↦ small_glue D hR T.unop
    (gluePresheaf D).map c ((equivShrink _).symm m) =
      (equivShrink _).symm (((glueSheaf D hR).obj.map a ≫ (glueSheaf D hR).obj.map b) m) := by
  subst hc
  have _ : FunctorToTypes.Small.{w} (gluePresheaf D) := fun T ↦ small_glue D hR T.unop
  have : ((glueSheaf D hR).obj.map a ≫ (glueSheaf D hR).obj.map b) m =
      equivShrink _ ((gluePresheaf D).map b ((gluePresheaf D).map a ((equivShrink _).symm m))) := by
    change equivShrink _ ((gluePresheaf D).map b ((equivShrink _).symm
      (equivShrink _ ((gluePresheaf D).map a ((equivShrink _).symm m))))) = _
    rw [Equiv.symm_apply_apply]
  rw [this, Equiv.symm_apply_apply, Functor.map_comp, types_comp_apply]

/-- The descent datum of the glued sheaf is isomorphic to `D`. -/
private noncomputable def glueDescentIso :
    ((J.pseudofunctorOver (Type w)).toDescentData
      (fun (f : R.arrows.category) ↦ f.obj.hom)).obj (glueSheaf D hR) ≅ D :=
  letI (T : Over S) : Small.{w} (Glue D T) := small_glue D hR T
  Pseudofunctor.DescentData.isoMk (fun i ↦ glueIso D hR i) (by
    intro Y q i₁ i₂ f₁ f₂ hf₁ hf₂
    refine Sheaf.hom_ext ?_
    ext Z m
    rw [pseudofunctorOver_comp_hom_app, pseudofunctorOver_comp_hom_app]
    erw [TypeCat.Fun.toFun_apply, TypeCat.Fun.toFun_apply, types_comp_apply, types_comp_apply]
    erw [Pseudofunctor.DescentData.ofObj_hom]
    erw [pseudofunctorOver_comp_hom_app, types_comp_apply,
      pseudofunctorOver_mapComp'_inv_app_hom_app _ _ _ _ _ hf₁,
      pseudofunctorOver_mapComp'_hom_app_hom_app _ _ _ _ _ hf₂]
    erw [types_comp_apply, types_comp_apply]
    refine (glueEquiv_comm D q f₁ f₂ hf₁ hf₂ Z.unop ((equivShrink _).symm m)).trans
      (congrArg (glueEquiv D i₂ _) ?_)
    exact symm_glueSheaf_map_comp D hR _ _ _ (homMk_id_op_comp _ _ _) m)

end essSurj

end PseudofunctorOver

open PseudofunctorOver in
variable (J) in
/-- Sheaves of types on the slices of a site form a stack (Stacks Tag 04TR for objects), when
every covering sieve contains a `w`-small covering family. Without that hypothesis the glued
sections need not form a `w`-small type; see the implementation notes of this file. -/
instance isStack_pseudofunctorOver [Precoverage.Small.{w} J.toPrecoverage] :
    (J.pseudofunctorOver (Type w)).IsStack J where
  essSurj_of_sieve _ hR := ⟨fun D ↦ ⟨glueSheaf D hR, ⟨glueDescentIso D hR⟩⟩⟩

end GrothendieckTopology
end CategoryTheory
