import DerivedAlgGeo.CategoryTheory.Sites.Descent.DescentDataPrime
import Mathlib.CategoryTheory.Limits.Connected
import Mathlib.CategoryTheory.Limits.Constructions.Over.Products
import Mathlib.CategoryTheory.Sites.Descent.Precoverage
import Mathlib.CategoryTheory.Sites.Over

/-!
# Stacks pulled back along a continuous functor, and stacks on `Over S`

Let `Φ : D ⥤ C` be a functor that sends the coverings of a precoverage `K` on `D` to families
generating covering sieves of a Grothendieck topology `J` on `C`, and that preserves the fibre
products of morphisms with members of `K`-coverings. Then the pullback
`Φ.op.toPseudofunctor.comp G` of a `J`-stack `G` is a stack for the topology generated by `K`.
This is Stacks 04WC, for the continuous functors of Stacks 00WV.

The two reindexings to a slice used downstream follow: restriction of a stack on `C` to
`Over S` along `Over.forget S`, and its pullback along `X ×_S - : Over S ⥤ C` for `X : Over S`.

## Main definitions

None.

## Main results

* `CategoryTheory.Pseudofunctor.isStack_comp_toPseudofunctor`: the pullback of a stack along a
  continuous functor is a stack.
* `CategoryTheory.Pseudofunctor.isStack_over_comp_forget`: a `K.toGrothendieck`-stack on `C`
  restricts to a `K.toGrothendieck.over S`-stack on `Over S`.
* `CategoryTheory.Pseudofunctor.isStack_over_comp_prodFunctor`: its pullback along
  `prod.functor.obj X ⋙ Over.forget S` is a `K.toGrothendieck.over S`-stack.

## Implementation notes

Mathlib's `Functor.IsContinuous` concerns sheaves, not the two conditions of Stacks 00WV, so
those conditions are hypotheses of `isStack_comp_toPseudofunctor`. The proof checks effective
descent on the `K`-coverings with `Pseudofunctor.IsStack.of_precoverage`, and transports it
along `Φ` with `Pseudofunctor.isStackFor_ofArrows_comp_toPseudofunctor_iff`. Its triple fibre
products are fibre products with members of the base change of a `K`-covering, which is again
a `K`-covering, so preservation of fibre products with members of `K`-coverings suffices.

On `Over S`, `CategoryTheory.over_toGrothendieck_eq_toGrothendieck_comap_forget` identifies
`K.toGrothendieck.over S` with the topology generated by `K.comap (Over.forget S)`. Binary
products in `Over S` are built from pullbacks in `C` by a local instance. The product
`(X ⨯ T).left` is not definitionally `pullback X.hom T.hom`, so the last corollary is stated for
`prod.functor.obj X ⋙ Over.forget S`.

## References

* [Stacks Project, Tag 04WC](https://stacks.math.columbia.edu/tag/04WC)
* [Stacks Project, Tag 00WV](https://stacks.math.columbia.edu/tag/00WV)

## Tags

stack, descent, continuous functor, slice site, over category
-/

universe v₂ v' v u₂ u' u

namespace CategoryTheory.Pseudofunctor

open Opposite Bicategory Limits

variable {C : Type u} [Category.{v} C] {D : Type u₂} [Category.{v₂} D]

/-- Let `Φ : D ⥤ C` satisfy the two conditions of Stacks 00WV for a precoverage `K` on `D` and
a Grothendieck topology `J` on `C`: `hΦ`, the image of a `K`-covering generates a `J`-covering
sieve, and `hΦ'`, `Φ` preserves the fibre product of any morphism with a member of a
`K`-covering. Then for every `J`-stack `G`, the pullback `Φ.op.toPseudofunctor.comp G` is a
stack for `K.toGrothendieck` (Stacks 04WC).

The hypothesis `hΦ` cannot be dropped. Let `C = D` be the opens of a two-point discrete space,
`Φ = 𝟭`, `J = ⊥`, whose only covering sieves are maximal, and `K` the open-cover precoverage.
The discrete pseudofunctor `G` of a presheaf that is not a sheaf for open covers is a `⊥`-stack,
but `Φ.op.toPseudofunctor.comp G` is not a stack for `K.toGrothendieck`. -/
@[stacks 04WC]
theorem isStack_comp_toPseudofunctor [HasPullbacks D] (K : Precoverage D) [K.HasIsos]
    [K.IsStableUnderBaseChange] [K.IsStableUnderComposition] (Φ : D ⥤ C)
    (J : GrothendieckTopology C)
    (hΦ : ∀ ⦃S : D⦄ (R : Presieve S), R ∈ K S → Sieve.generate (R.map Φ) ∈ J (Φ.obj S))
    (hΦ' : ∀ ⦃V : D⦄ (R : Presieve V), R ∈ K V →
      ∀ ⦃T W : D⦄ (g : T ⟶ V) (h : W ⟶ V), R h → PreservesLimit (cospan g h) Φ)
    (G : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{v', u'}) [G.IsStack J] :
    (Φ.op.toPseudofunctor.comp G).IsStack K.toGrothendieck := by
  refine IsStack.of_precoverage fun S R hR ↦ ?_
  obtain ⟨ι, X, f, rfl⟩ := R.exists_eq_ofArrows
  have : ∀ i j, PreservesLimit (cospan (f i) (f j)) Φ := fun i j ↦
    hΦ' _ hR (f i) (f j) (Presieve.ofArrows.mk j)
  have : ∀ i j k,
      PreservesLimit (cospan (pullback.snd (f i) (f j)) (pullback.fst (f j) (f k))) Φ :=
    fun i j k ↦ hΦ' _ (Precoverage.mem_coverings_of_isPullback f hR (f j)
      (fun k ↦ pullback.fst (f j) (f k)) (fun k ↦ pullback.snd (f j) (f k))
      (fun k ↦ IsPullback.of_hasPullback (f j) (f k))) _ _ (Presieve.ofArrows.mk k)
  rw [isStackFor_ofArrows_comp_toPseudofunctor_iff]
  exact G.isStackFor _ (by simpa only [Presieve.map_ofArrows] using hΦ _ hR)

/-- The square `X ⨯ A ⟶ X ⨯ B` over `A ⟶ B`, with the second projections, is a pullback. -/
private lemma isPullback_prodMap_id_snd {E : Type*} [Category* E] {A B : E} (g : A ⟶ B) (X : E)
    [HasBinaryProduct X A] [HasBinaryProduct X B] :
    IsPullback (prod.map (𝟙 X) g) prod.snd prod.snd g where
  isLimit' := ⟨PullbackCone.isLimitAux' _ (fun s ↦ by
    refine ⟨prod.lift (s.fst ≫ prod.fst) s.snd, ?_, ?_, ?_⟩
    · ext
      · simp
      · simp [PullbackCone.condition]
    · simp
    · intro m h₁ h₂
      dsimp at m h₁ h₂ ⊢
      ext
      · simp [← h₁]
      · simpa using h₂)⟩

section Over

variable [HasPullbacks C] (K : Precoverage C) [K.HasIsos] [K.IsStableUnderBaseChange]
  [K.IsStableUnderComposition] (G : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{v', u'})
  [G.IsStack K.toGrothendieck]

/-- The restriction of a `K.toGrothendieck`-stack on `C` to `Over S` along `Over.forget S` is a
stack for the slice topology `K.toGrothendieck.over S`. -/
theorem isStack_over_comp_forget (S : C) :
    ((Over.forget S).op.toPseudofunctor.comp G).IsStack (K.toGrothendieck.over S) := by
  rw [over_toGrothendieck_eq_toGrothendieck_comap_forget]
  exact isStack_comp_toPseudofunctor (K.comap (Over.forget S)) (Over.forget S) K.toGrothendieck
    (fun _ _ hR ↦ Precoverage.generate_mem_toGrothendieck hR)
    (fun _ _ _ _ _ _ _ _ ↦ inferInstance) G

attribute [local instance] Over.ConstructProducts.over_binaryProduct_of_pullback

/-- For `X : Over S`, the pullback of a `K.toGrothendieck`-stack on `C` along
`X ×_S - = prod.functor.obj X ⋙ Over.forget S : Over S ⥤ C` is a stack for the slice topology
`K.toGrothendieck.over S`. -/
theorem isStack_over_comp_prodFunctor {S : C} (X : Over S) :
    ((prod.functor.obj X ⋙ Over.forget S).op.toPseudofunctor.comp G).IsStack
      (K.toGrothendieck.over S) := by
  have := prod_preservesConnectedLimits (J := ULiftHom.{v} (ULift.{v} WalkingCospan)) X
  have : PreservesLimitsOfShape WalkingCospan (prod.functor.obj X) :=
    preservesLimitsOfShape_of_equiv (ULiftHomULiftCategory.equiv.{v, v} WalkingCospan).symm _
  rw [over_toGrothendieck_eq_toGrothendieck_comap_forget]
  refine isStack_comp_toPseudofunctor (K.comap (Over.forget S)) _ K.toGrothendieck
    (fun T R hR ↦ ?_) (fun _ _ _ _ _ _ _ _ ↦ inferInstance) G
  obtain ⟨ι, Y, g, rfl⟩ := R.exists_eq_ofArrows
  rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows] at hR
  rw [Presieve.map_ofArrows]
  exact Precoverage.generate_mem_toGrothendieck
    (Precoverage.mem_coverings_of_isPullback _ hR (prod.snd : X ⨯ T ⟶ T).left _
      (fun i ↦ (prod.snd : X ⨯ Y i ⟶ Y i).left)
      (fun i ↦ (Over.forget S).map_isPullback (isPullback_prodMap_id_snd (g i) X)))

end Over

end CategoryTheory.Pseudofunctor
