import Mathlib.Algebra.Homology.Embedding.CochainComplex
import Mathlib.Algebra.Homology.HomologicalComplexLimits
import Mathlib.CategoryTheory.Abelian.GrothendieckCategory.Basic
import Mathlib.CategoryTheory.Abelian.Refinements
import DerivedAlgGeo.Algebra.Homology.Subcomplex

/-!
# Small acyclic subcomplexes in Grothendieck abelian categories

Let `C` be a Grothendieck abelian category. This file constructs a `w`-small family
`CochainComplex.smallAcyclic C` of bounded-above acyclic complexes that detects acyclic
complexes: every nonzero acyclic complex has a nonzero subcomplex isomorphic to a
member, and every acyclic complex is a quotient of a coproduct of members. These are
the two parts of Stacks, Lemma 19.12.2 (Tag 079K). Its size bound rests on Stacks,
Lemma 19.12.1 (Tag 079J): a subobject of the target of an epimorphism lifts to a
subobject of the source of bounded size.

## Main definitions

* `CochainComplex.SmallAcyclicIndex C`: a `w`-small index type.
* `CochainComplex.smallAcyclic C`: the family of bounded-above acyclic complexes it
  indexes.

## Main results

* `CochainComplex.acyclic_smallAcyclic`, `CochainComplex.exists_isStrictlyLE_smallAcyclic`:
  the members are acyclic and bounded above.
* `CochainComplex.exists_mono_smallAcyclic`: Tag 079K, first part.
* `CochainComplex.exists_epi_sigma_smallAcyclic`: Tag 079K, second part.

## Implementation notes

The Stacks project bounds the size of an object by the cardinality of its set of
elements. An abstract category has no such cardinality, so size is measured here by
generation: an object is generated by an `S`-indexed family when some family
`S → (G ⟶ X)` of morphisms from the separator `G` is jointly epimorphic. The bounds
are index types, never cardinals, and need no cardinal arithmetic.

* A quotient of an `S`-generated object is `S`-generated.
* A subobject of an `S`-generated object `X` is generated by an index type that depends
  only on `S`: `X` is a cokernel of a subobject `R` of the coproduct of `S` copies of
  `G`, so its morphisms from `G` embed into `G ⟶ cokernel R.arrow`.
* Along an exact sequence `P ⟶ Q ⟶ R`, an `S`-generated subobject of `Q` killed by
  `Q ⟶ R` is the image of an `S × (G ⟶ G)`-generated subobject of `P`. This is the
  form of Tag 079J used here; it is a private step, since a public lemma about objects
  of a Grothendieck abelian category belongs with Mathlib's
  `CategoryTheory.IsGrothendieckAbelian`. Each generator
  lifts only up to a refinement `A ⟶ G`, and keeping one morphism `G ⟶ A` for each
  endomorphism of `G` it induces bounds the number of lifts.

Starting from a morphism `g : G ⟶ M.X n` into an acyclic complex `M`, the subcomplex
has the image of `g` in degree `n`, its image under the differential in degree `n + 1`,
zero above, and in each degree below `n` a lift of the cycles one degree up. It is
acyclic by construction, bounded above by `n + 1`, and its terms are generated by
families indexed by one fixed type. Complexes whose terms are cokernels of subobjects
of one fixed coproduct of copies of `G` form a `w`-small set, which gives the index type.

## References

* [The Stacks project, Tag 079J](https://stacks.math.columbia.edu/tag/079J)
* [The Stacks project, Tag 079K](https://stacks.math.columbia.edu/tag/079K)

## Tags

acyclic complex, Grothendieck abelian category, separator, cardinal bound
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

universe w v u

open CategoryTheory Limits

namespace CochainComplex

variable {C : Type u} [Category.{v} C] [Abelian C]

namespace AcyclicSubcomplex

/-- `X` is generated by an `S`-indexed family of morphisms from `G`: the family is
jointly epimorphic. -/
private def IsGeneratedBy (G : C) (S : Type*) (X : C) : Prop :=
  ∃ f : S → (G ⟶ X), ∀ ⦃Z : C⦄ (a b : X ⟶ Z), (∀ s, f s ≫ a = f s ≫ b) → a = b

variable {G : C}

private lemma IsGeneratedBy.of_injective {S S' : Type*} {X : C} (hX : IsGeneratedBy G S X)
    (e : S → S') (he : Function.Injective e) : IsGeneratedBy G S' X := by
  obtain ⟨f, hf⟩ := hX
  exact ⟨Function.extend e f 0, fun Z a b hab => hf a b (fun s => by
    simpa [he.extend_apply] using hab (e s))⟩

omit [Abelian C] in
private lemma IsGeneratedBy.of_epi {S : Type*} {X Y : C} (hX : IsGeneratedBy G S X)
    (p : X ⟶ Y) [Epi p] : IsGeneratedBy G S Y := by
  obtain ⟨f, hf⟩ := hX
  exact ⟨fun s => f s ≫ p, fun Z a b hab => (cancel_epi p).1 (hf _ _ (fun s => by
    simpa using hab s))⟩

private lemma IsGeneratedBy.of_isZero (S : Type*) {X : C} (hX : IsZero X) :
    IsGeneratedBy G S X :=
  ⟨0, fun _ _ _ _ => hX.eq_of_src _ _⟩

omit [Abelian C] in
private lemma isGeneratedBy_hom (hG : IsSeparator G) (X : C) : IsGeneratedBy G (G ⟶ X) X :=
  ⟨id, fun _ a b hab => hG.def a b hab⟩

omit [Abelian C] in
/-- A jointly epimorphic family gives an epimorphism from the coproduct. -/
private lemma epi_sigmaDesc_of_jointlyEpi {S : Type*} {X : C} [HasCoproduct fun _ : S => G]
    {f : S → (G ⟶ X)}
    (hf : ∀ ⦃Z : C⦄ (a b : X ⟶ Z), (∀ s, f s ≫ a = f s ≫ b) → a = b) :
    Epi (Sigma.desc f) :=
  ⟨fun a b hab => hf a b (fun s => by simpa using Sigma.ι _ s ≫= hab)⟩

/-- An epimorphism `σ : U ⟶ X` exhibits `X` as the cokernel of the subobject
`Subobject.mk (kernel.ι σ)` of `U`. -/
private noncomputable def isoCokernel {U X : C} (σ : U ⟶ X) [Epi σ] :
    X ≅ cokernel (Subobject.mk (kernel.ι σ)).arrow :=
  have w : (Subobject.mk (kernel.ι σ)).arrow ≫ σ = 0 := by
    rw [← Subobject.underlyingIso_hom_comp_eq_mk, Category.assoc, kernel.condition, comp_zero]
  IsColimit.coconePointUniqueUpToIso
    (Abelian.epiIsCokernelOfKernel _ (KernelFork.IsLimit.ofι _ w
      (fun k hk => kernel.lift σ k hk ≫ (Subobject.underlyingIso (kernel.ι σ)).inv)
      (fun k hk => by
        rw [Category.assoc, ← Subobject.underlyingIso_hom_comp_eq_mk, Iso.inv_hom_id_assoc,
          kernel.lift_ι])
      (fun k hk m hm => by
        rw [← cancel_mono (Subobject.mk (kernel.ι σ)).arrow, hm, Category.assoc,
          ← Subobject.underlyingIso_hom_comp_eq_mk, Iso.inv_hom_id_assoc, kernel.lift_ι])))
    (colimit.isColimit _)

variable [IsGrothendieckAbelian.{w} C]

variable (G) in
/-- The index type bounding the subobjects of an object generated by an
`S`-indexed family: such an object is a cokernel of a subobject `R` of the coproduct
of `S` copies of `G`, so its morphisms from `G` embed into `G ⟶ cokernel R.arrow`. -/
private noncomputable def next (S : Type w) : Type w :=
  Shrink.{w} (Σ (R : Subobject (∐ fun _ : S => G)), (G ⟶ cokernel R.arrow))

/-- **Subobjects.** A subobject of an object generated by an `S`-indexed family is
generated by a family indexed by `next G S`. -/
private lemma IsGeneratedBy.of_mono (hG : IsSeparator G) {S : Type w} {X K : C}
    (hX : IsGeneratedBy G S X) (m : K ⟶ X) [Mono m] : IsGeneratedBy G (next G S) K := by
  obtain ⟨f, hf⟩ := hX
  have := epi_sigmaDesc_of_jointlyEpi hf
  let e := isoCokernel (Sigma.desc f)
  refine (isGeneratedBy_hom hG K).of_injective
    (fun u => equivShrink _ ⟨Subobject.mk (kernel.ι (Sigma.desc f)), u ≫ m ≫ e.hom⟩) ?_
  intro u₁ u₂ h
  have h' := Sigma.mk.inj_iff.1 ((equivShrink _).injective h)
  rw [← cancel_mono (m ≫ e.hom)]
  exact eq_of_heq h'.2

/-- **Lifting along an exact sequence** (the form of Stacks, Lemma 19.12.1, Tag 079J,
used here). Let `P ⟶ Q ⟶ R` be exact and let `K` be a
subobject of `Q` killed by `Q ⟶ R` and generated by an `S`-indexed family. Then some
subobject `B` of `P`, generated by a family indexed by `S × (G ⟶ G)`, maps onto `K`.

Each generator of `K` lifts to `P` only up to a refinement `A ⟶ G`; covering `A` by
morphisms from `G` and keeping one for each endomorphism of `G` they induce bounds
the number of lifts. -/
private lemma exists_lift (hG : IsSeparator G) {S : Type w} {P Q R : C} {d : P ⟶ Q}
    {d' : Q ⟶ R} {hdd' : d ≫ d' = 0} (hex : (ShortComplex.mk d d' hdd').Exact)
    (K : Subobject Q) (hK : K.arrow ≫ d' = 0) (hKgen : IsGeneratedBy G S (K : C)) :
    ∃ (B : Subobject P) (q : (B : C) ⟶ (K : C)), Epi q ∧ q ≫ K.arrow = B.arrow ≫ d ∧
      IsGeneratedBy G (Shrink.{w} (S × (G ⟶ G))) (B : C) := by
  obtain ⟨y, hy⟩ := hKgen
  have h₁ (s : S) : ∃ (A : C) (π : A ⟶ G) (_ : Epi π) (x : A ⟶ P),
      π ≫ (y s ≫ K.arrow) = x ≫ d :=
    hex.exact_up_to_refinements (y s ≫ K.arrow) (by simp [hK])
  choose A π hπ x hx using h₁
  have h₂ (s : S) (e : G ⟶ G) :
      ∃ h : G ⟶ A s, (∃ h' : G ⟶ A s, h' ≫ π s = e) → h ≫ π s = e := by
    by_cases he : ∃ h' : G ⟶ A s, h' ≫ π s = e
    · obtain ⟨h', hh'⟩ := he
      exact ⟨h', fun _ => hh'⟩
    · exact ⟨0, fun h => absurd h he⟩
  choose h hh using h₂
  let T := Shrink.{w} (S × (G ⟶ G))
  let z₀ : S × (G ⟶ G) → (G ⟶ P) := fun p => h p.1 p.2 ≫ x p.1
  have hz₀ (p : S × (G ⟶ G)) :
      z₀ p ≫ d = (h p.1 p.2 ≫ π p.1 ≫ y p.1) ≫ K.arrow := by
    simp only [z₀, Category.assoc, ← hx]
  let σ : (∐ fun _ : T => G) ⟶ P := Sigma.desc (fun t => z₀ ((equivShrink _).symm t))
  let B := imageSubobject σ
  have hcok : B.arrow ≫ d ≫ cokernel.π K.arrow = 0 := by
    rw [← cancel_epi (factorThruImageSubobject σ), imageSubobject_arrow_comp_assoc, comp_zero]
    ext t
    simp [σ, reassoc_of% (hz₀ ((equivShrink _).symm t))]
  let q : (B : C) ⟶ (K : C) := (ShortComplex.exact_cokernel K.arrow).lift (B.arrow ≫ d)
    (by simpa using hcok)
  have hq : q ≫ K.arrow = B.arrow ≫ d := (ShortComplex.exact_cokernel K.arrow).lift_f _ _
  have hq' (p : S × (G ⟶ G)) :
      Sigma.ι (fun _ : T => G) (equivShrink _ p) ≫ factorThruImageSubobject σ ≫ q =
        h p.1 p.2 ≫ π p.1 ≫ y p.1 := by
    rw [← cancel_mono K.arrow, Category.assoc, Category.assoc, hq,
      imageSubobject_arrow_comp_assoc, Sigma.ι_comp_desc_assoc, Equiv.symm_apply_apply, hz₀,
      Category.assoc]
  refine ⟨B, q, ⟨fun {Z} a b hab => hy a b (fun s => ?_)⟩, hq, ?_⟩
  · rw [← cancel_epi (π s)]
    refine hG.def _ _ (fun g => ?_)
    have hg := hh s (g ≫ π s) ⟨g, rfl⟩
    have e := hq' (s, g ≫ π s)
    have e' : g ≫ π s ≫ y s = Sigma.ι (fun _ : T => G) (equivShrink _ (s, g ≫ π s)) ≫
        factorThruImageSubobject σ ≫ q := by
      rw [e, reassoc_of% hg]
    rw [reassoc_of% e', reassoc_of% e', hab]
  · exact ⟨fun t => Sigma.ι (fun _ : T => G) t ≫ factorThruImageSubobject σ,
      fun Z a b hab => (cancel_epi (factorThruImageSubobject σ)).1
        (Sigma.hom_ext _ _ (fun t => by simpa using hab t))⟩

variable (G) in
/-- The index types of the generating families along the construction: a subobject
in degree `n - j` is generated by a family indexed by `stageIndex G j`. -/
private noncomputable def stageIndex : ℕ → Type w
  | 0 => PUnit
  | j + 1 => Shrink.{w} (next G (stageIndex j) × (G ⟶ G))

variable (G) in
/-- A subobject of `P`, generated by a `T`-indexed family, that maps onto `K` under
`d`, chosen when one exists. -/
private noncomputable def liftSubobject (T : Type w) {P Q : C} (d : P ⟶ Q)
    (K : Subobject Q) : Subobject P := by
  classical
  exact if h : ∃ B : Subobject P, (∃ q : (B : C) ⟶ (K : C), Epi q ∧
      q ≫ K.arrow = B.arrow ≫ d) ∧ IsGeneratedBy G T (B : C) then h.choose else ⊥

private lemma liftSubobject_spec (T : Type w) {P Q : C} (d : P ⟶ Q) (K : Subobject Q)
    (h : ∃ B : Subobject P, (∃ q : (B : C) ⟶ (K : C), Epi q ∧
      q ≫ K.arrow = B.arrow ≫ d) ∧ IsGeneratedBy G T (B : C)) :
    (∃ q : (liftSubobject G T d K : C) ⟶ (K : C), Epi q ∧
      q ≫ K.arrow = (liftSubobject G T d K).arrow ≫ d) ∧
      IsGeneratedBy G T (liftSubobject G T d K : C) := by
  classical
  have e : liftSubobject G T d K = h.choose := by
    unfold liftSubobject
    exact dite_eq_left_of_eq_true (eq_true h) ▸ rfl
  rw [e]
  exact h.choose_spec

variable (G) (M : CochainComplex C ℤ) (n : ℤ) (g : G ⟶ M.X n)

/-- The degreewise subobjects of the small acyclic subcomplex of `M` generated by
`g`: the image of `g` in degree `n`, its image under the differential in degree
`n + 1`, zero above, and below `n` the lift of the cycles one degree up. -/
private noncomputable def seq (k : ℤ) : Subobject (M.X k) :=
  Int.inductionOn' (motive := fun k => Subobject (M.X k)) k n (imageSubobject g)
    (fun k _ A => if k = n then imageSubobject (A.arrow ≫ M.d k (k + 1)) else ⊥)
    (fun k _ A => liftSubobject G (stageIndex G ((n - k).toNat + 1)) (M.d (k - 1) k)
      (A ⊓ kernelSubobject (M.d k (k + 1))))

private lemma seq_self : seq G M n g n = imageSubobject g := by
  unfold seq
  exact Int.inductionOn'_self

private lemma seq_succ_self :
    seq G M n g (n + 1) = imageSubobject ((seq G M n g n).arrow ≫ M.d n (n + 1)) := by
  unfold seq
  rw [Int.inductionOn'_add_one le_rfl, ite_eq_left rfl]

private lemma seq_of_lt (k : ℤ) (hk : n + 1 < k) : seq G M n g k = ⊥ := by
  obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by lia⟩
  unfold seq
  rw [Int.inductionOn'_add_one (by lia), ite_eq_right (by lia)]

private lemma seq_pred (k : ℤ) (hk : k ≤ n) :
    seq G M n g (k - 1) = liftSubobject G (stageIndex G ((n - k).toNat + 1)) (M.d (k - 1) k)
      (seq G M n g k ⊓ kernelSubobject (M.d k (k + 1))) := by
  unfold seq
  exact Int.inductionOn'_sub_one hk

variable {G M n g}

omit [IsGrothendieckAbelian.{w} C] in
private lemma inf_kernelSubobject_arrow_comp {k : ℤ} (A : Subobject (M.X k)) :
    (A ⊓ kernelSubobject (M.d k (k + 1))).arrow ≫ M.d k (k + 1) = 0 := by
  rw [← Subobject.ofLE_arrow (inf_le_right : A ⊓ kernelSubobject (M.d k (k + 1)) ≤ _),
    Category.assoc, kernelSubobject_arrow_comp, comp_zero]

private lemma seq_isGeneratedBy (hG : IsSeparator G) (hM : M.Acyclic) (k : ℤ) (hk : k ≤ n) :
    IsGeneratedBy G (stageIndex G (n - k).toNat) (seq G M n g k : C) := by
  induction k, hk using Int.leInductionDown with
  | base =>
    rw [seq_self, show (n - n).toNat = 0 by lia]
    exact ⟨fun _ => factorThruImageSubobject g, fun _ a b hab =>
      (cancel_epi (factorThruImageSubobject g)).1 (hab PUnit.unit)⟩
  | pred k hk ih =>
    rw [seq_pred G M n g k hk, show (n - (k - 1)).toNat = (n - k).toNat + 1 by lia]
    refine (liftSubobject_spec _ _ _ ?_).2
    obtain ⟨B, q, hq, hqB, hB⟩ := exists_lift hG
      ((M.exactAt_iff' (k - 1) k (k + 1) (by simp) (by simp)).1 (hM k))
      (seq G M n g k ⊓ kernelSubobject (M.d k (k + 1))) (inf_kernelSubobject_arrow_comp _)
      (ih.of_mono hG (Subobject.ofLE _ _ inf_le_left))
    exact ⟨B, ⟨q, hq, hqB⟩, hB⟩

private lemma seq_lift (hG : IsSeparator G) (hM : M.Acyclic) (k : ℤ) (hk : k ≤ n) :
    ∃ q : (seq G M n g (k - 1) : C) ⟶
        (seq G M n g k ⊓ kernelSubobject (M.d k (k + 1)) : Subobject (M.X k)),
      Epi q ∧ q ≫ (seq G M n g k ⊓ kernelSubobject (M.d k (k + 1))).arrow =
        (seq G M n g (k - 1)).arrow ≫ M.d (k - 1) k := by
  rw [seq_pred G M n g k hk]
  refine (liftSubobject_spec _ _ _ ?_).1
  obtain ⟨B, q, hq, hqB, hB⟩ := exists_lift hG
    ((M.exactAt_iff' (k - 1) k (k + 1) (by simp) (by simp)).1 (hM k))
    (seq G M n g k ⊓ kernelSubobject (M.d k (k + 1))) (inf_kernelSubobject_arrow_comp _)
    ((seq_isGeneratedBy hG hM k hk).of_mono hG (Subobject.ofLE _ _ inf_le_left))
  exact ⟨B, ⟨q, hq, hqB⟩, hB⟩

private lemma seq_arrow_comp_d_succ :
    (seq G M n g (n + 1)).arrow ≫ M.d (n + 1) (n + 1 + 1) = 0 := by
  rw [seq_succ_self, ← cancel_epi (factorThruImageSubobject _),
    imageSubobject_arrow_comp_assoc, Category.assoc, HomologicalComplex.d_comp_d, comp_zero,
    comp_zero]

private lemma seq_factors (hG : IsSeparator G) (hM : M.Acyclic) (i : ℤ) :
    (seq G M n g (i + 1)).Factors ((seq G M n g i).arrow ≫ M.d i (i + 1)) := by
  by_cases h₁ : i + 1 ≤ n
  · obtain ⟨k, rfl⟩ : ∃ k, i = k - 1 := ⟨i + 1, by lia⟩
    obtain ⟨q, -, hq⟩ := seq_lift (g := g) hG hM k (by lia)
    rw [show k - 1 + 1 = k by lia]
    have := Subobject.factors_comp_arrow (q ≫ Subobject.ofLE _ _ inf_le_left)
    rwa [Category.assoc, Subobject.ofLE_arrow, hq] at this
  by_cases h₂ : i = n
  · subst i
    rw [seq_succ_self]
    have := Subobject.factors_comp_arrow (factorThruImageSubobject
      ((seq G M n g n).arrow ≫ M.d n (n + 1)))
    rwa [imageSubobject_arrow_comp] at this
  rw [seq_of_lt G M n g (i + 1) (by lia)]
  convert Subobject.factors_zero
  by_cases h₃ : i = n + 1
  · subst h₃
    exact seq_arrow_comp_d_succ
  · rw [seq_of_lt G M n g i (by lia), Subobject.bot_arrow, zero_comp]

omit [IsGrothendieckAbelian.{w} C] in
/-- A subobject equal to the image of `f` receives `f` epimorphically. -/
private lemma epi_factorThru_of_eq_imageSubobject {X Y : C} {f : X ⟶ Y} {B : Subobject Y}
    (hB : B = imageSubobject f) (h : B.Factors f) : Epi (B.factorThru f h) := by
  subst hB
  have : (imageSubobject f).factorThru f h = factorThruImageSubobject f := by
    rw [← cancel_mono (imageSubobject f).arrow, Subobject.factorThru_arrow,
      imageSubobject_arrow_comp]
  rw [this]
  infer_instance

private lemma isZero_seq (k : ℤ) (hk : n + 1 < k) : IsZero (seq G M n g k : C) := by
  rw [seq_of_lt G M n g k hk]
  exact (isZero_zero C).of_iso Subobject.botCoeIsoZero

variable (g) in
/-- The small acyclic subcomplex of `M` generated by `g`, as subcomplex data. -/
private noncomputable abbrev subcomplexData (hG : IsSeparator G) (hM : M.Acyclic) :
    HomologicalComplex.SubcomplexData M where
  X k := (seq G M n g k : C)
  ι k := (seq G M n g k).arrow
  mono _ := inferInstance
  d i j := if h : i + 1 = j then
      (seq G M n g j).factorThru ((seq G M n g i).arrow ≫ M.d i j)
        (by subst h; exact seq_factors hG hM i) else 0
  comm i j := by
    by_cases h : i + 1 = j
    · rw [dite_eq_left h, Subobject.factorThru_arrow]
    · rw [dite_eq_right h, zero_comp, M.shape i j (by simpa using h), comp_zero]

private lemma subcomplexData_d_succ (hG : IsSeparator G) (hM : M.Acyclic) (i : ℤ) :
    (subcomplexData g hG hM).d i (i + 1) =
      (seq G M n g (i + 1)).factorThru ((seq G M n g i).arrow ≫ M.d i (i + 1))
        (seq_factors hG hM i) :=
  dite_eq_left rfl

private lemma epi_subcomplexData_d (hG : IsSeparator G) (hM : M.Acyclic) :
    Epi ((subcomplexData g hG hM).d n (n + 1)) := by
  rw [subcomplexData_d_succ]
  exact epi_factorThru_of_eq_imageSubobject (seq_succ_self G M n g) _

private lemma acyclic_subcomplex (hG : IsSeparator G) (hM : M.Acyclic) :
    (subcomplexData g hG hM).toComplex.Acyclic := by
  intro k
  by_cases hk : k ≤ n
  · rw [(subcomplexData g hG hM).toComplex.exactAt_iff' (k - 1) k (k + 1) (by simp) (by simp),
      ShortComplex.exact_iff_exact_up_to_refinements]
    intro A (x₂ : A ⟶ (seq G M n g k : C)) hx₂
    change x₂ ≫ (subcomplexData g hG hM).d k (k + 1) = 0 at hx₂
    obtain ⟨q, hq, hqd⟩ := seq_lift (g := g) hG hM k hk
    have hx₂' : x₂ ≫ (seq G M n g k).arrow ≫ M.d k (k + 1) = 0 := by
      rw [subcomplexData_d_succ] at hx₂
      have := hx₂ =≫ (seq G M n g (k + 1)).arrow
      rwa [Category.assoc, Subobject.factorThru_arrow, zero_comp] at this
    have hfac : (seq G M n g k ⊓ kernelSubobject (M.d k (k + 1))).Factors
        (x₂ ≫ (seq G M n g k).arrow) :=
      (Subobject.inf_factors _).2 ⟨Subobject.factors_comp_arrow _,
        kernelSubobject_factors _ _ (by rw [Category.assoc, hx₂'])⟩
    obtain ⟨A', π, hπ, x₁, hx₁⟩ := surjective_up_to_refinements_of_epi q
      ((seq G M n g k ⊓ kernelSubobject (M.d k (k + 1))).factorThru _ hfac)
    refine ⟨A', π, hπ, x₁, ?_⟩
    change π ≫ x₂ = x₁ ≫ (subcomplexData g hG hM).d (k - 1) k
    rw [← cancel_mono (seq G M n g k).arrow]
    have e : (subcomplexData g hG hM).d (k - 1) k ≫ (seq G M n g k).arrow =
        (seq G M n g (k - 1)).arrow ≫ M.d (k - 1) k := (subcomplexData g hG hM).comm (k - 1) k
    rw [Category.assoc, Category.assoc, e, ← hqd, ← reassoc_of% hx₁,
      Subobject.factorThru_arrow]
  by_cases hk' : k = n + 1
  · subst hk'
    rw [(subcomplexData g hG hM).toComplex.exactAt_iff' n (n + 1) (n + 1 + 1) (by simp)
      (by simp), ShortComplex.exact_iff_exact_up_to_refinements]
    intro A (x₂ : A ⟶ (seq G M n g (n + 1) : C)) _
    have := epi_subcomplexData_d (g := g) hG hM
    exact surjective_up_to_refinements_of_epi ((subcomplexData g hG hM).d n (n + 1)) x₂
  · exact ShortComplex.exact_of_isZero_X₂ _ (isZero_seq k (by lia))

private lemma isStrictlyLE_subcomplex (hG : IsSeparator G) (hM : M.Acyclic) :
    IsStrictlyLE (subcomplexData g hG hM).toComplex (n + 1) :=
  (isStrictlyLE_iff _ _).2 (fun k hk => isZero_seq (G := G) (M := M) (g := g) k hk)

private lemma isGeneratedBy_subcomplex (hG : IsSeparator G) (hM : M.Acyclic) (k : ℤ) :
    IsGeneratedBy G (Σ j, stageIndex G j) ((subcomplexData g hG hM).toComplex.X k) := by
  by_cases hk : k ≤ n
  · exact (seq_isGeneratedBy hG hM k hk).of_injective _ sigma_mk_injective
  by_cases hk' : k = n + 1
  · subst hk'
    have := epi_subcomplexData_d (g := g) hG hM
    exact (((seq_isGeneratedBy (g := g) hG hM n le_rfl).of_epi
      ((subcomplexData g hG hM).d n (n + 1)))).of_injective _ sigma_mk_injective
  · exact IsGeneratedBy.of_isZero _ (isZero_seq k (by lia))

private lemma factors_seq_self : (seq G M n g n).Factors g := by
  rw [seq_self]
  have := Subobject.factors_comp_arrow (factorThruImageSubobject g)
  rwa [imageSubobject_arrow_comp] at this

variable (C) in
/-- The object of which every term of the small acyclic complexes is a quotient. -/
private noncomputable abbrev bigObject : C :=
  ∐ fun _ : (Σ j, stageIndex (separator C) j) => separator C

variable (C) in
/-- Complexes all of whose terms are cokernels of subobjects of `bigObject C`. -/
private abbrev Data : Type _ :=
  { x : (Σ R : ℤ → Subobject (bigObject C),
      ∀ k, cokernel (R k).arrow ⟶ cokernel (R (k + 1)).arrow) //
    ∀ k, x.2 k ≫ x.2 (k + 1) = 0 }

/-- The complex described by `x : Data C`. -/
private noncomputable def Data.complex (x : Data C) : CochainComplex C ℤ :=
  CochainComplex.of (fun k => cokernel (x.1.1 k).arrow) x.1.2 x.2

end AcyclicSubcomplex

open AcyclicSubcomplex

variable (C) [IsGrothendieckAbelian.{w} C]

/-- The index type of the family `CochainComplex.smallAcyclic` of bounded-above acyclic
complexes whose terms are bounded in size by the separator. It is `w`-small. -/
def SmallAcyclicIndex : Type w :=
  Shrink.{w} { x : Data C // x.complex.Acyclic ∧ ∃ n : ℤ, x.complex.IsStrictlyLE n }

/-- A `w`-small family of bounded-above acyclic complexes that detects acyclic complexes:
every nonzero acyclic complex has a nonzero subcomplex isomorphic to a member
(`CochainComplex.exists_mono_smallAcyclic`). -/
noncomputable def smallAcyclic (i : SmallAcyclicIndex C) : CochainComplex C ℤ :=
  ((equivShrink _).symm i).1.complex

lemma acyclic_smallAcyclic (i : SmallAcyclicIndex C) : (smallAcyclic C i).Acyclic :=
  ((equivShrink _).symm i).2.1

lemma exists_isStrictlyLE_smallAcyclic (i : SmallAcyclicIndex C) :
    ∃ n : ℤ, (smallAcyclic C i).IsStrictlyLE n :=
  ((equivShrink _).symm i).2.2

variable {C}

/-- A bounded-above acyclic complex whose terms are generated by families indexed by
`Σ j, stageIndex (separator C) j` is isomorphic to a member of `smallAcyclic C`. -/
private lemma exists_iso_smallAcyclic (X : CochainComplex C ℤ) (hX : X.Acyclic) (n : ℤ)
    [X.IsStrictlyLE n]
    (hgen : ∀ k, IsGeneratedBy (separator C) (Σ j, stageIndex (separator C) j) (X.X k)) :
    ∃ i : SmallAcyclicIndex C, Nonempty (smallAcyclic C i ≅ X) := by
  choose f hf using hgen
  have (k : ℤ) := epi_sigmaDesc_of_jointlyEpi (hf k)
  let e (k : ℤ) := isoCokernel (Sigma.desc (f k))
  let x : Data C := ⟨⟨fun k => Subobject.mk (kernel.ι (Sigma.desc (f k))),
    fun k => (e k).inv ≫ X.d k (k + 1) ≫ (e (k + 1)).hom⟩, fun k => by simp⟩
  let φ : x.complex ≅ X := HomologicalComplex.Hom.isoOfComponents (fun k => (e k).symm)
    (by rintro i j rfl; simp [Data.complex, x])
  have hx : x.complex.Acyclic := fun k => (hX k).of_iso φ.symm
  have : x.complex.IsStrictlyLE n := isStrictlyLE_of_iso φ.symm n
  refine ⟨equivShrink _ ⟨x, hx, n, this⟩, ⟨eqToIso ?_ ≪≫ φ⟩⟩
  simp [smallAcyclic]

/-- **Stacks, Lemma 19.12.2 (Tag 079K)**, first part: every nonzero acyclic complex
has a nonzero subcomplex isomorphic to a member of the `w`-small family
`smallAcyclic C` of bounded-above acyclic complexes. -/
@[stacks 079K "first part"]
theorem exists_mono_smallAcyclic {M : CochainComplex C ℤ} (hM : M.Acyclic) (hM0 : ¬ IsZero M) :
    ∃ (i : SmallAcyclicIndex C) (f : smallAcyclic C i ⟶ M), Mono f ∧
      ¬ IsZero (smallAcyclic C i) := by
  have hG := isSeparator_separator C
  obtain ⟨n, hn⟩ : ∃ n, ¬ IsZero (M.X n) := by
    by_contra! h
    apply hM0
    rw [IsZero.iff_id_eq_zero]
    ext k
    exact (h k).eq_of_src _ _
  obtain ⟨g, hg⟩ : ∃ g : separator C ⟶ M.X n, g ≠ 0 := by
    by_contra! h
    apply hn
    rw [IsZero.iff_id_eq_zero]
    exact hG.def _ _ (fun g' => by simp [h g'])
  have := isStrictlyLE_subcomplex (g := g) hG hM
  obtain ⟨i, ⟨e⟩⟩ := exists_iso_smallAcyclic (subcomplexData g hG hM).toComplex
    (acyclic_subcomplex hG hM) (n + 1) (isGeneratedBy_subcomplex hG hM)
  refine ⟨i, e.hom ≫ (subcomplexData g hG hM).toComplexι, inferInstance, fun hz => hg ?_⟩
  have hz' : IsZero ((subcomplexData g hG hM).toComplex.X n) :=
    (HomologicalComplex.eval _ _ n).map_isZero (hz.of_iso e.symm)
  have h0 : (seq (separator C) M n g n).factorThru g factors_seq_self = 0 :=
    hz'.eq_of_tgt _ _
  rw [← Subobject.factorThru_arrow (seq (separator C) M n g n) g factors_seq_self, h0,
    zero_comp]

/-- **Stacks, Lemma 19.12.2 (Tag 079K)**, second part: every acyclic complex is a
quotient of a `w`-small coproduct of members of `smallAcyclic C`. -/
@[stacks 079K "second part"]
theorem exists_epi_sigma_smallAcyclic {M : CochainComplex C ℤ} (hM : M.Acyclic) :
    ∃ (J : Type w) (k : J → SmallAcyclicIndex C)
      (p : ∐ (fun j => smallAcyclic C (k j)) ⟶ M), Epi p := by
  have hG := isSeparator_separator C
  have H (n : ℤ) (x : separator C ⟶ M.X n) : ∃ (i : SmallAcyclicIndex C)
      (f : smallAcyclic C i ⟶ M) (x' : separator C ⟶ (smallAcyclic C i).X n),
      x' ≫ f.f n = x := by
    have := isStrictlyLE_subcomplex (g := x) hG hM
    obtain ⟨i, ⟨e⟩⟩ := exists_iso_smallAcyclic (subcomplexData x hG hM).toComplex
      (acyclic_subcomplex hG hM) (n + 1) (isGeneratedBy_subcomplex hG hM)
    obtain ⟨y, hy⟩ : ∃ y : separator C ⟶ (subcomplexData x hG hM).toComplex.X n,
        y ≫ (subcomplexData x hG hM).toComplexι.f n = x :=
      ⟨_, Subobject.factorThru_arrow _ _ factors_seq_self⟩
    refine ⟨i, e.hom ≫ (subcomplexData x hG hM).toComplexι, y ≫ e.inv.f n, ?_⟩
    rw [HomologicalComplex.comp_f, Category.assoc, ← HomologicalComplex.comp_f_assoc,
      e.inv_hom_id, HomologicalComplex.id_f, Category.id_comp, hy]
  choose I F hF using H
  let J := Σ n : ℤ, Shrink.{w} (separator C ⟶ M.X n)
  refine ⟨J, fun j => I j.1 ((equivShrink _).symm j.2),
    Sigma.desc (fun j => F j.1 ((equivShrink _).symm j.2)), ?_⟩
  refine HomologicalComplex.epi_of_epi_f _ (fun n => ⟨fun {Z} a b hab => ?_⟩)
  refine hG.def _ _ (fun x => ?_)
  obtain ⟨x', hx'⟩ := hF n x
  have h₁ : (F n ((equivShrink _).symm (equivShrink _ x))).f n ≫ a =
      (F n ((equivShrink _).symm (equivShrink _ x))).f n ≫ b := by
    have := Sigma.ι_comp_desc (fun j : J => F j.1 ((equivShrink _).symm j.2))
      ⟨n, equivShrink _ x⟩
    rw [← this, HomologicalComplex.comp_f, Category.assoc, Category.assoc, hab]
  rw [Equiv.symm_apply_apply] at h₁
  rw [← hx', Category.assoc, Category.assoc, h₁]

end CochainComplex
