import DerivedAlgGeo.AlgebraicGeometry.Modules.Descent.Directed
import DerivedAlgGeo.AlgebraicGeometry.Modules.Descent.LocallyFree
import DerivedAlgGeo.AlgebraicGeometry.ProjectiveSpectrum.Modules.MapPullback
import DerivedAlgGeo.AlgebraicGeometry.ProjectiveSpectrum.Relative.Basic

/-!
# Twisting sheaves on relative `Proj`

For a quasi-coherent graded `𝒪_S`-algebra `𝒜` generated in degree one, the twisting sheaves
`𝒪(d)` of the charts `Proj 𝒜(U)` glue to an invertible sheaf `𝒪(d)` on `Proj_S(𝒜)`
(Stacks 01NR), whose restriction to the chart over `U` is `𝒪_{Proj 𝒜(U)}(d)`.

## Main definitions

* `QuasicoherentGradedAlgebraData.GeneratedInDegreeOne 𝒜`: every `𝒜(U)` is generated by
  `𝒜(U)₁` over `𝒜(U)₀`.
* `QuasicoherentGradedAlgebraData.twistingGluingData 𝒜 hgen d`: the charts' twisting sheaves
  as a directed system on `Proj_S(𝒜)`.
* `QuasicoherentGradedAlgebraData.twistingSheaf 𝒜 hgen d`: the twisting sheaf `𝒪(d)`.
* `QuasicoherentGradedAlgebraData.twistingSheafRestrictIso 𝒜 hgen d U`: its restriction to the
  chart `Proj 𝒜(U)` is `𝒪_{Proj 𝒜(U)}(d)`.

## Main results

* `QuasicoherentGradedAlgebraData.isInvertible_twistingSheaf`: `𝒪(d)` is invertible.

## Implementation notes

The twisting sheaves are glued with `Scheme.Modules.DirectedGluingData`, over the charts
`Proj 𝒜(U)` indexed by the affine Zariski site of `S`. A chart over a basic open `V = D(f)` of
`U` is open in the chart over `U` (`isPullback_map_restrict`), and two charts meet in a union of
charts over opens that are basic in both (`exists_basicOpen_le_affine_inter`). The transition
maps are `Proj.twistingSheafMapOfRingHom` along the restrictions `𝒜(U) → 𝒜(V)`: they compose
(`Proj.twistingSheafMapOfRingHom_comp_app`), and on the image of `Proj 𝒜(V)` they are bijective
on sections because the comparison `θ` of Stacks 01MY is an isomorphism when `𝒜(U)` is generated
in degree one (`Proj.twistingSheafMapOfRingHom_app_image_bijective`).

`Scheme.ZariskiDescent.glue` is not used: its descent data ask for the gluing morphism over every
test scheme mapping to two charts, while the overlaps of charts here are only unions of smaller
charts.

The hypothesis `GeneratedInDegreeOne` is used twice: for the isomorphism `θ` on each chart, and
for the invertibility of `𝒪(d)` on each chart. Without it neither holds: for the weighted plane
`k[x, y, z]` with `deg z = 2`, `𝒪(1)` is not invertible at the vertex. It is a hypothesis, not a
field of `QuasicoherentGradedAlgebraData`.

## References

* [Stacks, Lemma 27.15.5 (Tag 01NR)](https://stacks.math.columbia.edu/tag/01NR).
* [Stacks, Lemma 27.11.1 (Tag 01MY)](https://stacks.math.columbia.edu/tag/01MY): the comparison
  `θ` on each chart.
* EGA II, §3.2.

## Tags

relative Proj, twisting sheaf, invertible sheaf, gluing
-/

universe u

open CategoryTheory Opposite TopologicalSpace

namespace AlgebraicGeometry.Scheme.QuasicoherentGradedAlgebraData

open AffineZariskiSite

variable {S : Scheme.{u}} (𝒜 : S.QuasicoherentGradedAlgebraData)

/-- **Generation in degree one**: on every affine open `U`, the graded algebra `𝒜(U)` is
generated by `𝒜(U)₁` over `𝒜(U)₀`. -/
def GeneratedInDegreeOne : Prop :=
  ∀ U : S.AffineZariskiSite,
    Algebra.adjoin (𝒜.grading U 0) ((𝒜.grading U 1 : Set (𝒜.carrier U))) = ⊤

variable {𝒜}

/-- Generation in degree one, in the form taken by the `Proj` lemmas: the inclusion of `𝒜(U)₁`
is a generating family. -/
theorem GeneratedInDegreeOne.adjoin_range (hgen : 𝒜.GeneratedInDegreeOne)
    (U : S.AffineZariskiSite) :
    Algebra.adjoin (𝒜.grading U 0)
      (Set.range fun x : 𝒜.grading U 1 => (x : 𝒜.carrier U)) = ⊤ := by
  convert hgen U
  ext x
  simp

variable (𝒜)

/-- Two charts meet in a union of charts over opens that are basic in both. -/
theorem exists_le_of_mem_opensRange {U U' : S.AffineZariskiSite} {x : 𝒜.relativeProj}
    (hU : x ∈ (𝒜.relativeProjι U).opensRange) (hU' : x ∈ (𝒜.relativeProjι U').opensRange) :
    ∃ V, ∃ (_ : V ≤ U) (_ : V ≤ U'), x ∈ (𝒜.relativeProjι V).opensRange := by
  rw [opensRange_relativeProjι] at hU hU'
  obtain ⟨f, g, e, hf⟩ :=
    exists_basicOpen_le_affine_inter U.2 U'.2 (𝒜.relativeProjToBase x) ⟨hU, hU'⟩
  refine ⟨U.basicOpen f, U.basicOpen_le f, ⟨g, e.symm⟩, ?_⟩
  rw [opensRange_relativeProjι]
  exact hf

/-- **The twisting sheaves of the charts, as a directed system** on `Proj_S(𝒜)`: the charts
`Proj 𝒜(U)`, their twisting sheaves `𝒪(d)`, and the maps `𝒪(d) ⟶ (Proj.map)_* 𝒪(d)` along the
restrictions `𝒜(U) → 𝒜(V)` to basic opens. -/
noncomputable def twistingGluingData (hgen : 𝒜.GeneratedInDegreeOne) (d : ℤ) :
    Scheme.Modules.DirectedGluingData 𝒜.relativeProj where
  J := S.AffineZariskiSite
  P U := Proj (𝒜.grading U)
  ι := 𝒜.relativeProjι
  map h := Proj.map (𝒜.restrict h) (𝒜.irrelevant_le_map_restrict h)
  map_ι h := 𝒜.map_restrict_relativeProjι h
  exists_le := 𝒜.exists_le_of_mem_opensRange
  obj U := Proj.twistingSheaf (𝒜.grading U) d
  φ h := Proj.twistingSheafMapOfRingHom (𝒜.restrict h) (𝒜.irrelevant_le_map_restrict h) d
  φ_comp hki hij A s C hC₁ hC₂ :=
    Proj.twistingSheafMapOfRingHom_comp_app _ _ _ _ _ _
      (GradedRingHom.ext fun x ↦ 𝒜.restrict_comp hij hki x) d A s C hC₁ hC₂
  bijective _ B :=
    Proj.twistingSheafMapOfRingHom_app_image_bijective _ _ (fun x : 𝒜.grading _ 1 ↦ x)
      (hgen.adjoin_range _) d B

/-- **The twisting sheaf `𝒪(d)` on `Proj_S(𝒜)`** (Stacks 01NR), for `𝒜` generated in degree one:
the twisting sheaves `𝒪(d)` of the charts `Proj 𝒜(U)`, glued. -/
noncomputable def twistingSheaf (hgen : 𝒜.GeneratedInDegreeOne) (d : ℤ) :
    𝒜.relativeProj.Modules :=
  (𝒜.twistingGluingData hgen d).glue

/-- **`𝒪(d)` on a chart**: the restriction of `𝒪(d)` to `Proj 𝒜(U)` is `𝒪_{Proj 𝒜(U)}(d)`. -/
noncomputable def twistingSheafRestrictIso (hgen : 𝒜.GeneratedInDegreeOne) (d : ℤ)
    (U : S.AffineZariskiSite) :
    (𝒜.twistingSheaf hgen d).restrict (𝒜.relativeProjι U) ≅ Proj.twistingSheaf (𝒜.grading U) d :=
  (𝒜.twistingGluingData hgen d).glueRestrictIso U

/-- The charts cover `Proj_S(𝒜)`. -/
theorem iSup_opensRange_relativeProjι :
    ⨆ U : S.AffineZariskiSite, (𝒜.relativeProjι U).opensRange = ⊤ := by
  refine top_le_iff.mp fun x _ ↦ ?_
  obtain ⟨V, hV⟩ := Opens.mem_iSup.mp
    ((iSup_affineOpens_eq_top S).ge (Set.mem_univ (𝒜.relativeProjToBase x)))
  exact Opens.mem_iSup.mpr ⟨⟨V.1, V.2⟩, (𝒜.opensRange_relativeProjι ⟨V.1, V.2⟩).ge hV⟩

private theorem isInvertible_of_isLocallyFreeOfRank_one {X : Scheme.{u}} (M : X.Modules)
    (h : SheafOfModules.IsLocallyFreeOfRank.{u, u, u}
      (show SheafOfModules X.ringCatSheaf from M) 1) :
    SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from M) := by
  obtain ⟨q, hq, hr⟩ := h
  have hr' : q.IsRankOne := fun i ↦ by
    obtain ⟨h₁, h₂⟩ := Nat.card_eq_one_iff_unique.mp (hr i)
    exact ⟨h₂, h₁⟩
  exact SheafOfModules.IsInvertible.mk.{u, u, u} ⟨q, hq, hr'⟩

private theorem isLocallyFreeOfRank_one_of_isInvertible {X : Scheme.{u}} (M : X.Modules)
    [h : SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from M)] :
    SheafOfModules.IsLocallyFreeOfRank.{u, u, u}
      (show SheafOfModules X.ringCatSheaf from M) 1 := by
  obtain ⟨q, hq, hr⟩ := h.exists_rankOneData
  exact ⟨q, hq, fun i ↦ Nat.card_eq_one_iff_unique.mpr ⟨(hr i).2, (hr i).1⟩⟩

/-- **`𝒪(d)` is invertible** (Stacks 01NR): on each chart it is `𝒪_{Proj 𝒜(U)}(d)`, which is
invertible since `𝒜(U)` is generated in degree one. -/
theorem isInvertible_twistingSheaf (hgen : 𝒜.GeneratedInDegreeOne) (d : ℤ) :
    SheafOfModules.IsInvertible.{u, u, u}
      (show SheafOfModules 𝒜.relativeProj.ringCatSheaf from 𝒜.twistingSheaf hgen d) := by
  refine isInvertible_of_isLocallyFreeOfRank_one _ ?_
  refine Scheme.Modules.isLocallyFreeOfRank_of_cover _ 𝒜.relativeProjι
    𝒜.iSup_opensRange_relativeProjι fun U ↦ ?_
  have := Proj.twistingSheaf_isInvertible (𝒜.grading U) (fun x : 𝒜.grading U 1 ↦ x) d
    (hgen.adjoin_range U)
  have e : (Scheme.Modules.pullback (𝒜.relativeProjι U)).obj (𝒜.twistingSheaf hgen d) ≅
      Proj.twistingSheaf (𝒜.grading U) d :=
    ((Scheme.Modules.restrictFunctorIsoPullback (𝒜.relativeProjι U)).app _).symm ≪≫
      𝒜.twistingSheafRestrictIso hgen d U
  haveI := SheafOfModules.IsInvertible.ofIso.{u, u, u} e.symm
  exact isLocallyFreeOfRank_one_of_isInvertible _

end AlgebraicGeometry.Scheme.QuasicoherentGradedAlgebraData
