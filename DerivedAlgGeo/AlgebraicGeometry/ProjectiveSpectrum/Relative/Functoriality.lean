import DerivedAlgGeo.AlgebraicGeometry.ProjectiveSpectrum.Functor
import DerivedAlgGeo.AlgebraicGeometry.ProjectiveSpectrum.Relative.Basic

/-!
# Functoriality of relative `Proj`

A map `ψ : 𝒜 ⟶ ℬ` of quasi-coherent graded `𝒪_S`-algebras induces a morphism
`Proj_S(ℬ) ⟶ Proj_S(𝒜)` over `S` once, for every affine open `U`, the irrelevant ideal of `ℬ(U)`
lies in the ideal generated by the image of that of `𝒜(U)`. The morphism is a closed immersion
when every `ψ(U)` is surjective (Stacks, Section 27.18).

## Main definitions

* `QuasicoherentGradedAlgebraData.Hom 𝒜 ℬ`: a map of quasi-coherent graded algebras, as graded
  `Γ(S, U)`-algebra maps `𝒜(U) → ℬ(U)` compatible with restriction; the morphisms of the category
  of quasi-coherent graded algebras on `S`.
* `QuasicoherentGradedAlgebraData.relativeProjMap ψ hψ`: the morphism
  `Proj_S(ℬ) ⟶ Proj_S(𝒜)`, given on the chart over `U` by `Proj.map (ψ(U))`.

## Main results

* `QuasicoherentGradedAlgebraData.relativeProjMap_toBase`: the morphism lies over `S`.
* `QuasicoherentGradedAlgebraData.isPullback_relativeProjι_relativeProjMap`: the chart
  `Proj ℬ(U)` is the preimage of the chart `Proj 𝒜(U)`.
* `QuasicoherentGradedAlgebraData.relativeProjMap_id`, `relativeProjMap_comp`: functoriality
  (Stacks 07ZH).
* `QuasicoherentGradedAlgebraData.relativeProjMap_iff`: a property of morphisms that is local on
  the target holds for `relativeProjMap ψ hψ` if and only if it holds for every
  `Proj.map (ψ(U))`.
* `QuasicoherentGradedAlgebraData.isClosedImmersion_relativeProjMap`: if every `ψ(U)` is
  surjective, the morphism is a closed immersion (Stacks 07ZI, for surjectivity in every degree).

## Implementation notes

For a general graded map, Stacks 07ZG defines `Proj_S(ℬ) ⇢ Proj_S(𝒜)` only on an open `U(ψ)`.
Mathlib's `AlgebraicGeometry.Proj.map` is defined on all of `Proj ℬ(U)` under the hypothesis
`ℬ(U)₊ ≤ 𝒜(U)₊ ℬ(U)`, and `relativeProjMap` asks for that hypothesis on every chart. It holds
for chartwise surjective `ψ` (`AlgebraicGeometry.Proj.irrelevant_le_map_of_surjective`), but not
for every `ψ` that is surjective in large degrees only, the hypothesis of Stacks 07ZI: for
`k[x] → k[x, y]/(y², xy)` with `x, y` of degree one, the degree-one element `y` is not in the
ideal generated by `x`. So the closed-immersion statement is for chartwise surjective `ψ`.

The morphism is glued from the charts by the universal property of `Proj_S(ℬ)` as a colimit, and
its properties are read off chart by chart from the cartesian squares
`isPullback_relativeProjι_relativeProjMap`, which come from the two squares
`QuasicoherentGradedAlgebraData.isPullback_relativeProjι` over `U ⊆ S`.

## References

* [Stacks, Section 27.18 (Tag 07ZF)](https://stacks.math.columbia.edu/tag/07ZF): functoriality of
  relative Proj, Lemmas 27.18.1 (Tag 07ZG), 27.18.2 (Tag 07ZH) and 27.18.3 (Tag 07ZI).
* [Stacks, Lemma 27.11.3 (Tag 01N0)](https://stacks.math.columbia.edu/tag/01N0): the chartwise
  closed immersion.
* EGA II, §3.5.

## Tags

relative Proj, functoriality, closed immersion, quasi-coherent graded algebra
-/

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme.QuasicoherentGradedAlgebraData

open AffineZariskiSite

variable {S : Scheme.{u}}

/-- **A map of quasi-coherent graded `𝒪_S`-algebras** `𝒜 → ℬ`: for every affine open `U`, a
graded `Γ(S, U)`-algebra map `𝒜(U) → ℬ(U)`, compatible with restriction to basic opens. -/
@[ext]
structure Hom (𝒜 ℬ : S.QuasicoherentGradedAlgebraData) where
  /-- The map `𝒜(U) → ℬ(U)` over an affine open `U`. -/
  app (U : S.AffineZariskiSite) : 𝒜.grading U →+*ᵍ ℬ.grading U
  app_algebraMap (U : S.AffineZariskiSite) (r : Γ(S, U.toOpens)) :
    app U (algebraMap Γ(S, U.toOpens) (𝒜.carrier U) r) =
      algebraMap Γ(S, U.toOpens) (ℬ.carrier U) r
  app_restrict {U V : S.AffineZariskiSite} (h : V ≤ U) (x : 𝒜.carrier U) :
    app V (𝒜.restrict h x) = ℬ.restrict h (app U x)

instance : Category S.QuasicoherentGradedAlgebraData where
  Hom := Hom
  id 𝒜 :=
    { app U := GradedRingHom.id (𝒜.grading U)
      app_algebraMap _ _ := rfl
      app_restrict _ _ := rfl }
  comp ψ φ :=
    { app U := (φ.app U).comp (ψ.app U)
      app_algebraMap U r := by
        rw [GradedRingHom.comp_apply, ψ.app_algebraMap, φ.app_algebraMap]
      app_restrict h x := by
        rw [GradedRingHom.comp_apply, GradedRingHom.comp_apply, ψ.app_restrict, φ.app_restrict] }

variable {𝒜 ℬ 𝒞 : S.QuasicoherentGradedAlgebraData}

@[ext]
theorem hom_ext {ψ φ : 𝒜 ⟶ ℬ} (h : ∀ U, ψ.app U = φ.app U) : ψ = φ :=
  Hom.ext (funext h)

@[simp]
theorem id_app (U : S.AffineZariskiSite) :
    (𝟙 𝒜 : 𝒜 ⟶ 𝒜).app U = GradedRingHom.id (𝒜.grading U) :=
  rfl

@[simp]
theorem comp_app (ψ : 𝒜 ⟶ ℬ) (φ : ℬ ⟶ 𝒞) (U : S.AffineZariskiSite) :
    (ψ ≫ φ).app U = (φ.app U).comp (ψ.app U) :=
  rfl

variable (ψ : 𝒜 ⟶ ℬ)

/-- `Proj.map` of `ψ` on the charts commutes with the restriction maps. -/
@[reassoc]
theorem map_restrict_comp_map_app {U V : S.AffineZariskiSite} (h : V ≤ U)
    (hU : HomogeneousIdeal.irrelevant (ℬ.grading U) ≤
      (HomogeneousIdeal.irrelevant (𝒜.grading U)).map (ψ.app U))
    (hV : HomogeneousIdeal.irrelevant (ℬ.grading V) ≤
      (HomogeneousIdeal.irrelevant (𝒜.grading V)).map (ψ.app V)) :
    Proj.map (ℬ.restrict h) (ℬ.irrelevant_le_map_restrict h) ≫ Proj.map (ψ.app U) hU =
      Proj.map (ψ.app V) hV ≫ Proj.map (𝒜.restrict h) (𝒜.irrelevant_le_map_restrict h) := by
  rw [← Proj.map_comp, ← Proj.map_comp]
  congr 1
  exact GradedRingHom.ext fun x ↦ (ψ.app_restrict h x).symm

/-- `Proj.map` of `ψ` on a chart lies over `Spec Γ(S, U)`. -/
@[reassoc (attr := simp)]
theorem map_app_projToSpec (U : S.AffineZariskiSite)
    (hU : HomogeneousIdeal.irrelevant (ℬ.grading U) ≤
      (HomogeneousIdeal.irrelevant (𝒜.grading U)).map (ψ.app U)) :
    Proj.map (ψ.app U) hU ≫ 𝒜.projToSpec U = ℬ.projToSpec U := by
  rw [projToSpec, projToSpec, Proj.map_toSpecZero_assoc, ← Spec.map_comp]
  congr 2
  ext r
  exact ψ.app_algebraMap U r

variable (hψ : ∀ U, HomogeneousIdeal.irrelevant (ℬ.grading U) ≤
  (HomogeneousIdeal.irrelevant (𝒜.grading U)).map (ψ.app U))

/-- **The morphism of relative `Proj`s induced by a graded map** (Stacks 07ZG): for
`ψ : 𝒜 ⟶ ℬ` such that the irrelevant ideal of every `ℬ(U)` lies in the ideal generated by the
image of that of `𝒜(U)`, the morphism `Proj_S(ℬ) ⟶ Proj_S(𝒜)` given on the chart over `U` by
`Proj.map (ψ(U))`. Stacks 07ZG defines it on an open `U(ψ)`; the hypothesis makes `Proj.map`
defined on every chart, so here it is defined on all of `Proj_S(ℬ)`. -/
noncomputable def relativeProjMap : ℬ.relativeProj ⟶ 𝒜.relativeProj :=
  colimit.desc ℬ.relativeGluingData.functor
    { pt := 𝒜.relativeProj
      ι :=
        { app U := Proj.map (ψ.app U) (hψ U) ≫ 𝒜.relativeProjι U
          naturality {V U} i := by
            change Proj.map _ _ ≫ Proj.map _ _ ≫ _ = (Proj.map _ _ ≫ _) ≫ 𝟙 _
            rw [Category.comp_id, map_restrict_comp_map_app_assoc _ (leOfHom i) (hψ U) (hψ V),
              map_restrict_relativeProjι] } }

@[reassoc (attr := simp)]
theorem relativeProjι_relativeProjMap (U : S.AffineZariskiSite) :
    ℬ.relativeProjι U ≫ relativeProjMap ψ hψ = Proj.map (ψ.app U) (hψ U) ≫ 𝒜.relativeProjι U :=
  colimit.ι_desc _ _

/-- The morphism `Proj_S(ℬ) ⟶ Proj_S(𝒜)` lies over `S`. -/
@[reassoc (attr := simp)]
theorem relativeProjMap_toBase :
    relativeProjMap ψ hψ ≫ 𝒜.relativeProjToBase = ℬ.relativeProjToBase :=
  ℬ.relativeProj_hom_ext fun U ↦ by
    rw [relativeProjι_relativeProjMap_assoc, relativeProjι_toBase, relativeProjι_toBase,
      map_app_projToSpec_assoc]

/-- **The chart over `U` is a preimage**: `Proj ℬ(U)` is the preimage of the chart `Proj 𝒜(U)`
under `Proj_S(ℬ) ⟶ Proj_S(𝒜)`. Both are the preimages of `U ⊆ S`. -/
theorem isPullback_relativeProjι_relativeProjMap (U : S.AffineZariskiSite) :
    IsPullback (ℬ.relativeProjι U) (Proj.map (ψ.app U) (hψ U)) (relativeProjMap ψ hψ)
      (𝒜.relativeProjι U) := by
  refine (IsPullback.of_right ?_ (relativeProjι_relativeProjMap ψ hψ U).symm
    (𝒜.isPullback_relativeProjι U)).flip
  rw [map_app_projToSpec_assoc, relativeProjMap_toBase]
  exact ℬ.isPullback_relativeProjι U

/-- **The morphism is determined by the charts.** A property of morphisms that is local on the
target holds for `Proj_S(ℬ) ⟶ Proj_S(𝒜)` if and only if it holds for every
`Proj.map (ψ(U)) : Proj ℬ(U) ⟶ Proj 𝒜(U)`. -/
theorem relativeProjMap_iff (P : MorphismProperty Scheme.{u}) [IsZariskiLocalAtTarget P] :
    P (relativeProjMap ψ hψ) ↔ ∀ U, P (Proj.map (ψ.app U) (hψ U)) := by
  refine ⟨fun H U ↦ IsZariskiLocalAtTarget.of_isPullback
    (isPullback_relativeProjι_relativeProjMap ψ hψ U) H, fun H ↦ ?_⟩
  refine IsZariskiLocalAtTarget.of_openCover 𝒜.relativeGluingData.cover fun U ↦ ?_
  refine (P.arrow_mk_iso_iff (Arrow.isoMk
    (isPullback_relativeProjι_relativeProjMap ψ hψ U).isoPullback (Iso.refl _) ?_)).mp (H U)
  simp only [Cover.pullbackHom, Iso.refl_hom, Category.comp_id]
  exact (isPullback_relativeProjι_relativeProjMap ψ hψ U).isoPullback_hom_snd

/-- **A chartwise surjective map gives a closed immersion** (Stacks 07ZI, for a map that is
surjective in every degree): if every `ψ(U) : 𝒜(U) → ℬ(U)` is surjective, then
`Proj_S(ℬ) ⟶ Proj_S(𝒜)` is a closed immersion. On the chart over `U` it is
`Proj.map (ψ(U))`, a closed immersion by Stacks 01N0. -/
theorem isClosedImmersion_relativeProjMap (hsurj : ∀ U, Function.Surjective (ψ.app U)) :
    IsClosedImmersion (relativeProjMap ψ hψ) :=
  (relativeProjMap_iff ψ hψ @IsClosedImmersion).mpr fun U ↦
    Proj.isClosedImmersion_map_of_surjective _ (hsurj U) _

/-- `Proj_S` of the identity is the identity. -/
theorem relativeProjMap_id
    (h : ∀ U, HomogeneousIdeal.irrelevant (𝒜.grading U) ≤
      (HomogeneousIdeal.irrelevant (𝒜.grading U)).map ((𝟙 𝒜 : 𝒜 ⟶ 𝒜).app U)) :
    relativeProjMap (𝟙 𝒜) h = 𝟙 𝒜.relativeProj :=
  𝒜.relativeProj_hom_ext fun U ↦ by
    rw [relativeProjι_relativeProjMap, Category.comp_id]
    conv_rhs => rw [← Category.id_comp (𝒜.relativeProjι U), ← Proj.map_id]
    rfl

/-- **`Proj_S` is functorial** (Stacks 07ZH): for `ψ : 𝒜 ⟶ ℬ` and `φ : ℬ ⟶ 𝒞`, the morphism
induced by `ψ ≫ φ` is the composite of those induced by `φ` and `ψ`. -/
theorem relativeProjMap_comp (φ : ℬ ⟶ 𝒞)
    (hφ : ∀ U, HomogeneousIdeal.irrelevant (𝒞.grading U) ≤
      (HomogeneousIdeal.irrelevant (ℬ.grading U)).map (φ.app U))
    (h : ∀ U, HomogeneousIdeal.irrelevant (𝒞.grading U) ≤
      (HomogeneousIdeal.irrelevant (𝒜.grading U)).map ((ψ ≫ φ).app U)) :
    relativeProjMap (ψ ≫ φ) h = relativeProjMap φ hφ ≫ relativeProjMap ψ hψ :=
  𝒞.relativeProj_hom_ext fun U ↦ by
    rw [relativeProjι_relativeProjMap, relativeProjι_relativeProjMap_assoc,
      relativeProjι_relativeProjMap, ← Category.assoc, ← Proj.map_comp]
    rfl

end AlgebraicGeometry.Scheme.QuasicoherentGradedAlgebraData
