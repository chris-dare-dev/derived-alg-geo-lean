import Mathlib.AlgebraicGeometry.Sites.BigZariski
import DerivedAlgGeo.CategoryTheory.Sites.Descent.Local

/-!
# Stacks for the big Zariski topology and coproducts

Let `F : LocallyDiscrete Scheme.{u}ᵒᵖ ⥤ᵖ Cat` be a stack for the big Zariski topology. For a
`u`-small family of morphisms `f i : X i ⟶ S`, `F` has effective descent along the family
`f` if and only if it has effective descent along the single morphism `∐ X i ⟶ S`. This is
the stack analogue of Mathlib's `Scheme.Cover.isSheafFor_sigma_iff`, and the reduction to a
single morphism in Step 2 of the proof of Vistoli's Lemma 4.25.

## Main results

* `AlgebraicGeometry.isStackFor_singleton_sigmaDesc_iff`
* `AlgebraicGeometry.Scheme.Cover.isStackFor_sigma_iff`

## Implementation notes

The sieve generated by the family `f` is contained in the sieve generated by
`Sigma.desc f`, and its pullback along any morphism `Y ⟶ ∐ X i` contains the pullback of
the Zariski covering of `∐ X i` by the `X i`. So the two sieves agree Zariski locally along
the second, and `Pseudofunctor.isStackFor_iff_of_le_of_isStackFor_pullback` applies.

Vistoli proves the reduction through his Lemma 4.26 (`F ∅` is equivalent to the category with
one object and one morphism) and Lemma 4.27 (`F (∐ U i)` is equivalent to `∏ F (U i)`), and
Mathlib's sheaf version through the preservation of products by Zariski sheaves; neither is
needed here. In particular, no finiteness of the family is assumed, and the empty family is
included: then `∐ X i` is the empty scheme and so is `S`.

## References

* A. Vistoli, *Notes on Grothendieck topologies, fibered categories and descent theory*,
  arXiv:math/0412512v4, Lemma 4.25, Step 2, with Lemmas 4.26 and 4.27.

## Tags

stack, descent, Zariski topology, coproduct
-/

universe v' u' v u

open CategoryTheory Bicategory Limits

namespace AlgebraicGeometry

variable {F : LocallyDiscrete Scheme.{u}ᵒᵖ ⥤ᵖ Cat.{v', u'}} [F.IsStack Scheme.zariskiTopology]

/-- A stack for the big Zariski topology has effective descent along a `u`-small family of
morphisms `f i : X i ⟶ S` if and only if it has effective descent along the induced morphism
`Sigma.desc f : ∐ X i ⟶ S`. This is the stack analogue of Mathlib's
`Presieve.isSheafFor_sigmaDesc_iff` for Zariski sheaves; no finiteness is needed. -/
lemma isStackFor_singleton_sigmaDesc_iff {S : Scheme.{u}} {ι : Type v} [Small.{u} ι]
    {X : ι → Scheme.{u}} (f : ∀ i, X i ⟶ S) :
    F.IsStackFor (.singleton (Sigma.desc f)) ↔ F.IsStackFor (.ofArrows X f) := by
  rw [← F.IsStackFor_generate_iff (.ofArrows X f), ← F.IsStackFor_generate_iff]
  refine (F.isStackFor_iff_of_le_of_isStackFor_pullback ?_ fun Y g hg ↦ ?_).symm
  · rw [Sieve.generate_le_iff]
    rintro _ _ ⟨i⟩
    exact ⟨_, Sigma.ι X i, _, Presieve.singleton_self _, Sigma.ι_comp_desc f i⟩
  · obtain ⟨Z, a, _, ⟨⟩, rfl⟩ := hg
    have hX : Sieve.ofArrows X (Sigma.ι X) ∈ Scheme.zariskiTopology (∐ X) :=
      (sigmaOpenCover X).mem_grothendieckTopology
    refine F.isStackFor' _ (Scheme.zariskiTopology.superset_covering (fun W c hc ↦ ?_)
      (Scheme.zariskiTopology.pullback_stable a hX))
    obtain ⟨i, d, hd⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hc
    refine ⟨_, d, f i, ⟨i⟩, ?_⟩
    rw [← Category.assoc, hd, Category.assoc, Sigma.ι_comp_desc]

/-- A stack for the big Zariski topology has effective descent along a cover `𝒰` if and only
if it has effective descent along the single object cover `𝒰.sigma`. This is the stack
analogue of Mathlib's `Scheme.Cover.isSheafFor_sigma_iff`, without its finiteness
hypothesis. -/
lemma Scheme.Cover.isStackFor_sigma_iff {P : MorphismProperty Scheme.{u}}
    [IsZariskiLocalAtSource P] [UnivLE.{v, u}] {S : Scheme.{u}}
    (𝒰 : Scheme.Cover.{v} (Scheme.precoverage P) S) :
    F.IsStackFor (.ofArrows 𝒰.sigma.X 𝒰.sigma.f) ↔ F.IsStackFor (.ofArrows 𝒰.X 𝒰.f) := by
  change F.IsStackFor 𝒰.sigma.presieve₀ ↔ _
  rw [𝒰.presieve₀_sigma]
  exact isStackFor_singleton_sigmaDesc_iff 𝒰.f

end AlgebraicGeometry
