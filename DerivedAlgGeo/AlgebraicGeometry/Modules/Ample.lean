/-!
# The non-vanishing locus of a section and ample invertible sheaves

For an invertible sheaf `L` on a scheme `X` and a section `s` of `L` over an open `U`, the
non-vanishing locus `X_s` is the set of points `x ∈ U` at which the germ `s_x` generates the stalk
`L_x` (Stacks 01CY). It is open, it pulls back to the non-vanishing locus of the pulled-back section
(Stacks 0H78), and on the domain of a local basis `e` of `L` it is the basic open of the coefficient
of `s` against `e`.

`L` is ample (Stacks 01PS) when `X` is quasi-compact and every point lies in an affine
non-vanishing locus `X_s` of a global section `s` of some positive tensor power of `L`.

## Main definitions

* `AlgebraicGeometry.Scheme.Modules.germ`: the germ of a section in the module stalk.
* `AlgebraicGeometry.Scheme.Modules.IsLocalBasis`: a section that freely generates a module sheaf
  over an open.
* `AlgebraicGeometry.Scheme.Modules.nonvanishingLocus`: the open `X_s`.
* `AlgebraicGeometry.Scheme.Modules.tensorPow`, `tensorPowSection`: `L^{⊗ n}` and `s^{⊗ n}`.
* `AlgebraicGeometry.Scheme.Modules.IsAmple`: ampleness; `IsAmpleOn L U`, ampleness on an open.

## Main results

* `AlgebraicGeometry.Scheme.Modules.exists_isLocalBasis`: an invertible sheaf has a local basis
  around every point, so its stalks are free of rank one.
* `AlgebraicGeometry.Scheme.Modules.nonvanishingLocus_pullbackSection`: `f⁻¹(X_s) = Y_{f^* s}`
  (Stacks 0H78); `nonvanishingLocus_tmulSection`, `nonvanishingLocus_smul`: `X_{s ⊗ t} = X_s ∩ X_t`
  and `X_{a • s} = D(a) ∩ X_s`.
* `AlgebraicGeometry.Scheme.Modules.isLocalBasis_of_le_nonvanishingLocus`: a section freely
  generates `L` on its non-vanishing locus.
* `AlgebraicGeometry.Scheme.Modules.isAmple_tensorPow_iff`: `L^{⊗ n}` is ample if and only if `L`
  is, for `n ≥ 1` (Stacks 01PT).
* `AlgebraicGeometry.Scheme.Modules.IsAmple.pullback`, `IsAmple.pullback_of_isClosedImmersion`:
  ampleness pulls back along affine morphisms, in particular to closed subschemes (Stacks 01PU).
* `AlgebraicGeometry.Scheme.Modules.isAmple_restrict_iff`: ampleness of the restriction to an open
  subscheme is ampleness on the open.
* `AlgebraicGeometry.Scheme.Modules.exists_pow_smul_eq_res`: on a quasi-compact quasi-separated
  open, `aⁿ σ` extends from `D(a)` (Stacks 01PW), so ampleness is local for basic opens
  (`isAmpleOn_of_forall_isAmpleOn_basicOpen`).
* `AlgebraicGeometry.Scheme.Modules.IsAmple.isSeparated`: a scheme with an ample invertible sheaf
  is separated (Stacks 09MP).

## Implementation notes

`X_s` is defined through stalks, as "`s_x` generates `L_x`", not through a trivialization, so it
depends on no choice. Openness is the comparison with the basic open on the domain of a local
basis. A local basis is extracted from the intrinsic rank-one trivializations of
`SheafOfModules.IsInvertible`; the stalks of an invertible sheaf are then free of rank one, and
every statement about generation reduces to the units of a local ring.

The spec's `X_s` for a global section is the case `U = ⊤`. Sections over an open `U` are what the
relative notions restrict to: `IsAmpleOn L U` states ampleness of `L|_U` without leaving `X`.

## References

* [Stacks, Lemma 17.25.10 (Tag 01CY)](https://stacks.math.columbia.edu/tag/01CY).
* [Stacks, Remark 17.25.11 (Tag 0H78)](https://stacks.math.columbia.edu/tag/0H78).
* [Stacks, Lemma 28.18.2 (Tag 01PW)](https://stacks.math.columbia.edu/tag/01PW).
* [Stacks, Section 28.27 (Tag 01PR)](https://stacks.math.columbia.edu/tag/01PR).

## Tags

invertible sheaf, non-vanishing locus, ample, stalk
-/

universe u

open CategoryTheory Opposite TopologicalSpace MonoidalCategory
open scoped ChangeOfRings

namespace AlgebraicGeometry.Scheme.Modules

noncomputable section

variable {X : Scheme.{u}}

/-! ## Rank-one modules -/

section RankOne

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- In a module freely generated by `e`, a multiple `c • e` generates exactly when `c` is a
unit. -/
theorem span_smul_eq_top_iff_isUnit {e : M}
    (he : Function.Bijective (LinearMap.toSpanSingleton R M e)) (c : R) :
    Submodule.span R {c • e} = ⊤ ↔ IsUnit c := by
  refine ⟨fun h ↦ ?_, fun hc ↦ ?_⟩
  · obtain ⟨b, hb⟩ := Submodule.mem_span_singleton.1 (h ▸ Submodule.mem_top : e ∈ _)
    refine IsUnit.of_mul_eq_one b (he.1 ?_)
    simp only [LinearMap.toSpanSingleton_apply, one_smul]
    rw [mul_comm, mul_smul, hb]
  · obtain ⟨b, hb⟩ := hc.exists_left_inv
    rw [eq_top_iff]
    rintro m -
    obtain ⟨a, rfl⟩ := he.2 m
    refine Submodule.mem_span_singleton.2 ⟨a * b, ?_⟩
    simp only [LinearMap.toSpanSingleton_apply, mul_smul, ← mul_smul b, hb, one_smul]

/-- In a module freely generated by `e`, an element generates exactly when its coefficient against
`e` is a unit. -/
theorem span_singleton_eq_top_iff_isUnit {e : M}
    (he : Function.Bijective (LinearMap.toSpanSingleton R M e)) (m : M) :
    Submodule.span R {m} = ⊤ ↔
      IsUnit ((LinearEquiv.ofBijective (LinearMap.toSpanSingleton R M e) he).symm m) := by
  conv_lhs => rw [← (LinearEquiv.ofBijective _ he).apply_symm_apply m]
  exact span_smul_eq_top_iff_isUnit he _

/-- Rescaling a generator by `c` keeps it a generator exactly when `c` is a unit. -/
theorem span_smul_eq_top_iff {e : M}
    (he : Function.Bijective (LinearMap.toSpanSingleton R M e)) (c : R) (m : M) :
    Submodule.span R {c • m} = ⊤ ↔ IsUnit c ∧ Submodule.span R {m} = ⊤ := by
  obtain ⟨a, rfl⟩ := he.2 m
  simp only [LinearMap.toSpanSingleton_apply, smul_smul, span_smul_eq_top_iff_isUnit he,
    IsUnit.mul_iff]

/-- In a module freely generated by `e`, every generator is a free generator. -/
theorem bijective_toSpanSingleton_of_span_eq_top {e : M}
    (he : Function.Bijective (LinearMap.toSpanSingleton R M e)) {m : M}
    (hm : Submodule.span R {m} = ⊤) : Function.Bijective (LinearMap.toSpanSingleton R M m) := by
  obtain ⟨c, rfl⟩ := he.2 m
  have hc := (span_smul_eq_top_iff_isUnit he c).1 hm
  have h : ⇑(LinearMap.toSpanSingleton R M (LinearMap.toSpanSingleton R M e c)) =
      ⇑(LinearMap.toSpanSingleton R M e) ∘ (fun a ↦ a * c) := by
    funext a
    simp [mul_smul]
  rw [h]
  exact he.comp ⟨fun a b hab ↦ hc.mul_left_injective hab,
    fun b ↦ ⟨b * ↑hc.unit⁻¹, by
      change b * ↑hc.unit⁻¹ * c = b
      rw [mul_assoc, IsUnit.val_inv_mul, mul_one]⟩⟩

/-- An isomorphism carries generators to generators. -/
theorem span_singleton_map_equiv_eq_top_iff {N : Type*} [AddCommGroup N] [Module R N]
    (E : M ≃ₗ[R] N) (m : M) : Submodule.span R {E m} = ⊤ ↔ Submodule.span R {m} = ⊤ := by
  simp only [Submodule.span_singleton_eq_top_iff]
  refine ⟨fun h v ↦ ?_, fun h w ↦ ?_⟩
  · obtain ⟨r, hr⟩ := h (E v)
    exact ⟨r, E.injective (by rw [E.map_smul, hr])⟩
  · obtain ⟨r, hr⟩ := h (E.symm w)
    exact ⟨r, by rw [← E.map_smul, hr, E.apply_symm_apply]⟩

/-- The tensor product of free generators is a free generator. -/
theorem bijective_toSpanSingleton_tmul {N : Type*} [AddCommGroup N] [Module R N] {e : M} {e' : N}
    (he : Function.Bijective (LinearMap.toSpanSingleton R M e))
    (he' : Function.Bijective (LinearMap.toSpanSingleton R N e')) :
    Function.Bijective (LinearMap.toSpanSingleton R (TensorProduct R M N) (e ⊗ₜ e')) := by
  let E := LinearEquiv.ofBijective _ he
  let E' := LinearEquiv.ofBijective _ he'
  have h : ⇑(LinearMap.toSpanSingleton R (TensorProduct R M N) (e ⊗ₜ e')) =
      (TensorProduct.congr E E') ∘ (TensorProduct.lid R R).symm := by
    funext r
    simp [E, E', TensorProduct.smul_tmul']
  rw [h]
  exact (TensorProduct.congr E E').bijective.comp (TensorProduct.lid R R).symm.bijective

/-- A pure tensor of elements of free rank-one modules generates exactly when both factors
do. -/
theorem span_tmul_eq_top_iff {N : Type*} [AddCommGroup N] [Module R N] {e : M} {e' : N}
    (he : Function.Bijective (LinearMap.toSpanSingleton R M e))
    (he' : Function.Bijective (LinearMap.toSpanSingleton R N e')) (m : M) (n : N) :
    Submodule.span R {m ⊗ₜ[R] n} = ⊤ ↔
      Submodule.span R {m} = ⊤ ∧ Submodule.span R {n} = ⊤ := by
  obtain ⟨c, rfl⟩ := he.2 m
  obtain ⟨d, rfl⟩ := he'.2 n
  simp only [LinearMap.toSpanSingleton_apply, TensorProduct.smul_tmul_smul,
    span_smul_eq_top_iff_isUnit (bijective_toSpanSingleton_tmul he he'),
    span_smul_eq_top_iff_isUnit he, span_smul_eq_top_iff_isUnit he', IsUnit.mul_iff]

end RankOne

set_option backward.isDefEq.respectTransparency false in
/-- Scalars of `R` move across the base-change tensor through `f`. -/
theorem extendScalars_tmul_smul {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S)
    {N : ModuleCat.{u} R} (s : S) (c : R) (n : N) :
    s ⊗ₜ[R,f] (c • n) = (s * f c) • ((1 : S) ⊗ₜ[R,f] n : (ModuleCat.extendScalars f).obj N) := by
  let _ : Module R S := Module.compHom S f
  rw [ModuleCat.ExtendScalars.smul_tmul, mul_one, ← TensorProduct.smul_tmul, mul_comm]
  rfl

set_option backward.isDefEq.respectTransparency false in
/-- Extension of scalars keeps a free generator free. -/
theorem bijective_toSpanSingleton_extendScalars {R S : Type u} [CommRing R] [CommRing S]
    (f : R →+* S) {N : ModuleCat.{u} R} {e : N}
    (he : Function.Bijective (LinearMap.toSpanSingleton R N e)) :
    Function.Bijective (LinearMap.toSpanSingleton S ((ModuleCat.extendScalars f).obj N)
      ((1 : S) ⊗ₜ[R,f] e)) := by
  let _ : Module R S := Module.compHom S f
  let E := LinearEquiv.ofBijective _ he
  have hE : ∀ n : N, n = (E.symm n) • e := fun n ↦ (E.apply_symm_apply n).symm
  have htmul : ∀ (s : S) (c : R), s ⊗ₜ[R,f] (c • e) =
      (s * f c) • ((1 : S) ⊗ₜ[R,f] e : (ModuleCat.extendScalars f).obj N) :=
    fun s c ↦ extendScalars_tmul_smul f s c e
  refine ⟨(injective_iff_map_eq_zero _).2 fun s hs ↦ ?_, fun p ↦ ?_⟩
  · let F := (ModuleCat.extendScalars f).map (ModuleCat.ofHom (E.symm.toLinearMap :
      N →ₗ[R] R) : N ⟶ ModuleCat.of R R)
    have h1 : TensorProduct.rid R S (F ((LinearMap.toSpanSingleton S _ ((1 : S) ⊗ₜ[R,f] e)) s))
        = s := by
      rw [LinearMap.toSpanSingleton_apply, ModuleCat.ExtendScalars.smul_tmul, mul_one,
        ModuleCat.ExtendScalars.map_tmul]
      change TensorProduct.rid R S (s ⊗ₜ[R] E.symm e) = s
      rw [show E.symm e = 1 from E.symm_apply_eq.2 (by simp [E]), TensorProduct.rid_tmul,
        one_smul]
    refine h1.symm.trans ?_
    erw [hs]
    simp
  · induction p using TensorProduct.inductionOn with
    | tmul s n =>
      exact ⟨(show S from s) * f (E.symm n), by rw [LinearMap.toSpanSingleton_apply, ← htmul, ← hE]⟩
    | add p q hp hq =>
      obtain ⟨a, ha⟩ := hp
      obtain ⟨b, hb⟩ := hq
      exact ⟨a + b, by rw [map_add, ha, hb]⟩

/-- For a local homomorphism `f` and a free generator `e`, the element `1 ⊗ m` generates the
extension of scalars exactly when `m` generates. -/
theorem span_one_tmul_eq_top_iff {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S)
    [IsLocalHom f] {N : ModuleCat.{u} R} {e : N}
    (he : Function.Bijective (LinearMap.toSpanSingleton R N e)) (m : N) :
    Submodule.span S ({(1 : S) ⊗ₜ[R,f] m} : Set ((ModuleCat.extendScalars f).obj N)) = ⊤ ↔
      Submodule.span R {m} = ⊤ := by
  obtain ⟨c, rfl⟩ := he.2 m
  rw [LinearMap.toSpanSingleton_apply]
  erw [extendScalars_tmul_smul f 1 c e]
  rw [one_mul]
  exact ((span_smul_eq_top_iff_isUnit (bijective_toSpanSingleton_extendScalars f he) (f c)).trans
    (isUnit_map_iff f c)).trans (span_smul_eq_top_iff_isUnit he c).symm

/-! ## Germs in module stalks -/

/-- The germ at `x` of a section of `M`, as an element of the module stalk over the local ring. -/
def germ (M : X.Modules) {U : X.Opens} (x : X) (hx : x ∈ U) (s : Γ(M, U)) :
    (moduleStalkFunctor X x).obj M :=
  TopCat.Presheaf.germ M.presheaf U x hx s

/-- Taking germs is linear over the germs of functions. -/
theorem germ_smul (M : X.Modules) {U : X.Opens} (x : X) (hx : x ∈ U) (r : Γ(X, U))
    (s : Γ(M, U)) : germ M x hx (r • s) = X.presheaf.germ U x hx r • germ M x hx s := by
  let e := PresheafOfModules.commStalkLinearEquiv X X.presheaf x ((toPresheafOfModules X).obj M)
  apply e.injective
  exact (PresheafOfModules.germ_smul (M := (toPresheafOfModules X).obj M) x U hx r s).trans
    (e.map_smul (X.presheaf.germ U x hx r) (germ M x hx s)).symm

/-- Taking germs is additive. -/
theorem germ_add (M : X.Modules) {U : X.Opens} (x : X) (hx : x ∈ U) (s t : Γ(M, U)) :
    germ M x hx (s + t) = germ M x hx s + germ M x hx t :=
  map_add _ _ _

/-- The germ of zero is zero. -/
theorem germ_zero (M : X.Modules) {U : X.Opens} (x : X) (hx : x ∈ U) :
    germ M x hx 0 = 0 :=
  map_zero _

/-- The germ of a restriction is the germ of the section. -/
theorem germ_res (M : X.Modules) {U V : X.Opens} (h : V ≤ U) (x : X) (hx : x ∈ V)
    (s : Γ(M, U)) : germ M x hx (M.presheaf.map (homOfLE h).op s) = germ M x (h hx) s :=
  TopCat.Presheaf.germ_res_apply M.presheaf (homOfLE h) x hx s

/-- Every element of a module stalk is a germ. -/
theorem exists_germ_eq (M : X.Modules) (x : X) (m : (moduleStalkFunctor X x).obj M) :
    ∃ (U : X.Opens) (hx : x ∈ U) (s : Γ(M, U)), germ M x hx s = m :=
  TopCat.Presheaf.exists_germ_eq M.presheaf m

/-- Two sections with the same germ agree near the point. -/
theorem exists_res_eq_of_germ_eq (M : X.Modules) {U V : X.Opens} (x : X) (hU : x ∈ U)
    (hV : x ∈ V) (s : Γ(M, U)) (t : Γ(M, V)) (h : germ M x hU s = germ M x hV t) :
    ∃ (W : X.Opens) (_ : x ∈ W) (iU : W ≤ U) (iV : W ≤ V),
      M.presheaf.map (homOfLE iU).op s = M.presheaf.map (homOfLE iV).op t := by
  obtain ⟨W, hW, iU, iV, h⟩ := TopCat.Presheaf.germ_eq M.presheaf x hU hV s t h
  exact ⟨W, hW, leOfHom iU, leOfHom iV, h⟩

/-- A morphism of module sheaves acts on germs through its sections. -/
theorem germ_app {M N : X.Modules} (φ : M ⟶ N) {U : X.Opens} (x : X) (hx : x ∈ U)
    (s : Γ(M, U)) : germ N x hx (φ.app U s) = (moduleStalkFunctor X x).map φ (germ M x hx s) :=
  (moduleStalkFunctor_map_germ x φ U hx s).symm

/-- Sections with the same germs everywhere are equal. -/
theorem section_ext (M : X.Modules) {U : X.Opens} {s t : Γ(M, U)}
    (h : ∀ x (hx : x ∈ U), germ M x hx s = germ M x hx t) : s = t :=
  TopCat.Presheaf.section_ext ⟨M.presheaf, M.isSheaf⟩ U s t h

/-! ## Local bases -/

/-- `e` freely generates `M` over `U`: on every open `V ≤ U`, every section of `M` is uniquely a
multiple of the restriction of `e`. -/
def IsLocalBasis (M : X.Modules) (U : X.Opens) (e : Γ(M, U)) : Prop :=
  ∀ ⦃V : X.Opens⦄ (h : V ≤ U),
    Function.Bijective (LinearMap.toSpanSingleton Γ(X, V) Γ(M, V) (M.presheaf.map (homOfLE h).op e))

namespace IsLocalBasis

variable {M : X.Modules} {U : X.Opens} {e : Γ(M, U)}

/-- A local basis restricts to a local basis. -/
theorem res (he : IsLocalBasis M U e) {V : X.Opens} (h : V ≤ U) :
    IsLocalBasis M V (M.presheaf.map (homOfLE h).op e) := by
  intro W hW
  rw [resSection_trans]
  exact he (hW.trans h)

/-- The coefficient of a section against a local basis. -/
def coeff (he : IsLocalBasis M U e) (s : Γ(M, U)) : Γ(X, U) :=
  (LinearEquiv.ofBijective _ (by simpa using he le_rfl)).symm s

/-- A section is its coefficient times the local basis. -/
theorem coeff_smul (he : IsLocalBasis M U e) (s : Γ(M, U)) : he.coeff s • e = s := by
  have h := (LinearEquiv.ofBijective _ (by simpa using he le_rfl)).apply_symm_apply s
  exact h

/-- Multiples of a local basis over its domain are determined by their coefficients. -/
theorem smul_left_injective (he : IsLocalBasis M U e) {a b : Γ(X, U)} (h : a • e = b • e) :
    a = b :=
  (show Function.Injective (LinearMap.toSpanSingleton Γ(X, U) Γ(M, U) e) by
    simpa using (he le_rfl).1) h

/-- A local basis freely generates the stalk at every point of its domain. -/
theorem bijective_stalk (he : IsLocalBasis M U e) {x : X} (hx : x ∈ U) :
    Function.Bijective (LinearMap.toSpanSingleton (X.presheaf.stalk x)
      ((moduleStalkFunctor X x).obj M) (germ M x hx e)) := by
  refine ⟨(injective_iff_map_eq_zero _).2 fun a ha ↦ ?_, fun m ↦ ?_⟩
  · obtain ⟨V, hV, a, rfl⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf a
    have hVU : x ∈ V ⊓ U := ⟨hV, hx⟩
    rw [LinearMap.toSpanSingleton_apply, ← germ_res M (inf_le_right : V ⊓ U ≤ U) x hVU,
      ← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (inf_le_left : V ⊓ U ≤ V)) x hVU,
      ← germ_smul, ← germ_zero M x hVU] at ha
    obtain ⟨W, hW, iU, _, hW'⟩ := exists_res_eq_of_germ_eq M x hVU hVU _ _ ha
    rw [map_zero, map_smul, resSection_trans] at hW'
    have h0 := (he (iU.trans inf_le_right)).1 (a₂ := 0)
      (by simpa [LinearMap.toSpanSingleton_apply, resSection_trans] using hW')
    rw [← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (inf_le_left : V ⊓ U ≤ V)) x hVU,
      ← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE iU) x hW, h0, map_zero]
  · obtain ⟨V, hV, s, rfl⟩ := exists_germ_eq M x m
    have hVU : x ∈ V ⊓ U := ⟨hV, hx⟩
    obtain ⟨a, ha⟩ := (he (inf_le_right : V ⊓ U ≤ U)).2
      (M.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op s)
    refine ⟨X.presheaf.germ _ x hVU a, ?_⟩
    rw [LinearMap.toSpanSingleton_apply, ← germ_res M (inf_le_right : V ⊓ U ≤ U) x hVU,
      ← germ_smul, ← germ_res M (inf_le_left : V ⊓ U ≤ V) x hVU]
    exact congrArg _ ha

end IsLocalBasis

set_option backward.isDefEq.respectTransparency false in
/-- **An invertible sheaf has a local basis around every point**: the image of `1` under a
rank-one trivialization. -/
theorem exists_isLocalBasis (L : X.Modules)
    [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from L)] (x : X) :
    ∃ (U : X.Opens) (_ : x ∈ U) (e : Γ(L, U)), IsLocalBasis L U e := by
  obtain ⟨q, hq, hrank⟩ :=
    SheafOfModules.IsInvertible.exists_rankOneData (M := show SheafOfModules X.ringCatSheaf from L)
  have := hq
  obtain ⟨i, hi⟩ : ∃ i, x ∈ q.X i := ((Opens.coversTop_iff _ q.X).1 q.coversTop).exists_mem x
  let φ := q.rankOneTrivialization hrank i
  let ψ : ∀ (V : X.Opens) (hV : V ≤ q.X i), Γ(X, V) →ₗ[Γ(X, V)] Γ(L, V) := fun V hV ↦
    (φ.hom.val.app (op (Over.mk (homOfLE hV)))).hom
  have hψ : ∀ (V : X.Opens) (hV : V ≤ q.X i), Function.Bijective (ψ V hV) := fun V hV ↦
    ((SheafOfModules.forget _ ⋙
      PresheafOfModules.evaluation _ (op (Over.mk (homOfLE hV)))).mapIso φ).toLinearEquiv.bijective
  refine ⟨q.X i, hi, ψ (q.X i) le_rfl 1, fun V hV ↦ ?_⟩
  have key : LinearMap.toSpanSingleton Γ(X, V) Γ(L, V)
      (L.presheaf.map (homOfLE hV).op (ψ (q.X i) le_rfl 1)) = ψ V hV := by
    refine LinearMap.ext fun a ↦ ?_
    have h1 : ψ V hV (X.presheaf.map (homOfLE hV).op 1) =
        L.presheaf.map (homOfLE hV).op (ψ (q.X i) le_rfl 1) :=
      PresheafOfModules.naturality_apply φ.hom.val
        (Over.homMk (homOfLE hV) : Over.mk (homOfLE hV) ⟶
          Over.mk (homOfLE (le_refl (q.X i)))).op (1 : Γ(X, q.X i))
    rw [map_one] at h1
    rw [LinearMap.toSpanSingleton_apply, ← h1, ← (ψ V hV).map_smul, smul_eq_mul, mul_one]
  rw [key]
  exact hψ V hV

/-! ## The non-vanishing locus -/

section NonvanishingLocus

variable (L : X.Modules)

/-- On the domain of a local basis `e`, a section `a • e` generates the stalk at `x` exactly
when `x` lies in the basic open of `a`. -/
theorem span_germ_eq_top_iff_mem_basicOpen {U : X.Opens} {e : Γ(L, U)} (he : IsLocalBasis L U e)
    (a : Γ(X, U)) {x : X} (hx : x ∈ U) :
    Submodule.span (X.presheaf.stalk x) {germ L x hx (a • e)} = ⊤ ↔ x ∈ X.basicOpen a := by
  rw [germ_smul, span_smul_eq_top_iff_isUnit (he.bijective_stalk hx)]
  exact (X.mem_basicOpen a x hx).symm

/-- On the domain of a local basis, the stalks of a section generate exactly on a basic open. -/
theorem span_germ_eq_top_iff_mem_basicOpen_coeff {U : X.Opens} {e : Γ(L, U)}
    (he : IsLocalBasis L U e) (s : Γ(L, U)) {x : X} (hx : x ∈ U) :
    Submodule.span (X.presheaf.stalk x) {germ L x hx s} = ⊤ ↔ x ∈ X.basicOpen (he.coeff s) := by
  conv_lhs => rw [← he.coeff_smul s]
  exact span_germ_eq_top_iff_mem_basicOpen L he _ hx

variable [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from L)]

/-- **The non-vanishing locus** `X_s` of a section `s` of an invertible sheaf over an open `U`
(Stacks 01CY): the points of `U` at which the germ of `s` generates the stalk. It is open because
on the domain of a local basis it is a basic open. For a global section this is Stacks' `X_s`. -/
def nonvanishingLocus {U : X.Opens} (s : Γ(L, U)) : X.Opens where
  carrier := {x | ∃ hx : x ∈ U, Submodule.span (X.presheaf.stalk x) {germ L x hx s} = ⊤}
  is_open' := by
    refine isOpen_iff_forall_mem_open.2 fun x ⟨hxU, hx⟩ ↦ ?_
    obtain ⟨W, hxW, e, he⟩ := exists_isLocalBasis L x
    have he' := he.res (inf_le_left : W ⊓ U ≤ W)
    let t := L.presheaf.map (homOfLE (inf_le_right : W ⊓ U ≤ U)).op s
    refine ⟨X.basicOpen (he'.coeff t), fun y hy ↦ ?_, (X.basicOpen _).isOpen, ?_⟩
    · have hyV : y ∈ W ⊓ U := X.basicOpen_le _ hy
      refine ⟨hyV.2, ?_⟩
      rw [← germ_res L inf_le_right y hyV, span_germ_eq_top_iff_mem_basicOpen_coeff L he' t hyV]
      exact hy
    · refine (span_germ_eq_top_iff_mem_basicOpen_coeff L he' t
        (show x ∈ W ⊓ U from ⟨hxW, hxU⟩)).1 ?_
      rw [germ_res]
      exact hx

variable {L}

/-- A point of `U` lies in `X_s` exactly when the germ of `s` there generates the stalk. -/
theorem mem_nonvanishingLocus_iff {U : X.Opens} {s : Γ(L, U)} {x : X} (hx : x ∈ U) :
    x ∈ nonvanishingLocus L s ↔ Submodule.span (X.presheaf.stalk x) {germ L x hx s} = ⊤ :=
  ⟨fun ⟨_, h⟩ ↦ h, fun h ↦ ⟨hx, h⟩⟩

/-- The non-vanishing locus of a section over `U` lies in `U`. -/
theorem nonvanishingLocus_le {U : X.Opens} (s : Γ(L, U)) : nonvanishingLocus L s ≤ U :=
  fun _ ⟨hx, _⟩ ↦ hx

/-- On the domain of a local basis `e`, the non-vanishing locus of `s` is the basic open of the
coefficient of `s` against `e`. -/
theorem nonvanishingLocus_eq_basicOpen {U : X.Opens} {e : Γ(L, U)} (he : IsLocalBasis L U e)
    (s : Γ(L, U)) : nonvanishingLocus L s = X.basicOpen (he.coeff s) := by
  ext x
  refine ⟨fun ⟨hxU, hx⟩ ↦ (span_germ_eq_top_iff_mem_basicOpen_coeff L he s hxU).1 hx,
    fun hx ↦ ?_⟩
  have hxU : x ∈ U := X.basicOpen_le _ hx
  exact ⟨hxU, (span_germ_eq_top_iff_mem_basicOpen_coeff L he s hxU).2 hx⟩

/-- Restricting a section intersects its non-vanishing locus with the smaller open. -/
theorem nonvanishingLocus_res {U V : X.Opens} (h : V ≤ U) (s : Γ(L, U)) :
    nonvanishingLocus L (L.presheaf.map (homOfLE h).op s) = nonvanishingLocus L s ⊓ V := by
  ext x
  refine ⟨fun ⟨hxV, hx⟩ ↦ ⟨⟨h hxV, ?_⟩, hxV⟩, fun ⟨⟨_, hx⟩, hxV⟩ ↦ ⟨hxV, ?_⟩⟩
  · rwa [germ_res] at hx
  · rwa [germ_res]

/-- Restricting along an equality of opens does not change the non-vanishing locus. -/
theorem nonvanishingLocus_map_eqToHom {U V : X.Opens} (h : V = U) (s : Γ(L, U)) :
    nonvanishingLocus L (L.presheaf.map (eqToHom h).op s) = nonvanishingLocus L s := by
  subst h
  simp

/-- The stalks of an invertible sheaf are free of rank one. -/
theorem exists_bijective_stalk (L : X.Modules)
    [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from L)] (x : X) :
    ∃ e : (moduleStalkFunctor X x).obj L,
      Function.Bijective (LinearMap.toSpanSingleton (X.presheaf.stalk x)
        ((moduleStalkFunctor X x).obj L) e) := by
  obtain ⟨U, hxU, e, he⟩ := exists_isLocalBasis L x
  exact ⟨_, he.bijective_stalk hxU⟩

/-- Multiplying by a function cuts the non-vanishing locus down by its basic open. -/
theorem nonvanishingLocus_smul {U : X.Opens} (a : Γ(X, U)) (s : Γ(L, U)) :
    nonvanishingLocus L (a • s) = X.basicOpen a ⊓ nonvanishingLocus L s := by
  ext x
  refine ⟨fun ⟨hxU, hx⟩ ↦ ?_, fun ⟨ha, hxU, hx⟩ ↦ ⟨hxU, ?_⟩⟩
  · obtain ⟨e, he⟩ := exists_bijective_stalk L x
    rw [germ_smul, span_smul_eq_top_iff he] at hx
    exact ⟨(X.mem_basicOpen a x hxU).2 hx.1, hxU, hx.2⟩
  · obtain ⟨e, he⟩ := exists_bijective_stalk L x
    rw [germ_smul, span_smul_eq_top_iff he]
    exact ⟨(X.mem_basicOpen a x hxU).1 ha, hx⟩

/-- A local basis vanishes nowhere on its domain. -/
theorem IsLocalBasis.nonvanishingLocus_eq {U : X.Opens} {e : Γ(L, U)} (he : IsLocalBasis L U e) :
    nonvanishingLocus L e = U := by
  ext x
  refine ⟨fun ⟨hx, _⟩ ↦ hx, fun hx ↦ ⟨hx, ?_⟩⟩
  rw [← one_smul Γ(X, U) e, span_germ_eq_top_iff_mem_basicOpen L he 1 hx, X.basicOpen_of_isUnit
    isUnit_one]
  exact hx

variable (L) in
/-- **A section freely generates `L` on its non-vanishing locus**: on every open `V ⊆ X_e`, every
section of `L` is uniquely a multiple of `e`. -/
theorem isLocalBasis_of_le_nonvanishingLocus {U V : X.Opens} (e : Γ(L, U))
    (hV : V ≤ nonvanishingLocus L e) :
    IsLocalBasis L V (L.presheaf.map (homOfLE (hV.trans (nonvanishingLocus_le e))).op e) := by
  have hVU := hV.trans (nonvanishingLocus_le e)
  have hfree : ∀ {W : X.Opens} (hW : W ≤ V) {y : X} (hy : y ∈ W),
      Function.Bijective (LinearMap.toSpanSingleton (X.presheaf.stalk y)
        ((moduleStalkFunctor X y).obj L)
        (germ L y hy (L.presheaf.map (homOfLE (hW.trans hVU)).op e))) := by
    intro W hW y hy
    obtain ⟨f, hf⟩ := exists_bijective_stalk L y
    rw [germ_res]
    exact bijective_toSpanSingleton_of_span_eq_top hf
      ((mem_nonvanishingLocus_iff (hVU (hW hy))).1 (hV (hW hy)))
  have hext : ∀ {W : X.Opens} (a b : Γ(X, W)),
      (∀ y (hy : y ∈ W), X.presheaf.germ W y hy a = X.presheaf.germ W y hy b) → a = b :=
    fun a b h ↦ TopCat.Presheaf.section_ext X.sheaf _ a b h
  have hinj : ∀ {W : X.Opens} (hW : W ≤ V),
      Function.Injective (LinearMap.toSpanSingleton Γ(X, W) Γ(L, W)
        (L.presheaf.map (homOfLE (hW.trans hVU)).op e)) := by
    intro W hW
    refine (injective_iff_map_eq_zero _).2 fun a ha ↦ hext a 0 fun y hy ↦ (hfree hW hy).1 ?_
    rw [LinearMap.toSpanSingleton_apply] at ha
    simp only [LinearMap.toSpanSingleton_apply, map_zero]
    rw [← germ_smul, ha, germ_zero]
  intro W hW
  rw [resSection_trans]
  refine ⟨hinj (hW.trans le_rfl), fun m ↦ ?_⟩
  -- local multiples
  have hloc : ∀ y : W, ∃ (O : X.Opens) (_ : (y : X) ∈ O) (hO : O ≤ W) (a : Γ(X, O)),
      L.presheaf.map (homOfLE hO).op m =
        a • L.presheaf.map (homOfLE (hO.trans (hW.trans hVU))).op e := by
    intro ⟨y, hy⟩
    obtain ⟨c, hc⟩ := (hfree hW hy).2 (germ L y hy m)
    obtain ⟨O, hyO, c, rfl⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf c
    have hyOW : y ∈ O ⊓ W := ⟨hyO, hy⟩
    have hc' : germ L y hyOW (X.presheaf.map (homOfLE (inf_le_left : O ⊓ W ≤ O)).op c •
        L.presheaf.map (homOfLE ((inf_le_right : O ⊓ W ≤ W).trans (hW.trans hVU))).op e) =
          germ L y hy m := by
      rw [germ_smul, TopCat.Presheaf.germ_res_apply, germ_res, ← hc,
        LinearMap.toSpanSingleton_apply, germ_res]
    obtain ⟨O', hyO', i₁, i₂, h⟩ := exists_res_eq_of_germ_eq L y hyOW hy _ _ hc'
    refine ⟨O', hyO', i₂, X.presheaf.map (homOfLE i₁).op
      (X.presheaf.map (homOfLE (inf_le_left : O ⊓ W ≤ O)).op c), ?_⟩
    rw [← h, map_smul, resSection_trans]
  choose O hyO hO a ha using hloc
  have hcompat : TopCat.Presheaf.IsCompatible X.sheaf.1 O a := by
    intro y z
    apply hinj ((inf_le_left : O y ⊓ O z ≤ O y).trans ((hO y).trans hW))
    have h1 := congrArg (L.presheaf.map (homOfLE (inf_le_left : O y ⊓ O z ≤ O y)).op) (ha y)
    have h2 := congrArg (L.presheaf.map (homOfLE (inf_le_right : O y ⊓ O z ≤ O z)).op) (ha z)
    rw [resSection_trans, map_smul, resSection_trans] at h1 h2
    exact h1.symm.trans h2
  obtain ⟨g, hg, -⟩ := TopCat.Sheaf.existsUnique_gluing' X.sheaf O W (fun y ↦ homOfLE (hO y))
    (fun y hy ↦ Opens.mem_iSup.2 ⟨⟨y, hy⟩, hyO ⟨y, hy⟩⟩) a hcompat
  refine ⟨g, section_ext L fun y hy ↦ ?_⟩
  let g' : Γ(X, W) := g
  change germ L y hy (g' • L.presheaf.map (homOfLE (hW.trans hVU)).op e) = _
  calc germ L y hy (g' • L.presheaf.map (homOfLE (hW.trans hVU)).op e)
      = germ L y (hyO ⟨y, hy⟩) (L.presheaf.map (homOfLE (hO ⟨y, hy⟩)).op
          (g' • L.presheaf.map (homOfLE (hW.trans hVU)).op e)) :=
        (germ_res L (hO ⟨y, hy⟩) y (hyO ⟨y, hy⟩) _).symm
    _ = germ L y (hyO ⟨y, hy⟩) (X.presheaf.map (homOfLE (hO ⟨y, hy⟩)).op g' •
          L.presheaf.map (homOfLE ((hO ⟨y, hy⟩).trans (hW.trans hVU))).op e) := by
        rw [map_smul, resSection_trans]
    _ = germ L y (hyO ⟨y, hy⟩) (L.presheaf.map (homOfLE (hO ⟨y, hy⟩)).op m) := by
        rw [ha ⟨y, hy⟩, ← hg ⟨y, hy⟩]
        rfl
    _ = germ L y hy m := germ_res L (hO ⟨y, hy⟩) y (hyO ⟨y, hy⟩) m

end NonvanishingLocus

/-- The non-vanishing locus is invariant under isomorphisms of invertible sheaves. -/
theorem nonvanishingLocus_iso {L M : X.Modules}
    [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from L)]
    [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from M)]
    (φ : L ≅ M) {U : X.Opens} (s : Γ(L, U)) :
    nonvanishingLocus M (φ.hom.app U s) = nonvanishingLocus L s := by
  ext x
  refine ⟨fun ⟨hxU, hx⟩ ↦ ⟨hxU, ?_⟩, fun ⟨hxU, hx⟩ ↦ ⟨hxU, ?_⟩⟩
  · rw [germ_app] at hx
    exact (span_singleton_map_equiv_eq_top_iff
      ((moduleStalkFunctor X x).mapIso φ).toLinearEquiv _).1 hx
  · rw [germ_app]
    exact (span_singleton_map_equiv_eq_top_iff
      ((moduleStalkFunctor X x).mapIso φ).toLinearEquiv _).2 hx

/-! ## Pullback -/

section Pullback

variable {Y : Scheme.{u}} (f : Y ⟶ X) (L : X.Modules)

/-- The pullback `f^* s` of a section `s` of `L` over `U`, a section of `f^* L` over `f⁻¹ U`: the
adjunction unit applied to `s`. -/
def pullbackSection {U : X.Opens} (s : Γ(L, U)) : Γ((pullback f).obj L, f ⁻¹ᵁ U) :=
  ((pullbackPushforwardAdjunction f).unit.app L).app U s

variable [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from L)]

/-- The germ of `f^* s` at `y` generates exactly when the germ of `s` at `f y` does. -/
theorem span_germ_pullbackSection_eq_top_iff {U : X.Opens} (s : Γ(L, U)) {y : Y}
    (hy : f y ∈ U) :
    Submodule.span (Y.presheaf.stalk y)
        {germ ((pullback f).obj L) (U := f ⁻¹ᵁ U) y hy (pullbackSection f L s)} = ⊤ ↔
      Submodule.span (X.presheaf.stalk (f y)) {germ L (f y) hy s} = ⊤ := by
  obtain ⟨e, he⟩ := exists_bijective_stalk L (f y)
  rw [← span_singleton_map_equiv_eq_top_iff ((pullbackStalkIso f y).app L).toLinearEquiv]
  have h := pullbackStalkIso_hom_app_germ_unit f y L U hy s
  erw [h]
  exact span_one_tmul_eq_top_iff (f.stalkMap y).hom he _

/-- **Pullback of the non-vanishing locus** (Stacks 0H78): `f⁻¹(X_s) = Y_{f^* s}`. -/
theorem nonvanishingLocus_pullbackSection {U : X.Opens} (s : Γ(L, U)) :
    nonvanishingLocus ((pullback f).obj L) (pullbackSection f L s) =
      f ⁻¹ᵁ nonvanishingLocus L s := by
  ext y
  exact ⟨fun ⟨hy, h⟩ ↦ ⟨hy, (span_germ_pullbackSection_eq_top_iff f L s hy).1 h⟩,
    fun ⟨hy, h⟩ ↦ ⟨hy, (span_germ_pullbackSection_eq_top_iff f L s hy).2 h⟩⟩

end Pullback

/-! ## Tensor products and tensor powers -/

section Tensor

private noncomputable local instance : MonoidalCategory X.PresheafOfModules :=
  PresheafOfModulesOfCommRing.monoidalCategory (R := X.presheaf)

set_option backward.isDefEq.respectTransparency false in
/-- The stalk comparison `Lₓ ⊗ Mₓ ≅ (L ⊗ M)ₓ` sends a pure tensor of germs to the germ of the pure
tensor of sections. -/
theorem fixedLeftTensorStalkIso_hom_app_germ_tmul (L M : X.Modules) {U : X.Opens} (x : X)
    (hx : x ∈ U) (s : Γ(L, U)) (t : Γ(M, U)) :
    (fixedLeftTensorStalkIso X x L).hom.app M (germ L x hx s ⊗ₜ germ M x hx t) =
      germ (tensorObj L M) x hx (tmulSection L M (op U) s t) := by
  let P := (toPresheafOfModules X).obj L
  let Q := (toPresheafOfModules X).obj M
  let eP := PresheafOfModules.commStalkLinearEquiv X X.presheaf x P
  let eQ := PresheafOfModules.commStalkLinearEquiv X X.presheaf x Q
  let eA := PresheafOfModules.commStalkLinearEquiv X X.presheaf x (P ⊗ Q)
  let _ : RingHomInvPair (RingHom.id (X.presheaf.stalk x))
      (RingHom.id (X.presheaf.stalk x)) := RingHomInvPair.ids
  change (presheafModuleStalkSheafificationIso X x).hom.app (P ⊗ Q)
    (eA.symm (PresheafOfModules.stalkTensorEquiv (R := X.presheaf) P Q x
      (TensorProduct.congr (σ₂₁ := RingHom.id _) eP eQ (germ L x hx s ⊗ₜ germ M x hx t)))) = _
  rw [TensorProduct.congr_tmul]
  erw [PresheafOfModules.stalkTensorEquiv_germ_tmul_germ, PresheafOfModules.germTmul_self]
  exact presheafModuleStalkFunctor_map_germ x _ U hx _

variable (L M : X.Modules)
  [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from L)]
  [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from M)]

/-- The germ of a pure tensor of sections generates exactly when both germs do. -/
theorem span_germ_tmulSection_eq_top_iff {U : X.Opens} (s : Γ(L, U)) (t : Γ(M, U)) {x : X}
    (hx : x ∈ U) :
    Submodule.span (X.presheaf.stalk x) {germ (tensorObj L M) x hx (tmulSection L M (op U) s t)} =
        ⊤ ↔
      Submodule.span (X.presheaf.stalk x) {germ L x hx s} = ⊤ ∧
        Submodule.span (X.presheaf.stalk x) {germ M x hx t} = ⊤ := by
  obtain ⟨e, he⟩ := exists_bijective_stalk L x
  obtain ⟨e', he'⟩ := exists_bijective_stalk M x
  rw [← fixedLeftTensorStalkIso_hom_app_germ_tmul]
  exact (span_singleton_map_equiv_eq_top_iff ((fixedLeftTensorStalkIso X x L).app M).toLinearEquiv
    _).trans (span_tmul_eq_top_iff he he' _ _)

/-- The non-vanishing locus of a pure tensor is the intersection of the non-vanishing loci. -/
theorem nonvanishingLocus_tmulSection {U : X.Opens} (s : Γ(L, U)) (t : Γ(M, U)) :
    nonvanishingLocus (tensorObj L M) (tmulSection L M (op U) s t) =
      nonvanishingLocus L s ⊓ nonvanishingLocus M t := by
  ext x
  refine ⟨fun ⟨hxU, hx⟩ ↦ ?_, fun ⟨⟨hxU, hs⟩, ⟨_, ht⟩⟩ ↦
    ⟨hxU, (span_germ_tmulSection_eq_top_iff L M s t hxU).2 ⟨hs, ht⟩⟩⟩
  obtain ⟨hs, ht⟩ := (span_germ_tmulSection_eq_top_iff L M s t hxU).1 hx
  exact ⟨⟨hxU, hs⟩, ⟨hxU, ht⟩⟩

end Tensor

/-- The structure sheaf is invertible, as an instance on scheme-module sheaves. -/
instance isInvertible_unit :
    SheafOfModules.IsInvertible.{u, u, u}
      (show SheafOfModules X.ringCatSheaf from SheafOfModules.unit X.ringCatSheaf) :=
  SheafOfModules.instIsInvertibleUnit.{u, u, u}

/-- The `n`-fold tensor power `L^{⊗ n}`, with `L^{⊗ 0} = 𝒪_X`. -/
def tensorPow (L : X.Modules) : ℕ → X.Modules
  | 0 => SheafOfModules.unit X.ringCatSheaf
  | n + 1 => tensorObj (tensorPow L n) L

/-- `L^{⊗ 0}` is the structure sheaf. -/
@[simp] theorem tensorPow_zero (L : X.Modules) :
    tensorPow L 0 = SheafOfModules.unit X.ringCatSheaf := rfl

/-- `L^{⊗ (n + 1)} = L^{⊗ n} ⊗ L`. -/
@[simp] theorem tensorPow_succ (L : X.Modules) (n : ℕ) :
    tensorPow L (n + 1) = tensorObj (tensorPow L n) L := rfl

/-- Tensor powers of an invertible sheaf are invertible. -/
instance isInvertible_tensorPow (L : X.Modules)
    [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from L)] (n : ℕ) :
    SheafOfModules.IsInvertible.{u, u, u}
      (show SheafOfModules X.ringCatSheaf from tensorPow L n) := by
  induction n with
  | zero => exact isInvertible_unit
  | succ n ih => exact isInvertible_tensorObj _ _

/-- The Picard class of `L^{⊗ n}` is the `n`-th power of the class of `L`. This identifies
`tensorPow` with any chosen representative of the power of the class, such as
`IntersectionTheory.Snapper.linePower`. -/
theorem PicardClass.mk_tensorPow (L : X.Modules)
    [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from L)] (n : ℕ) :
    PicardClass.mk (tensorPow L n) = PicardClass.mk L ^ n := by
  induction n with
  | zero => exact PicardClass.one_eq_one X
  | succ n ih => rw [pow_succ, ← ih, PicardClass.mk_mul_mk]; rfl

/-- Tensor powers of isomorphic sheaves are isomorphic. -/
def tensorPowIso {L M : X.Modules} (φ : L ≅ M) : (n : ℕ) → tensorPow L n ≅ tensorPow M n
  | 0 => Iso.refl _
  | n + 1 => tensorObjIso (tensorPowIso φ n) φ

/-- `L^{⊗ (m + n)} ≅ L^{⊗ m} ⊗ L^{⊗ n}`. -/
def tensorPowAddIso (L : X.Modules) (m : ℕ) :
    (n : ℕ) → tensorPow L (m + n) ≅ tensorObj (tensorPow L m) (tensorPow L n)
  | 0 => (tensorUnitRightIso _).symm
  | n + 1 => tensorObjIso (tensorPowAddIso L m n) (Iso.refl L) ≪≫ tensorAssocIso _ _ _

/-- `(L^{⊗ m})^{⊗ n} ≅ L^{⊗ (m n)}`. -/
def tensorPowMulIso (L : X.Modules) (m : ℕ) :
    (n : ℕ) → tensorPow (tensorPow L m) n ≅ tensorPow L (m * n)
  | 0 => Iso.refl _
  | n + 1 => tensorObjIso (tensorPowMulIso L m n) (Iso.refl _) ≪≫ (tensorPowAddIso L (m * n) m).symm

/-- `(L^{⊗ m})^{⊗ n} ≅ (L^{⊗ n})^{⊗ m}`. -/
def tensorPowCommIso (L : X.Modules) (m n : ℕ) :
    tensorPow (tensorPow L m) n ≅ tensorPow (tensorPow L n) m :=
  tensorPowMulIso L m n ≪≫ eqToIso (by rw [Nat.mul_comm]) ≪≫ (tensorPowMulIso L n m).symm

/-- Pullback commutes with tensor powers. -/
def pullbackTensorPowIso {Y : Scheme.{u}} (f : Y ⟶ X) (L : X.Modules) :
    (n : ℕ) → (pullback f).obj (tensorPow L n) ≅ tensorPow ((pullback f).obj L) n
  | 0 => pullbackUnitIso f
  | n + 1 =>
    (pullbackTensorIso f _ _).symm ≪≫ tensorObjIso (pullbackTensorPowIso f L n) (Iso.refl _)

section TensorPowSection

variable (L : X.Modules)
  [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from L)]

/-- The function `1` vanishes nowhere on its domain. -/
theorem nonvanishingLocus_one (U : X.Opens) :
    nonvanishingLocus (SheafOfModules.unit X.ringCatSheaf) (1 : Γ(X, U)) = U := by
  let O : X.Modules := SheafOfModules.unit X.ringCatSheaf
  refine le_antisymm (nonvanishingLocus_le _) fun x hxU ↦ ⟨hxU, ?_⟩
  let g := germ O x hxU (1 : Γ(X, U))
  change Submodule.span _ {g} = ⊤
  rw [eq_top_iff]
  rintro m -
  obtain ⟨V, hx, a, rfl⟩ := exists_germ_eq O x m
  have hVU : x ∈ V ⊓ U := ⟨hx, hxU⟩
  have e1 : O.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op a =
      (show Γ(X, V ⊓ U) from O.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op a) •
        O.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op (1 : Γ(X, U)) := by
    change _ = _ * X.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op 1
    rw [map_one, mul_one]
  have h : germ O x hx a = X.presheaf.germ (V ⊓ U) x hVU
      (O.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op a) • g :=
    ((germ_res O inf_le_left x hVU a).symm.trans (congrArg (germ O x hVU) e1)).trans
      ((germ_smul O x hVU _ _).trans
        (congrArg (_ • ·) (germ_res O inf_le_right x hVU _)))
  rw [h]
  exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)

/-- The tensor power `s^{⊗ n}` of a section. -/
def tensorPowSection {U : X.Opens} (s : Γ(L, U)) : (n : ℕ) → Γ(tensorPow L n, U)
  | 0 => (1 : Γ(X, U))
  | n + 1 => tmulSection (tensorPow L n) L (op U) (tensorPowSection s n) s

/-- `X_{s^{⊗ n}} = X_s` for `n ≥ 1`. -/
theorem nonvanishingLocus_tensorPowSection {U : X.Opens} (s : Γ(L, U)) {n : ℕ} (hn : 1 ≤ n) :
    nonvanishingLocus (tensorPow L n) (tensorPowSection L s n) = nonvanishingLocus L s := by
  induction n with
  | zero => omega
  | succ n ih =>
    change nonvanishingLocus (tensorObj (tensorPow L n) L)
      (tmulSection (tensorPow L n) L (op U) (tensorPowSection L s n) s) = _
    rw [nonvanishingLocus_tmulSection]
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · change nonvanishingLocus (SheafOfModules.unit X.ringCatSheaf) (1 : Γ(X, U)) ⊓ _ = _
      rw [nonvanishingLocus_one, inf_eq_right.2 (nonvanishingLocus_le s)]
    · rw [ih hn, inf_idem]

end TensorPowSection

/-! ## Ample invertible sheaves -/

section Ample

variable (L : X.Modules)
  [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from L)]

/-- **Ample invertible sheaf** (Stacks 01PS): `X` is quasi-compact and every point lies in an
affine non-vanishing locus `X_s` of a global section `s` of some positive tensor power of `L`. -/
def IsAmple : Prop :=
  CompactSpace X ∧ ∀ x : X, ∃ (n : ℕ) (_ : 1 ≤ n) (s : Γ(tensorPow L n, ⊤)),
    x ∈ nonvanishingLocus (tensorPow L n) s ∧
      IsAffineOpen (nonvanishingLocus (tensorPow L n) s)

/-- `L` is ample on the open `U`: `U` is quasi-compact and every point of `U` lies in an affine
non-vanishing locus of a section over `U` of a positive tensor power of `L`. This is ampleness of
the restriction of `L` to `U` (`isAmple_restrict_iff`), stated without leaving `X`. -/
def IsAmpleOn (U : X.Opens) : Prop :=
  IsCompact (U : Set X) ∧ ∀ x ∈ U, ∃ (n : ℕ) (_ : 1 ≤ n) (s : Γ(tensorPow L n, U)),
    x ∈ nonvanishingLocus (tensorPow L n) s ∧
      IsAffineOpen (nonvanishingLocus (tensorPow L n) s)

variable {L}

/-- Ampleness is ampleness on the whole scheme. -/
theorem isAmple_iff_isAmpleOn_top : IsAmple L ↔ IsAmpleOn L ⊤ := by
  refine and_congr ?_ ⟨fun h x _ ↦ h x, fun h x ↦ h x (Opens.mem_top x)⟩
  rw [Opens.coe_top, ← isCompact_univ_iff]

/-- Ampleness on an open is invariant under isomorphism. -/
theorem IsAmpleOn.of_iso {M : X.Modules}
    [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from M)]
    (φ : L ≅ M) {U : X.Opens} (h : IsAmpleOn L U) : IsAmpleOn M U := by
  refine ⟨h.1, fun x hx ↦ ?_⟩
  obtain ⟨n, hn, s, hxs, hs⟩ := h.2 x hx
  refine ⟨n, hn, (tensorPowIso φ n).hom.app U s, ?_⟩
  rw [nonvanishingLocus_iso]
  exact ⟨hxs, hs⟩

/-- Ampleness on an open, from sections of the sheaf itself. -/
theorem IsAmpleOn.of_sections {U : X.Opens} (hU : IsCompact (U : Set X))
    (h : ∀ x ∈ U, ∃ s : Γ(L, U), x ∈ nonvanishingLocus L s ∧
      IsAffineOpen (nonvanishingLocus L s)) : IsAmpleOn L U := by
  refine ⟨hU, fun x hx ↦ ?_⟩
  obtain ⟨s, hxs, hs⟩ := h x hx
  refine ⟨1, le_rfl, (tensorUnitLeftIso L).inv.app U s, ?_⟩
  have := @nonvanishingLocus_iso X L (tensorPow L 1) _ (isInvertible_tensorPow L 1)
    (tensorUnitLeftIso L).symm U s
  rw [Iso.symm_hom] at this
  exact ⟨this ▸ hxs, this ▸ hs⟩

/-- Ampleness is invariant under isomorphism. -/
theorem IsAmple.of_iso {M : X.Modules}
    [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from M)]
    (φ : L ≅ M) (h : IsAmple L) : IsAmple M :=
  isAmple_iff_isAmpleOn_top.2 ((isAmple_iff_isAmpleOn_top.1 h).of_iso φ)

/-- Ampleness on an open of a positive tensor power is ampleness on that open. -/
theorem isAmpleOn_tensorPow_iff {n : ℕ} (hn : 1 ≤ n) {U : X.Opens} :
    IsAmpleOn (tensorPow L n) U ↔ IsAmpleOn L U := by
  refine ⟨fun h ↦ ⟨h.1, fun x hx ↦ ?_⟩, fun h ↦ ⟨h.1, fun x hx ↦ ?_⟩⟩
  · obtain ⟨m, hm, s, hxs, hs⟩ := h.2 x hx
    refine ⟨n * m, Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by omega)),
      (tensorPowMulIso L n m).hom.app U s, ?_⟩
    rw [nonvanishingLocus_iso]
    exact ⟨hxs, hs⟩
  · obtain ⟨m, hm, s, hxs, hs⟩ := h.2 x hx
    refine ⟨m, hm, (tensorPowCommIso L m n).hom.app U (tensorPowSection _ s n), ?_⟩
    rw [nonvanishingLocus_iso, nonvanishingLocus_tensorPowSection _ s hn]
    exact ⟨hxs, hs⟩

/-- **Ampleness of a power** (Stacks 01PT): for `n ≥ 1`, `L^{⊗ n}` is ample if and only if `L`
is. -/
theorem isAmple_tensorPow_iff {n : ℕ} (hn : 1 ≤ n) : IsAmple (tensorPow L n) ↔ IsAmple L := by
  rw [isAmple_iff_isAmpleOn_top, isAmple_iff_isAmpleOn_top, isAmpleOn_tensorPow_iff hn]

/-- Ampleness on an open pulls back along affine morphisms: the preimage of an affine `X_s` is
the affine `Y_{f^* s}`. -/
theorem IsAmpleOn.pullback {Y : Scheme.{u}} (f : Y ⟶ X) [IsAffineHom f] {U : X.Opens}
    (h : IsAmpleOn L U) : IsAmpleOn ((pullback f).obj L) (f ⁻¹ᵁ U) := by
  refine ⟨f.isCompact_preimage h.1, fun y hy ↦ ?_⟩
  obtain ⟨n, hn, s, hxs, hs⟩ := h.2 (f y) hy
  refine ⟨n, hn, (pullbackTensorPowIso f L n).hom.app _ (pullbackSection f _ s), ?_⟩
  rw [nonvanishingLocus_iso, nonvanishingLocus_pullbackSection]
  exact ⟨hxs, hs.preimage f⟩

/-- **Ampleness pulls back along affine morphisms.** -/
theorem IsAmple.pullback {Y : Scheme.{u}} (f : Y ⟶ X) [IsAffineHom f] (h : IsAmple L) :
    IsAmple ((pullback f).obj L) :=
  isAmple_iff_isAmpleOn_top.2 ((isAmple_iff_isAmpleOn_top.1 h).pullback f)

/-- **Ampleness restricts to closed subschemes** (Stacks 01PU). -/
theorem IsAmple.pullback_of_isClosedImmersion {Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    (h : IsAmple L) : IsAmple ((Scheme.Modules.pullback i).obj L) :=
  h.pullback i

end Ample

/-! ## Restriction to an open subscheme -/

section Restrict

variable {Y : Scheme.{u}} (f : Y ⟶ X) [IsOpenImmersion f] (L : X.Modules)

/-- The comparison of restriction with pullback sends the restriction of a section to its
pullback. -/
theorem restrictFunctorIsoPullback_hom_app_app {W : X.Opens} (s : Γ(L, W)) :
    ((restrictFunctorIsoPullback f).hom.app L).app (f ⁻¹ᵁ W)
        (L.presheaf.map (homOfLE (f.image_preimage_le W)).op s) =
      pullbackSection f L s := by
  have h := congrArg (fun φ ↦ φ.app W s)
    (Adjunction.unit_leftAdjointUniq_hom_app (restrictAdjunction f)
      (pullbackPushforwardAdjunction f) L)
  exact h

variable [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from L)]

/-- The restriction of an invertible sheaf to an open subscheme is invertible. -/
instance isInvertible_restrict :
    SheafOfModules.IsInvertible.{u, u, u}
      (show SheafOfModules Y.ringCatSheaf from L.restrict f) := by
  have := isInvertible_pullback f L
  exact SheafOfModules.IsInvertible.ofIso.{u, u, u} ((restrictFunctorIsoPullback f).app L).symm

/-- The non-vanishing locus of a section of a restriction is the preimage of its non-vanishing
locus as a section of `L`. -/
theorem nonvanishingLocus_restrict {V : Y.Opens} (s : Γ(L.restrict f, V)) :
    nonvanishingLocus (L.restrict f) s =
      f ⁻¹ᵁ nonvanishingLocus L (show Γ(L, f ''ᵁ V) from s) := by
  have h₁ : (L.restrict f).presheaf.map (eqToHom (f.preimage_image_eq V)).op s =
      L.presheaf.map (homOfLE (f.image_preimage_le (f ''ᵁ V))).op s := by
    rw [restrict_map]
    rfl
  have h₂ : ((restrictFunctorIsoPullback f).app L).hom.app _
      ((L.restrict f).presheaf.map (eqToHom (f.preimage_image_eq V)).op s) =
        pullbackSection f L (show Γ(L, f ''ᵁ V) from s) := by
    rw [h₁]
    exact restrictFunctorIsoPullback_hom_app_app f L _
  calc nonvanishingLocus (L.restrict f) s
      = nonvanishingLocus (L.restrict f)
          ((L.restrict f).presheaf.map (eqToHom (f.preimage_image_eq V)).op s) :=
        (nonvanishingLocus_map_eqToHom _ s).symm
    _ = nonvanishingLocus ((pullback f).obj L) (((restrictFunctorIsoPullback f).app L).hom.app _
          ((L.restrict f).presheaf.map (eqToHom (f.preimage_image_eq V)).op s)) :=
        (nonvanishingLocus_iso ((restrictFunctorIsoPullback f).app L) _).symm
    _ = _ := by rw [h₂, nonvanishingLocus_pullbackSection]

/-- Restriction to an open subscheme commutes with tensor powers. -/
def restrictTensorPowIso (n : ℕ) :
    tensorPow (L.restrict f) n ≅ (tensorPow L n).restrict f :=
  tensorPowIso ((restrictFunctorIsoPullback f).app L) n ≪≫ (pullbackTensorPowIso f L n).symm ≪≫
    ((restrictFunctorIsoPullback f).app (tensorPow L n)).symm

/-- **Ampleness of a restriction is ampleness on the open**. -/
theorem isAmple_restrict_iff (U : X.Opens) : IsAmple (L.restrict U.ι) ↔ IsAmpleOn L U := by
  have himage : ∀ {W : X.Opens}, W ≤ U → U.ι ''ᵁ U.ι ⁻¹ᵁ W = W := fun hW ↦ by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι,
      inf_eq_right.2 hW]
  refine ⟨fun h ↦ ⟨?_, fun x hx ↦ ?_⟩, fun h ↦ ⟨?_, fun y ↦ ?_⟩⟩
  · have := h.1
    simpa using (isCompact_range U.ι.continuous)
  · obtain ⟨n, hn, σ, hy, hσ⟩ := h.2 ⟨x, hx⟩
    let t : Γ(tensorPow L n, U.ι ''ᵁ ⊤) := (restrictTensorPowIso U.ι L n).hom.app ⊤ σ
    have ht : nonvanishingLocus ((tensorPow L n).restrict U.ι) t =
        nonvanishingLocus (tensorPow (L.restrict U.ι) n) σ :=
      nonvanishingLocus_iso (restrictTensorPowIso U.ι L n) σ
    rw [nonvanishingLocus_restrict] at ht
    refine ⟨n, hn, (tensorPow L n).presheaf.map (eqToHom U.ι_image_top.symm).op t, ?_⟩
    rw [nonvanishingLocus_map_eqToHom]
    refine ⟨?_, ?_⟩
    · have : (⟨x, hx⟩ : U) ∈ U.ι ⁻¹ᵁ nonvanishingLocus (tensorPow L n) t := ht ▸ hy
      exact this
    · rw [← himage (nonvanishingLocus_le t |>.trans_eq U.ι_image_top), ht]
      exact hσ.image_of_isOpenImmersion U.ι
  · have := isCompact_iff_compactSpace.1 h.1
    exact this
  · obtain ⟨n, hn, s, hx, hs⟩ := h.2 y.1 y.2
    let t : Γ((tensorPow L n).restrict U.ι, ⊤) :=
      (tensorPow L n).presheaf.map (eqToHom U.ι_image_top).op s
    have ht : nonvanishingLocus ((tensorPow L n).restrict U.ι) t =
        U.ι ⁻¹ᵁ nonvanishingLocus (tensorPow L n) s := by
      rw [nonvanishingLocus_restrict]
      exact congrArg (U.ι ⁻¹ᵁ ·) (nonvanishingLocus_map_eqToHom _ s)
    refine ⟨n, hn, (restrictTensorPowIso U.ι L n).symm.hom.app ⊤ t, ?_⟩
    rw [nonvanishingLocus_iso, ht]
    refine ⟨hx, ?_⟩
    rw [← U.ι.isAffineOpen_iff_of_isOpenImmersion, himage (nonvanishingLocus_le s)]
    exact hs

end Restrict

/-! ## Extending sections from a basic open -/

section Extension

variable {Y : Scheme.{u}}

/-- Restriction of functions composes. -/
private lemma res_res {U V W : Y.Opens} (h₁ : V ≤ U) (h₂ : W ≤ V) (x : Γ(Y, U)) :
    Y.presheaf.map (homOfLE h₂).op (Y.presheaf.map (homOfLE h₁).op x) =
      Y.presheaf.map (homOfLE (h₂.trans h₁)).op x := by
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
  rfl

/-- On a quasi-compact open inside the domain of a local basis, a section vanishing on the basic
open of `a` is killed by a power of `a`. -/
private lemma exists_pow_smul_eq_zero {M : Y.Modules} {U O : Y.Opens} {e : Γ(M, U)}
    (he : IsLocalBasis M U e) (hOU : O ≤ U) (hO : IsCompact (O : Set Y)) (a : Γ(Y, O))
    (δ : Γ(M, O)) (hδ : M.presheaf.map (homOfLE (Y.basicOpen_le a)).op δ = 0) :
    ∃ k : ℕ, a ^ k • δ = 0 := by
  have he' := he.res hOU
  have hd : he'.coeff δ • M.presheaf.map (homOfLE hOU).op e = δ := he'.coeff_smul δ
  have hd0 : Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op (he'.coeff δ) = 0 := by
    apply (he ((Y.basicOpen_le a).trans hOU)).1
    rw [LinearMap.toSpanSingleton_apply, LinearMap.toSpanSingleton_apply, zero_smul]
    rw [← hd, resSection_smul, resSection_trans] at hδ
    exact hδ
  obtain ⟨k, hk⟩ :=
    exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isCompact Y hO (he'.coeff δ) a hd0
  exact ⟨k, by rw [← hd, smul_smul, hk, zero_smul]⟩

/-- On an affine open `U ≤ W` carrying a local basis, a power of `a` times `σ` extends from
`U ⊓ D(a)` to `U`. -/
private lemma exists_local_extension {M : Y.Modules} {W U : Y.Opens} (a : Γ(Y, W))
    (σ : Γ(M, Y.basicOpen a)) (hU : IsAffineOpen U) (hUW : U ≤ W) {e : Γ(M, U)}
    (he : IsLocalBasis M U e) :
    ∃ (m : ℕ) (τ : Γ(M, U)), ∀ (V : Y.Opens) (hVU : V ≤ U) (hVa : V ≤ Y.basicOpen a),
      M.presheaf.map (homOfLE hVU).op τ =
        Y.presheaf.map (homOfLE (hVa.trans (Y.basicOpen_le a))).op a ^ m •
          M.presheaf.map (homOfLE hVa).op σ := by
  have hD : Y.basicOpen (Y.presheaf.map (homOfLE hUW).op a) = U ⊓ Y.basicOpen a :=
    Y.basicOpen_res a _
  have hDa : Y.basicOpen (Y.presheaf.map (homOfLE hUW).op a) ≤ Y.basicOpen a :=
    hD.le.trans inf_le_right
  have hDU : Y.basicOpen (Y.presheaf.map (homOfLE hUW).op a) ≤ U := Y.basicOpen_le _
  have hc := (he.res hDU).coeff_smul (M.presheaf.map (homOfLE hDa).op σ)
  obtain ⟨m, b, hb⟩ := exists_eq_pow_mul_of_isAffineOpen Y U hU
    (Y.presheaf.map (homOfLE hUW).op a) ((he.res hDU).coeff (M.presheaf.map (homOfLE hDa).op σ))
  refine ⟨m, b • e, fun V hVU hVa ↦ ?_⟩
  have hVD : V ≤ Y.basicOpen (Y.presheaf.map (homOfLE hUW).op a) := hD ▸ le_inf hVU hVa
  have hb' : Y.presheaf.map (homOfLE hDU).op b =
      Y.presheaf.map (homOfLE hDU).op (Y.presheaf.map (homOfLE hUW).op a) ^ m *
        (he.res hDU).coeff (M.presheaf.map (homOfLE hDa).op σ) := hb
  rw [← resSection_trans M hDU hVD, resSection_smul, hb', mul_smul, hc, resSection_smul,
    map_pow, res_res, res_res, resSection_trans]

/-- **Extension of sections of an invertible sheaf** (Stacks 01PW): on a quasi-compact and
quasi-separated open `W`, for `a : Γ(Y, W)` and a section `σ` of `M` over `D(a)`, some `a^n σ`
extends to a section of `M` over `W`. -/
theorem exists_pow_smul_eq_res (M : Y.Modules)
    [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules Y.ringCatSheaf from M)]
    {W : Y.Opens} (hW : IsCompact (W : Set Y)) (hW' : IsQuasiSeparated (W : Set Y))
    (a : Γ(Y, W)) (σ : Γ(M, Y.basicOpen a)) :
    ∃ (n : ℕ) (τ : Γ(M, W)), M.presheaf.map (homOfLE (Y.basicOpen_le a)).op τ =
      Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op a ^ n • σ := by
  have hloc : ∀ x : W, ∃ (U : Y.Opens) (_ : (x : Y) ∈ U) (_ : IsAffineOpen U) (_ : U ≤ W)
      (e : Γ(M, U)), IsLocalBasis M U e := by
    intro x
    obtain ⟨U₀, hxU₀, e₀, he₀⟩ := exists_isLocalBasis M x
    obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUle⟩ := Y.isBasis_affineOpens.exists_subset_of_mem_open
      (show (x : Y) ∈ ((U₀ ⊓ W : Y.Opens) : Set Y) from ⟨hxU₀, x.2⟩) (U₀ ⊓ W).isOpen
    have hUle' : U ≤ U₀ ⊓ W := hUle
    exact ⟨U, hxU, hU, hUle'.trans inf_le_right, _, he₀.res (hUle'.trans inf_le_left)⟩
  choose U hxU hU hUW e he using hloc
  obtain ⟨t, ht⟩ := hW.elim_finite_subcover (fun x : W ↦ (U x : Set Y))
    (fun x ↦ (U x).isOpen) (fun x hx ↦ Set.mem_iUnion.2 ⟨⟨x, hx⟩, hxU ⟨x, hx⟩⟩)
  choose m τ hτ using fun x ↦ exists_local_extension a σ (hU x) (hUW x) (he x)
  -- a uniform exponent on the finite cover
  let N := t.sup m
  let τ' : ∀ i : t, Γ(M, U i) := fun i ↦
    Y.presheaf.map (homOfLE (hUW i)).op a ^ (N - m i) • τ i
  have hτ' : ∀ (i : t) (V : Y.Opens) (hVU : V ≤ U i) (hVa : V ≤ Y.basicOpen a),
      M.presheaf.map (homOfLE hVU).op (τ' i) =
        Y.presheaf.map (homOfLE (hVa.trans (Y.basicOpen_le a))).op a ^ N •
          M.presheaf.map (homOfLE hVa).op σ := by
    intro i V hVU hVa
    rw [resSection_smul, hτ i V hVU hVa, smul_smul, map_pow, res_res, ← pow_add,
      Nat.sub_add_cancel (Finset.le_sup i.2)]
  -- on overlaps the differences are killed by a power of `a`
  have hcomp : ∀ i j : t, ∃ k : ℕ,
      Y.presheaf.map (homOfLE ((inf_le_left : U i ⊓ U j ≤ U i).trans (hUW i))).op a ^ k •
        (M.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (τ' i) -
          M.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (τ' j)) = 0 := by
    intro i j
    have hO : IsCompact ((U i ⊓ U j : Y.Opens) : Set Y) :=
      hW' _ _ (hUW i) (U i).isOpen (hU i).isCompact (hUW j) (U j).isOpen (hU j).isCompact
    refine exists_pow_smul_eq_zero (he i) inf_le_left hO _ _ ?_
    have hDO : Y.basicOpen (Y.presheaf.map
        (homOfLE ((inf_le_left : U i ⊓ U j ≤ U i).trans (hUW i))).op a) ≤ Y.basicOpen a := by
      rw [Scheme.basicOpen_res]
      exact inf_le_right
    rw [map_sub, resSection_trans, resSection_trans, hτ' i _ _ hDO, hτ' j _ _ hDO, sub_self]
  choose k hk using hcomp
  let K := Finset.univ.sup fun i : t ↦ Finset.univ.sup fun j : t ↦ k i j
  have hkK : ∀ i j : t, k i j ≤ K := fun i j ↦
    (Finset.le_sup (f := fun j : t ↦ k i j) (Finset.mem_univ j)).trans
      (Finset.le_sup (f := fun i : t ↦ Finset.univ.sup fun j : t ↦ k i j) (Finset.mem_univ i))
  -- glue
  let sf : ∀ i : t, Γ(M, U i) := fun i ↦ Y.presheaf.map (homOfLE (hUW i)).op a ^ K • τ' i
  have hsf : TopCat.Presheaf.IsCompatible (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab Y).1
      (fun i : t ↦ U i) sf := by
    intro i j
    change M.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (sf i) =
      M.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (sf j)
    rw [← sub_eq_zero]
    simp only [sf, resSection_smul, map_pow, res_res]
    rw [← smul_sub, ← Nat.sub_add_cancel (hkK i j), pow_add, mul_smul, hk i j, smul_zero]
  obtain ⟨τ₀, hτ₀, -⟩ := TopCat.Sheaf.existsUnique_gluing' (⟨M.presheaf, M.isSheaf⟩ :
    TopCat.Sheaf Ab Y) (fun i : t ↦ U i) W (fun i ↦ homOfLE (hUW i))
    (fun x hx ↦ by
      obtain ⟨i, hi, hxi⟩ := Set.mem_iUnion₂.1 (ht hx)
      exact Opens.mem_iSup.2 ⟨⟨i, hi⟩, hxi⟩) sf hsf
  refine ⟨K + N, τ₀, section_ext M fun x hx ↦ ?_⟩
  obtain ⟨i, hi, hxi⟩ := Set.mem_iUnion₂.1 (ht (Y.basicOpen_le a hx))
  have hxV : x ∈ U i ⊓ Y.basicOpen a := ⟨hxi, hx⟩
  refine (germ_res M inf_le_right x hxV _).symm.trans
    (Eq.trans ?_ (germ_res M inf_le_right x hxV _))
  congr 1
  have h1 := hτ₀ ⟨i, hi⟩
  change M.presheaf.map (homOfLE (hUW i)).op τ₀ = sf ⟨i, hi⟩ at h1
  rw [resSection_trans,
    ← resSection_trans M (hUW i) (inf_le_left : U i ⊓ Y.basicOpen a ≤ U i), h1,
    resSection_smul, hτ' ⟨i, hi⟩ _ _ inf_le_right, resSection_smul, smul_smul, map_pow,
    map_pow, res_res, res_res, ← pow_add]

/-- **Ampleness on a quasi-compact quasi-separated open is local for basic opens**: if every point
of `W` lies in a basic open `D(a)`, `a : Γ(Y, W)`, on which `L` is ample, then `L` is ample on
`W`. A section `σ` over `D(a)` with affine `Y_σ` extends after multiplication by `a^n` to `τ`
over `W` (Stacks 01PW), and `Y_{a τ} = Y_σ`. -/
theorem isAmpleOn_of_forall_isAmpleOn_basicOpen {L : Y.Modules}
    [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules Y.ringCatSheaf from L)]
    {W : Y.Opens} (hW : IsCompact (W : Set Y)) (hW' : IsQuasiSeparated (W : Set Y))
    (H : ∀ x ∈ W, ∃ a : Γ(Y, W), x ∈ Y.basicOpen a ∧ IsAmpleOn L (Y.basicOpen a)) :
    IsAmpleOn L W := by
  refine ⟨hW, fun x hx ↦ ?_⟩
  obtain ⟨a, hxa, ha⟩ := H x hx
  obtain ⟨n, hn, σ, hxσ, hσ⟩ := ha.2 x hxa
  obtain ⟨k, τ, hτ⟩ := exists_pow_smul_eq_res (tensorPow L n) hW hW' a σ
  have key :
      nonvanishingLocus (tensorPow L n) (a • τ) = nonvanishingLocus (tensorPow L n) σ := by
    have hu : IsUnit (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op a ^ k) :=
      (Y.toRingedSpace.isUnit_res_basicOpen a).pow k
    have h1 := congrArg (nonvanishingLocus (tensorPow L n)) hτ
    rw [nonvanishingLocus_res, nonvanishingLocus_smul, Y.basicOpen_of_isUnit hu] at h1
    rw [nonvanishingLocus_smul, inf_comm, h1, inf_eq_right.2 (nonvanishingLocus_le σ)]
  exact ⟨n, hn, a • τ, key ▸ hxσ, key ▸ hσ⟩

end Extension

/-! ## Separatedness -/

section Separated

open Limits

set_option backward.isDefEq.respectTransparency false in
/-- A scheme covered by affine opens, any two of which meet in an affine open whose functions
are products of restrictions from the two, is separated: the diagonal is a closed immersion over
each product of two members of the cover. -/
private theorem isSeparated_of_affine_cover {ι : Type u} (U : ι → X.Opens) (hU : ⨆ i, U i = ⊤)
    (hUa : ∀ i, IsAffineOpen (U i)) (hinf : ∀ i j, IsAffineOpen (U i ⊓ U j))
    (hgen : ∀ i j (z : Γ(X, U i ⊓ U j)), ∃ (a : Γ(X, U i)) (b : Γ(X, U j)),
      z = X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op a *
        X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op b) :
    X.IsSeparated := by
  let 𝒰 := X.openCoverOfIsOpenCover U hU
  have : ∀ i, IsAffine (𝒰.X i) := hUa
  have hsep : IsSeparated X.toSpecΓ := by
    refine ⟨IsZariskiLocalAtTarget.of_openCover (Scheme.Pullback.openCoverOfLeftRight 𝒰 𝒰 _ _) ?_⟩
    intro ⟨i, j⟩
    dsimp [Scheme.Cover.pullbackHom]
    refine (MorphismProperty.cancel_left_of_respectsIso (P := @IsClosedImmersion)
      (f := (pullbackDiagonalMapIdIso ..).inv) _).mp ?_
    let e := (isPullback_opens_inf (U i) (U j)).isoPullback
    refine (MorphismProperty.cancel_left_of_respectsIso (P := @IsClosedImmersion)
      (f := e.hom) _).mp ?_
    have : IsAffine (U i ⊓ U j).toScheme := hinf i j
    have : IsAffine (U i).toScheme := hUa i
    have : IsAffine (U j).toScheme := hUa j
    have : IsAffine (Limits.pullback ((U i).ι ≫ X.toSpecΓ) ((U j).ι ≫ X.toSpecΓ)) :=
      inferInstance
    have : IsAffine ((Scheme.Pullback.openCoverOfLeftRight 𝒰 𝒰 X.toSpecΓ X.toSpecΓ).X (i, j)) :=
      this
    refine IsClosedImmersion.of_surjective_of_isAffine _ fun w ↦ ?_
    let ψ := e.hom ≫ (pullbackDiagonalMapIdIso (𝒰.f i) (𝒰.f j) X.toSpecΓ).inv ≫ pullback.snd _ _
    have h1 : ψ ≫ pullback.fst _ _ = X.homOfLE inf_le_left := by
      simp only [ψ, e, Category.assoc, pullbackDiagonalMapIdIso_inv_snd_fst]
      exact (isPullback_opens_inf (U i) (U j)).isoPullback_hom_fst
    have h2 : ψ ≫ pullback.snd _ _ = X.homOfLE inf_le_right := by
      simp only [ψ, e, Category.assoc, pullbackDiagonalMapIdIso_inv_snd_snd]
      exact (isPullback_opens_inf (U i) (U j)).isoPullback_hom_snd
    obtain ⟨a, b, hab⟩ := hgen i j ((U i ⊓ U j).topIso.hom w)
    refine ⟨(pullback.fst (𝒰.f i ≫ X.toSpecΓ) (𝒰.f j ≫ X.toSpecΓ)).appTop
      ((U i).topIso.inv a) *
      (pullback.snd (𝒰.f i ≫ X.toSpecΓ) (𝒰.f j ≫ X.toSpecΓ)).appTop ((U j).topIso.inv b), ?_⟩
    change ψ.appTop _ = w
    rw [map_mul, ← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply,
      ← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, h1, h2]
    have key : ∀ {V W : X.Opens} (h : W ≤ V) (a : Γ(X, V)),
        (X.homOfLE h).appTop (V.topIso.inv a) = W.topIso.inv (X.presheaf.map (homOfLE h).op a) := by
      intro V W h a
      rw [Scheme.homOfLE_appTop]
      simp only [Scheme.Opens.topIso, Functor.mapIso_inv, Iso.op_inv, eqToIso.inv]
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← ConcreteCategory.comp_apply,
        ← Functor.map_comp]
      rfl
    erw [key, key]
    rw [← map_mul, ← hab]
    exact Iso.hom_inv_id_apply _ _
  exact (HasAffineProperty.iff_of_isAffine (P := @IsSeparated)).mp hsep

/-- Two non-vanishing loci of global sections of one invertible sheaf meet in a basic open of the
first, cut out by a coefficient that is inverted by the corresponding coefficient on the second. -/
private theorem exists_basicOpen_eq_inf (M : X.Modules)
    [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from M)]
    (σ τ : Γ(M, ⊤)) :
    ∃ (f : Γ(X, nonvanishingLocus M σ)) (g : Γ(X, nonvanishingLocus M τ)),
      nonvanishingLocus M σ ⊓ nonvanishingLocus M τ = X.basicOpen f ∧
      X.presheaf.map (homOfLE inf_le_left).op f *
        X.presheaf.map (homOfLE inf_le_right).op g = 1 := by
  set P := nonvanishingLocus M σ
  set Q := nonvanishingLocus M τ
  have eP := isLocalBasis_of_le_nonvanishingLocus M σ (le_refl P)
  have eQ := isLocalBasis_of_le_nonvanishingLocus M τ (le_refl Q)
  let f := eP.coeff (M.presheaf.map (homOfLE (le_top : P ≤ ⊤)).op τ)
  let g := eQ.coeff (M.presheaf.map (homOfLE (le_top : Q ≤ ⊤)).op σ)
  refine ⟨f, g, ?_, ?_⟩
  · rw [← nonvanishingLocus_eq_basicOpen eP, nonvanishingLocus_res, inf_comm]
  · have hf := congrArg (M.presheaf.map (homOfLE (inf_le_left : P ⊓ Q ≤ P)).op) (eP.coeff_smul
      (M.presheaf.map (homOfLE (le_top : P ≤ ⊤)).op τ))
    have hg := congrArg (M.presheaf.map (homOfLE (inf_le_right : P ⊓ Q ≤ Q)).op) (eQ.coeff_smul
      (M.presheaf.map (homOfLE (le_top : Q ≤ ⊤)).op σ))
    rw [map_smul, resSection_trans, resSection_trans] at hf hg
    have eW := eP.res (inf_le_left : P ⊓ Q ≤ P)
    rw [resSection_trans] at eW
    refine eW.smul_left_injective ?_
    rw [one_smul, mul_comm, mul_smul, hf, hg]

/-- The cover criterion, when each pairwise intersection is a basic open of the first member
whose defining function is a unit up to a function on the second. -/
private theorem isSeparated_of_basicOpen_cover {ι : Type u} (U : ι → X.Opens) (hU : ⨆ i, U i = ⊤)
    (hUa : ∀ i, IsAffineOpen (U i))
    (hinf : ∀ i j, ∃ (f : Γ(X, U i)) (g : Γ(X, U j)), U i ⊓ U j = X.basicOpen f ∧
      X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op f *
        X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op g = 1) :
    X.IsSeparated := by
  refine isSeparated_of_affine_cover U hU hUa (fun i j ↦ ?_) (fun i j z ↦ ?_)
  · obtain ⟨f, g, h, -⟩ := hinf i j
    rw [h]
    exact (hUa i).basicOpen f
  · obtain ⟨f, g, h, hfg⟩ := hinf i j
    obtain ⟨n, y, hy⟩ := exists_eq_pow_mul_of_isAffineOpen X (U i) (hUa i) f
      (X.presheaf.map (eqToHom h.symm).op z)
    refine ⟨y, g ^ n, ?_⟩
    have hres : ∀ a : Γ(X, U i), X.presheaf.map (eqToHom h).op (a |_ X.basicOpen f) =
        X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op a := fun a ↦ by
      change (X.presheaf.map _ ≫ X.presheaf.map _) a = _
      rw [← Functor.map_comp]
      rfl
    have hz : X.presheaf.map (eqToHom h).op (X.presheaf.map (eqToHom h.symm).op z) = z := by
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
      simp
    have := congrArg (X.presheaf.map (eqToHom h).op) hy
    rw [map_mul, map_pow, hres, hres, hz] at this
    rw [this, map_pow, mul_right_comm, ← mul_pow, hfg, one_pow, one_mul]

/-- **A scheme with an ample invertible sheaf is separated** (Stacks 01PY, 09MP): the affine loci
`X_s` cover `X`, and two of them meet in a basic open of either whose functions come from the two.
-/
theorem IsAmple.isSeparated {L : X.Modules}
    [SheafOfModules.IsInvertible.{u, u, u} (show SheafOfModules X.ringCatSheaf from L)]
    (h : IsAmple L) : X.IsSeparated := by
  choose n hn s hxs hs using h.2
  refine isSeparated_of_basicOpen_cover (fun x ↦ nonvanishingLocus (tensorPow L (n x)) (s x))
    (eq_top_iff.2 fun x _ ↦ Opens.mem_iSup.2 ⟨x, hxs x⟩) hs fun x y ↦ ?_
  let σ : Γ(tensorPow L (n x * n y), ⊤) :=
    (tensorPowMulIso L (n x) (n y)).hom.app ⊤ (tensorPowSection _ (s x) (n y))
  let τ : Γ(tensorPow L (n x * n y), ⊤) :=
    (tensorPowMulIso L (n y) (n x) ≪≫ eqToIso (congrArg (tensorPow L) (Nat.mul_comm _ _))).hom.app
      ⊤ (tensorPowSection _ (s y) (n x))
  have hσ : nonvanishingLocus _ σ = nonvanishingLocus _ (s x) := by
    rw [nonvanishingLocus_iso, nonvanishingLocus_tensorPowSection _ _ (hn y)]
  have hτ : nonvanishingLocus _ τ = nonvanishingLocus _ (s y) := by
    rw [nonvanishingLocus_iso, nonvanishingLocus_tensorPowSection _ _ (hn x)]
  have := exists_basicOpen_eq_inf (tensorPow L (n x * n y)) σ τ
  rw [hσ, hτ] at this
  exact this

end Separated

end

end AlgebraicGeometry.Scheme.Modules
