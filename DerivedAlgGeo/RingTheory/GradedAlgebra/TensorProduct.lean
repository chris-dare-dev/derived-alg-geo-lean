import Mathlib.Algebra.Category.Ring.Constructions
import Mathlib.CategoryTheory.ConcreteCategory.EpiMono
import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Maps
import Mathlib.RingTheory.GradedAlgebra.HomogeneousLocalization
import Mathlib.RingTheory.GradedAlgebra.TensorProduct

/-!
# Base change of graded algebras and of their homogeneous localizations

Let `𝒜` be a graded `R`-algebra and `S` an `R`-algebra. Mathlib grades `S ⊗[R] A` by
`fun i ↦ (𝒜 i).baseChange S` (`GradedAlgebra.baseChange`). This file records the graded ring map
`a ↦ 1 ⊗ a` and proves that the degree-zero homogeneous localization at a homogeneous element
commutes with this base change:

    S ⊗[R] A_(f) ≅ (S ⊗[R] A)_(1 ⊗ f).

## Main definitions

* `GradedRingHom.includeRight S 𝒜 : 𝒜 →+*ᵍ fun i ↦ (𝒜 i).baseChange S`, the graded inclusion.
* `GradedRingHom.symmOfBijective`, the graded inverse of a bijective graded ring map.

## Main results

* `GradedRingHom.irrelevant_baseChange_le_map`: the irrelevant ideal of the base change is
  generated by the image of the irrelevant ideal, which is the hypothesis of `Proj.map`.
* `GradedRingHom.irrelevant_le_map_of_bijective`: the same hypothesis for a bijective graded
  ring map, so a model of a base change (such as `R[n]` for `R ⊗ ℤ[n]`) can be substituted for it
  under `Proj.map`.
* `HomogeneousLocalization.Away.isPushout_baseChange`: the square of rings
  `R → S`, `R → A_(f)`, `S → (S ⊗ A)_(1 ⊗ f)`, `A_(f) → (S ⊗ A)_(1 ⊗ f)` is a pushout.

## Implementation notes

`S` is an arbitrary `R`-algebra: there is no flatness hypothesis. The proof never compares
`S ⊗[R] 𝒜 i` with a submodule of `S ⊗[R] A`; it works throughout with the `R`-linear projections
`GradedAlgebra.proj 𝒜 i : A → A`, which commute with base change because they are maps of
`R`-modules. A fraction `a / fⁿ` is recorded as the image of `a` under `a ↦ a_{n • d} / fⁿ`; a
fraction that dies in `(S ⊗[R] A)_(1 ⊗ f)` is killed by a power of `1 ⊗ f`, and that annihilation
already holds before passing to fractions, so it holds in `S ⊗[R] A_(f)`.

The grading index of the homogeneous localization lies in `Type`, so that the localization stays
in the universe of the rings and can be bundled as a `CommRingCat`.

## References

* [Stacks, Lemma 27.11.6 (Tag 01N2)](https://stacks.math.columbia.edu/tag/01N2), whose proof
  reduces to the identity `(S ⊗_R A)_(1 ⊗ f) = S ⊗_R A_(f)` on standard charts.

## Tags

graded algebra, base change, tensor product, homogeneous localization, irrelevant ideal
-/

universe u

open CategoryTheory TensorProduct

namespace GradedRingHom

section

variable {ι R A : Type*} (S : Type*) [CommRing R] [CommRing S] [Algebra R S] [CommRing A]
  [Algebra R A] (𝒜 : ι → Submodule R A)

/-- `a ↦ 1 ⊗ a`, as a graded ring map from `𝒜` to its base change, graded over `S`.

Mathlib's `GradedAlgHom.includeRight` is the same map with the target grading restricted back to
`R`; `Proj` of the base change is formed with the grading over `S`, so the map is recorded with
that target. -/
def includeRight : 𝒜 →+*ᵍ fun i ↦ (𝒜 i).baseChange S where
  toRingHom := Algebra.TensorProduct.includeRight.toRingHom
  map_mem hx := Submodule.tmul_mem_baseChange_of_mem 1 hx

@[simp]
lemma includeRight_apply (a : A) : includeRight S 𝒜 a = 1 ⊗ₜ a :=
  rfl

end

variable {R A : Type*} (S : Type*) [CommRing R] [CommRing S] [Algebra R S] [CommRing A]
  [Algebra R A] (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]

/-- The irrelevant ideal of the base change is generated by the image of the irrelevant ideal:
`s ⊗ a = (s ⊗ 1) (1 ⊗ a)`. This is the hypothesis `Proj.map` asks of `includeRight`. -/
theorem irrelevant_baseChange_le_map :
    HomogeneousIdeal.irrelevant (fun i ↦ (𝒜 i).baseChange S) ≤
      (HomogeneousIdeal.irrelevant 𝒜).map (includeRight S 𝒜) := by
  rw [HomogeneousIdeal.irrelevant_le]
  intro i hi x hx
  change x ∈ (HomogeneousIdeal.irrelevant 𝒜).toIdeal.map (includeRight S 𝒜)
  rw [Submodule.baseChange_eq_span] at hx
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨a, ha, rfl⟩ := hy
    exact Ideal.mem_map_of_mem _ (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 hi ha)
  | zero => exact zero_mem _
  | add y z _ _ hy hz => exact add_mem hy hz
  | smul s y _ hy =>
    rw [Algebra.smul_def]
    exact Ideal.mul_mem_left _ _ hy

section Bijective

variable {ι A B σ τ : Type*} [DecidableEq ι] [AddMonoid ι] [CommRing A] [SetLike σ A]
  [AddSubgroupClass σ A] [CommRing B] [SetLike τ B] [AddSubgroupClass τ B]
  {𝒜 : ι → σ} {ℬ : ι → τ} [GradedRing 𝒜] [GradedRing ℬ] (f : 𝒜 →+*ᵍ ℬ)
  (hf : Function.Bijective f)

/-- The inverse of a bijective graded ring map is graded, because a graded ring map commutes
with the two decompositions. -/
noncomputable def symmOfBijective : ℬ →+*ᵍ 𝒜 where
  toRingHom := (RingEquiv.ofBijective f.toRingHom hf).symm.toRingHom
  map_mem {i y} hy := by
    classical
    set e := RingEquiv.ofBijective f.toRingHom hf
    change e.symm y ∈ 𝒜 i
    rw [← DirectSum.sum_support_decompose 𝒜 (e.symm y)]
    refine sum_mem fun j _ ↦ ?_
    by_cases hj : j = i
    · subst hj
      exact SetLike.coe_mem _
    · have h0 : f (DirectSum.decompose 𝒜 (e.symm y) j) = f 0 := by
        rw [map_directSumDecompose 𝒜 ℬ f, map_zero]
        change (DirectSum.decompose ℬ (e (e.symm y)) j : B) = 0
        rw [e.apply_symm_apply, DirectSum.decompose_of_mem_ne ℬ hy (Ne.symm hj)]
      rw [hf.1 h0]
      exact zero_mem _

@[simp]
lemma symmOfBijective_apply_apply (x : A) : symmOfBijective f hf (f x) = x :=
  (RingEquiv.ofBijective f.toRingHom hf).symm_apply_apply x

@[simp]
lemma apply_symmOfBijective_apply (y : B) : f (symmOfBijective f hf y) = y :=
  (RingEquiv.ofBijective f.toRingHom hf).apply_symm_apply y

lemma bijective_symmOfBijective : Function.Bijective (symmOfBijective f hf) :=
  (RingEquiv.ofBijective f.toRingHom hf).symm.bijective

end Bijective

variable {A B σ τ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
  [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
  (f : 𝒜 →+*ᵍ ℬ)

/-- A bijective graded ring map carries the irrelevant ideal onto the irrelevant ideal, which
is the hypothesis of `Proj.map`. -/
theorem irrelevant_le_map_of_bijective (hf : Function.Bijective f) :
    HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒜).map f := by
  rw [HomogeneousIdeal.irrelevant_le]
  intro i hi y hy
  rw [← apply_symmOfBijective_apply f hf y]
  exact Ideal.mem_map_of_mem _
    (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 hi ((symmOfBijective f hf).map_mem hy))

end GradedRingHom

namespace HomogeneousLocalization

variable {ι : Type} {R S A : Type u} [CommRing R] [CommRing S] [Algebra R S] [CommRing A]
  [Algebra R A] [AddCancelCommMonoid ι] [DecidableEq ι] {𝒜 : ι → Submodule R A} [GradedAlgebra 𝒜]

/-- The `R`-algebra structure on a homogeneous localization of a graded `R`-algebra, through
`R → 𝒜 0`. The scalar action is Mathlib's existing one, so no second `R`-action is introduced. -/
@[instance_reducible]
private def algebraOfGraded (x : Submonoid A) : Algebra R (HomogeneousLocalization 𝒜 x) where
  toSMul := inferInstance
  algebraMap := (fromZeroRingHom 𝒜 x).comp (algebraMap R (𝒜 0))
  commutes' _ _ := mul_comm _ _
  smul_def' r y := by
    apply val_injective
    rw [val_smul, val_mul, Algebra.smul_def, IsScalarTower.algebraMap_apply R A (Localization x)]
    congr 1

attribute [local instance] algebraOfGraded

omit [AddCancelCommMonoid ι] [DecidableEq ι] [GradedAlgebra 𝒜] in
private lemma val_smul' (x : Submonoid A) (r : R) (y : HomogeneousLocalization 𝒜 x) :
    (r • y).val = r • y.val :=
  val_smul x r y

variable {f : A} {d : ι} (hf : f ∈ 𝒜 d)

/-- `a ↦ a_{n • d} / fⁿ`, the degree-`n • d` component of `a` over `fⁿ`. -/
private def Away.projMk (n : ℕ) : A →ₗ[R] Away 𝒜 f where
  toFun a := Away.mk 𝒜 hf n (GradedAlgebra.proj 𝒜 (n • d) a)
    (by rw [GradedAlgebra.proj_apply]; exact SetLike.coe_mem _)
  map_add' a b := by
    apply val_injective
    simp [Localization.add_mk_self]
  map_smul' r a := by
    apply val_injective
    rw [val_smul']
    simp [Localization.smul_mk]

private lemma Away.projMk_of_mem (n : ℕ) {a : A} (ha : a ∈ 𝒜 (n • d)) :
    Away.projMk hf n a = Away.mk 𝒜 hf n a ha := by
  apply val_injective
  simp [Away.projMk, DirectSum.decompose_of_mem_same 𝒜 ha]

private lemma Away.projMk_mul (n k : ℕ) (a : A) :
    Away.projMk hf (n + k) (f ^ k * a) = Away.projMk hf n a := by
  apply val_injective
  have hk : f ^ k ∈ 𝒜 (k • d) := SetLike.pow_mem_graded k hf
  have hdeg : (n + k) • d = k • d + n • d := by rw [add_smul, add_comm]
  have hproj : (DirectSum.decompose 𝒜 (f ^ k * a) ((n + k) • d) : A) =
      f ^ k * (DirectSum.decompose 𝒜 a (n • d) : A) := by
    rw [hdeg]
    exact DirectSum.coe_decompose_mul_add_of_left_mem 𝒜 hk
  simp only [Away.projMk, LinearMap.coe_mk, AddHom.coe_mk, Away.val_mk,
    GradedAlgebra.proj_apply, hproj]
  rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  exact ⟨1, by simp only [OneMemClass.coe_one, one_mul, pow_add]; ring⟩

private lemma Away.projMk_comp_proj (n : ℕ) :
    Away.projMk hf n ∘ₗ GradedAlgebra.proj 𝒜 (n • d) = Away.projMk hf n := by
  ext a
  have h : GradedAlgebra.proj 𝒜 (n • d) a ∈ 𝒜 (n • d) := by
    rw [GradedAlgebra.proj_apply]; exact SetLike.coe_mem _
  rw [LinearMap.comp_apply, Away.projMk_of_mem hf n h]
  rfl

variable (S)

/-- The degree-`k` projection of the base change is the base change of the degree-`k`
projection, as a map of `S`-modules; it lands in degree `k`. -/
private lemma baseChange_proj_mem (k : ι) (w : S ⊗[R] A) :
    (GradedAlgebra.proj 𝒜 k).baseChange S w ∈ (𝒜 k).baseChange S := by
  induction w with
  | tmul t a =>
    rw [LinearMap.baseChange_tmul, ← mul_one t, ← smul_eq_mul, ← smul_tmul']
    exact Submodule.smul_mem _ t (Submodule.tmul_mem_baseChange_of_mem 1
      (by rw [GradedAlgebra.proj_apply]; exact SetLike.coe_mem _))
  | add x y hx hy => rw [map_add]; exact add_mem hx hy

/-- The base-changed projection fixes the base-changed degree-`k` piece. -/
private lemma baseChange_proj_of_mem (k : ι) {x : S ⊗[R] A} (hx : x ∈ (𝒜 k).baseChange S) :
    (GradedAlgebra.proj 𝒜 k).baseChange S x = x := by
  rw [Submodule.baseChange_eq_span] at hx
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨a, ha, rfl⟩ := hy
    simp [DirectSum.decompose_of_mem_same 𝒜 ha]
  | zero => simp
  | add y z _ _ hy hz => rw [map_add, hy, hz]
  | smul s y _ hy => rw [LinearMap.map_smul, hy]

variable (𝒜) in
/-- `S → (S ⊗[R] A)_(1 ⊗ f)`, through the degree-zero part. -/
private abbrev Away.baseChangeLeft :
    S →+* Away (fun i ↦ (𝒜 i).baseChange S) (GradedRingHom.includeRight S 𝒜 f) :=
  (fromZeroRingHom (fun i ↦ (𝒜 i).baseChange S) _).comp (algebraMap S ((𝒜 0).baseChange S))

private lemma Away.baseChange_comm :
    CommRingCat.ofHom (algebraMap R S) ≫ CommRingCat.ofHom (Away.baseChangeLeft S 𝒜 (f := f)) =
      CommRingCat.ofHom (algebraMap R (Away 𝒜 f)) ≫
        CommRingCat.ofHom (Away.map (GradedRingHom.includeRight S 𝒜) f) := by
  ext r
  simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply, CommRingCat.hom_ofHom]
  change Localization.mk _ 1 = Localization.mk _ 1
  congr 1
  simp only [GradedAlgebra.coe_algebraMap_apply, GradedRingHom.includeRight_apply,
    SetLike.GradeZero.coe_algebraMap]
  rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, smul_tmul]

/-- The canonical comparison `S ⊗[R] A_(f) ⟶ (S ⊗[R] A)_(1 ⊗ f)`. -/
private noncomputable abbrev Away.baseChangeHom :
    CommRingCat.of (S ⊗[R] Away 𝒜 f) ⟶
      CommRingCat.of (Away (fun i ↦ (𝒜 i).baseChange S) (GradedRingHom.includeRight S 𝒜 f)) :=
  (CommRingCat.isPushout_tensorProduct R S (Away 𝒜 f)).desc
    (CommRingCat.ofHom (Away.baseChangeLeft S 𝒜)) _ (Away.baseChange_comm S)

private lemma Away.baseChangeHom_tmul (t : S) (z : Away 𝒜 f) :
    Away.baseChangeHom S (t ⊗ₜ z) =
      Away.baseChangeLeft S 𝒜 t * Away.map (GradedRingHom.includeRight S 𝒜) f z := by
  have h₁ := congr($((CommRingCat.isPushout_tensorProduct R S (Away 𝒜 f)).inl_desc
    (CommRingCat.ofHom (Away.baseChangeLeft S 𝒜)) _ (Away.baseChange_comm S)) t)
  have h₂ := congr($((CommRingCat.isPushout_tensorProduct R S (Away 𝒜 f)).inr_desc
    (CommRingCat.ofHom (Away.baseChangeLeft S 𝒜)) _ (Away.baseChange_comm S)) z)
  simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply,
    CommRingCat.hom_ofHom] at h₁ h₂
  have h : t ⊗ₜ[R] z = Algebra.TensorProduct.includeLeftRingHom t *
      Algebra.TensorProduct.includeRight.toRingHom z := by
    simp [Algebra.TensorProduct.tmul_mul_tmul]
  rw [h, map_mul]
  erw [h₁, h₂]
  rfl

private lemma Away.val_baseChangeHom_lTensor_projMk (n : ℕ) (w : S ⊗[R] A) :
    (Away.baseChangeHom S (LinearMap.lTensor S (Away.projMk hf n) w)).val =
      Localization.mk ((GradedAlgebra.proj 𝒜 (n • d)).baseChange S w)
        (⟨_, n, rfl⟩ : Submonoid.powers (GradedRingHom.includeRight S 𝒜 f)) := by
  induction w with
  | tmul t a =>
    rw [LinearMap.lTensor_tmul, Away.baseChangeHom_tmul, val_mul, Away.projMk]
    simp only [LinearMap.coe_mk, AddHom.coe_mk, Away.map_mk, Away.val_mk,
      LinearMap.baseChange_tmul]
    change Localization.mk _ 1 * _ = _
    rw [Localization.mk_mul]
    congr 1
    · simp only [GradedRingHom.includeRight_apply, GradedAlgebra.coe_algebraMap_apply,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    · exact Subtype.ext (one_mul _)
  | add x y hx hy =>
    rw [map_add, map_add, val_add, hx, hy, map_add, Localization.add_mk_self]

/-- Every element of `S ⊗[R] A_(f)` has a common denominator `fⁿ`: it is the image of some
`w : S ⊗[R] A` under `a ↦ a_{n • d} / fⁿ`. -/
private lemma Away.exists_lTensor_projMk (z : S ⊗[R] Away 𝒜 f) :
    ∃ n w, LinearMap.lTensor S (Away.projMk hf n) w = z := by
  induction z using TensorProduct.inductionOn with
  | tmul t y =>
    obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective 𝒜 hf y
    exact ⟨n, t ⊗ₜ a, by rw [LinearMap.lTensor_tmul, Away.projMk_of_mem hf n ha]⟩
  | add x y hx hy =>
    obtain ⟨n, w, rfl⟩ := hx
    obtain ⟨m, v, rfl⟩ := hy
    refine ⟨n + m, LinearMap.lTensor S (LinearMap.mulLeft R (f ^ m)) w +
      LinearMap.lTensor S (LinearMap.mulLeft R (f ^ n)) v, ?_⟩
    have e₁ : Away.projMk hf (n + m) ∘ₗ LinearMap.mulLeft R (f ^ m) = Away.projMk hf n :=
      LinearMap.ext fun a ↦ Away.projMk_mul hf n m a
    have e₂ : Away.projMk hf (n + m) ∘ₗ LinearMap.mulLeft R (f ^ n) = Away.projMk hf m :=
      LinearMap.ext fun a ↦ (congrArg (Away.projMk hf · (f ^ n * a)) (add_comm n m)).trans
        (Away.projMk_mul hf m n a)
    rw [map_add, ← LinearMap.lTensor_comp_apply, ← LinearMap.lTensor_comp_apply, e₁, e₂]

include hf in
private lemma Away.baseChangeHom_injective :
    Function.Injective (Away.baseChangeHom S (𝒜 := 𝒜) (f := f)) := by
  rw [injective_iff_map_eq_zero]
  intro z hz
  obtain ⟨n, w, rfl⟩ := Away.exists_lTensor_projMk S hf z
  -- A fraction that dies is killed by a power of `1 ⊗ f` before passing to fractions.
  have h0 := congrArg HomogeneousLocalization.val hz
  rw [Away.val_baseChangeHom_lTensor_projMk, val_zero, Localization.mk_eq_mk',
    IsLocalization.mk'_eq_zero_iff] at h0
  obtain ⟨⟨_, m, rfl⟩, hm⟩ := h0
  clear hz
  have hkill : LinearMap.lTensor S (LinearMap.mulLeft R (f ^ m) ∘ₗ
      GradedAlgebra.proj 𝒜 (n • d)) w = 0 := by
    rw [← hm]
    clear hm
    induction w with
    | tmul t a => simp [Algebra.TensorProduct.tmul_mul_tmul]
    | add x y hx hy => rw [map_add, hx, hy, map_add, mul_add]
  have hfactor : Away.projMk hf n = Away.projMk hf (n + m) ∘ₗ
      (LinearMap.mulLeft R (f ^ m) ∘ₗ GradedAlgebra.proj 𝒜 (n • d)) := by
    rw [← Away.projMk_comp_proj hf n]
    exact LinearMap.ext fun a ↦ (Away.projMk_mul hf n m _).symm
  rw [hfactor, LinearMap.lTensor_comp_apply, hkill, map_zero]

include hf in
private lemma Away.baseChangeHom_surjective :
    Function.Surjective (Away.baseChangeHom S (𝒜 := 𝒜) (f := f)) := by
  intro y
  obtain ⟨n, x, hx, rfl⟩ := Away.mk_surjective (fun i ↦ (𝒜 i).baseChange S)
    ((GradedRingHom.includeRight S 𝒜).map_mem hf) y
  refine ⟨LinearMap.lTensor S (Away.projMk hf n) x, val_injective _ ?_⟩
  rw [Away.val_baseChangeHom_lTensor_projMk, baseChange_proj_of_mem S _ hx, Away.val_mk]
  rfl

include hf in
/-- **Homogeneous localization commutes with base change** (no flatness): the square
`R → S`, `R → A_(f)`, `S → (S ⊗[R] A)_(1 ⊗ f)`, `A_(f) → (S ⊗[R] A)_(1 ⊗ f)` is a pushout of
commutative rings, that is, `S ⊗[R] A_(f) ≅ (S ⊗[R] A)_(1 ⊗ f)`. -/
theorem Away.isPushout_baseChange :
    IsPushout (CommRingCat.ofHom (algebraMap R S))
      (CommRingCat.ofHom ((fromZeroRingHom 𝒜 (Submonoid.powers f)).comp (algebraMap R (𝒜 0))))
      (CommRingCat.ofHom ((fromZeroRingHom (fun i ↦ (𝒜 i).baseChange S) (Submonoid.powers
        (GradedRingHom.includeRight S 𝒜 f))).comp (algebraMap S ((𝒜 0).baseChange S))))
      (CommRingCat.ofHom (Away.map (GradedRingHom.includeRight S 𝒜) f)) := by
  have : IsIso (Away.baseChangeHom S (𝒜 := 𝒜) (f := f)) :=
    (ConcreteCategory.isIso_iff_bijective (Away.baseChangeHom S (𝒜 := 𝒜) (f := f))).2
      ⟨Away.baseChangeHom_injective S hf, Away.baseChangeHom_surjective S hf⟩
  exact (CommRingCat.isPushout_tensorProduct R S (Away 𝒜 f)).of_iso (Iso.refl _) (Iso.refl _)
    (Iso.refl _) (asIso (Away.baseChangeHom S)) (by simp) (by simp; rfl)
    (by simp [Away.baseChangeHom]; rfl) (by simp [Away.baseChangeHom])

end HomogeneousLocalization
