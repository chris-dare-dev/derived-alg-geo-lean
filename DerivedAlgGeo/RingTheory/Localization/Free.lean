/-!
# Generic freeness

Let `R` be a Noetherian ring, `S` a finite type `R`-algebra and `M` a finite `S`-module. If `R`
is a domain, then `M_f` is free over `R_f` for some nonzero `f ∈ R`; more generally, for a
prime `p` of `R` whose local ring `R_p` is a field, there is such an `f ∉ p`.

## Main results

* `Module.exists_notMem_free_localizedModule_away_of_finiteType`: if `R_p` is a field, then
  `M_f` is free over `R_f` for some `f ∉ p`.
* `Module.exists_notMem_free_localizedModule_away_of_mem_minimalPrimes`: the same for a minimal
  prime `p` of a reduced ring.
* `Module.exists_free_localizedModule_away_of_finiteType`: generic freeness over a Noetherian
  domain, with `f ≠ 0`.

## Proof

The proof is by induction on the number of generators of `S` over `R`; at no step is `R`
changed. If `S` is generated by `x` over a subalgebra `S'` with fewer generators and `M` by a
finite set `t` over `S`, let `F_0 = 0` and `F_{k+1} = S' t + x F_k`. This exhausts `M` by
`S'`-submodules, each finite over `S'`. Multiplication by `x` maps `F_{k+1}/F_k` onto
`F_{k+2}/F_{k+1}`, and since `F_1/F_0` is a Noetherian `S'`-module the kernels of the
composites out of it stabilize: from some `K` on, these maps are isomorphisms. The induction
hypothesis applies to the finitely many `S'`-modules `F_{k+1}/F_k` with `k ≤ K`, and one `f ∉ p`
serves for all of them. After inverting `f`, `M_f` has an exhaustive filtration with free
successive quotients, so it is free.

The base case, `M` finite over `R`, is Mathlib's
`Module.FinitePresentation.exists_free_localizedModule_powers`: `M` is finitely presented since
`R` is Noetherian, and `M_p` is free since `R_p` is a field.

This route avoids the Noether normalization and the induction on dimension that the proofs in
the Stacks Project, EGA and Nitsure use.

## Hypotheses

* `IsNoetherianRing R` is used twice: to make `M` finitely presented over `R` in the base case,
  and to make the intermediate subalgebras Noetherian, so that the kernels stabilize. Stacks
  Lemma 051S removes it under finite presentation, by descending to a finitely generated
  `ℤ`-subalgebra of `R`; that is not done here.
* That `R_p` is a field cannot be dropped; take `S = R` in both examples. Over `R = k[t]` and
  `p = (t)`, the module `M = k[t]/(t)` is nonzero and torsion after inverting any `f ∉ p`, so it
  is never free. Over `R = k[ε]/(ε²)` and its only prime, `M = k` is not free over any `R_f` with
  `f ∉ p`, as `f` is then a unit.

## References

* [Stacks, Tag 051R](https://stacks.math.columbia.edu/tag/051R): generic freeness over a
  Noetherian domain, proved there by induction on `dim (K ⊗_R S)`.
* [Stacks, Tag 051Z](https://stacks.math.columbia.edu/tag/051Z): the reduced variant, over a dense
  open of `Spec R`.
* A. Grothendieck, *EGA IV₂*, Lemme 6.9.2: generic freeness over a Noetherian domain, proved
  there by induction on the dimension of the support of `K ⊗_R M`.
* N. Nitsure, *Construction of Hilbert and Quot schemes*, arXiv:math/0504590, Lemma 4.1.

## Tags

generic freeness, localization, finite type algebra
-/

universe u v w

open Submodule

namespace Module

section Filtration

variable {R M : Type*} [Ring R] [AddCommGroup M] [Module R M]

/-- A module with an increasing exhaustive filtration, starting at `⊥`, whose successive quotients
are free is free: lifts of bases of the quotients form a basis. -/
private theorem free_of_filtration (F : ℕ → Submodule R M) (hmono : Monotone F) (h0 : F 0 = ⊥)
    (htop : ⨆ k, F k = ⊤)
    (hfree : ∀ k, Module.Free R (F (k + 1) ⧸ (F k).comap (F (k + 1)).subtype)) :
    Module.Free R M := by
  let Q := fun k ↦ F (k + 1) ⧸ (F k).comap (F (k + 1)).subtype
  let b := fun k ↦ Module.Free.chooseBasis R (Q k)
  choose w hw using fun k i ↦ Submodule.Quotient.mk_surjective _ (b k i)
  let v : (Σ k, Module.Free.ChooseBasisIndex R (Q k)) → M := fun σ ↦ (w σ.1 σ.2 : M)
  let s : ℕ → Set (Σ k, Module.Free.ChooseBasisIndex R (Q k)) := fun k ↦ {σ | σ.1 < k}
  have hs : ∀ k, s (k + 1) = s k ∪ Set.range (Sigma.mk k) := fun k ↦ by
    ext σ
    simp only [s, Set.range_sigmaMk, Set.mem_union, Set.mem_preimage, Set.mem_singleton_iff]
    exact Nat.lt_succ_iff_lt_or_eq
  have hspan : ∀ k, span R (v '' s k) = F k := by
    intro k
    induction k with
    | zero => simp [s, h0]
    | succ k ih =>
      rw [hs, Set.image_union, span_union, ih]
      refine le_antisymm (sup_le (hmono k.le_succ) (span_le.mpr ?_)) fun m hm ↦ ?_
      · rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
        exact (w k i).2
      · obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp
          ((b k).mem_span (Submodule.Quotient.mk (⟨m, hm⟩ : F (k + 1))))
        have hsum : (⟨m, hm⟩ : F (k + 1)) - c.sum (fun i a ↦ a • w k i) ∈
            (F k).comap (F (k + 1)).subtype := by
          rw [← Submodule.Quotient.eq, ← hc, ← Submodule.mkQ_apply, map_finsuppSum]
          simp [hw]
        have hmem : c.sum (fun i a ↦ a • (w k i : M)) ∈ span R (v '' Set.range (Sigma.mk k)) :=
          Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem _ _
            (subset_span ⟨⟨k, i⟩, ⟨i, rfl⟩, rfl⟩)
        have : m = (m - c.sum (fun i a ↦ a • (w k i : M))) + c.sum (fun i a ↦ a • (w k i : M)) :=
          (sub_add_cancel _ _).symm
        rw [this]
        refine add_mem_sup ?_ hmem
        simpa [Finsupp.sum, Submodule.coe_sum] using hsum
  have hli : ∀ k, LinearIndepOn R v (s k) := by
    intro k
    induction k with
    | zero => simp [s]
    | succ k ih =>
      rw [hs]
      refine ih.union_of_quotient ?_
      rw [hspan, linearIndepOn_range_iff sigma_mk_injective]
      let e : Q k →ₗ[R] M ⧸ F k :=
        ((F k).comap (F (k + 1)).subtype).mapQ (F k) (F (k + 1)).subtype le_rfl
      have he : LinearMap.ker e = ⊥ := by
        rw [Submodule.ker_mapQ, Submodule.mkQ_map_self]
      convert (b k).linearIndependent.map' e he using 1
      ext i
      simp only [Function.comp_apply, v, ← hw, Submodule.mkQ_apply]
      rfl
  have hsUnion : (⋃ k, s k) = Set.univ :=
    Set.eq_univ_of_forall fun σ ↦ Set.mem_iUnion.mpr ⟨σ.1 + 1, Nat.lt_succ_self _⟩
  have hdir : Directed (· ⊆ ·) s := fun i j ↦
    ⟨max i j, fun σ (h : σ.1 < i) ↦ lt_max_of_lt_left h,
      fun σ (h : σ.1 < j) ↦ lt_max_of_lt_right h⟩
  have hv : LinearIndependent R v := by
    have := linearIndepOn_iUnion_of_directed hdir hli
    rwa [hsUnion, linearIndepOn_univ_iff] at this
  refine Module.Free.of_basis (Basis.mk hv ?_)
  rw [← htop]
  refine iSup_le fun k ↦ ?_
  rw [← hspan k]
  exact span_mono (Set.image_subset_range _ _)

end Filtration


section Away

variable {R M N : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M] [AddCommMonoid N]
  [Module R N]

/-- Freeness of `M_f` passes to any localization of `M` at the powers of `f`. -/
private theorem free_of_isLocalizedModule_away (f : R) {M' : Type*} [AddCommMonoid M']
    [Module R M'] [Module (Localization.Away f) M'] [IsScalarTower R (Localization.Away f) M']
    (g : M →ₗ[R] M') [IsLocalizedModule (Submonoid.powers f) g]
    [Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) M)] :
    Module.Free (Localization.Away f) M' :=
  Module.Free.of_equiv ((IsLocalizedModule.iso (Submonoid.powers f) g).extendScalarsOfIsLocalization
    (Submonoid.powers f) (Localization.Away f))

/-- Freeness of `M_f` transports along a linear equivalence `M ≃ N`. -/
private theorem free_away_of_linearEquiv (f : R) (e : M ≃ₗ[R] N)
    [Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) M)] :
    Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) N) :=
  free_of_isLocalizedModule_away f
    (LocalizedModule.mkLinearMap (Submonoid.powers f) N ∘ₗ e.toLinearMap)

/-- If `M_f` is free over `R_f`, then `M_{fg}` is free over `R_{fg}`, as the base change of
`M_f` along `R_f → R_{fg}`. -/
private theorem free_away_mul (f g : R)
    [Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) M)] :
    Module.Free (Localization.Away (f * g)) (LocalizedModule (Submonoid.powers (f * g)) M) := by
  let A₁ := Localization.Away f
  let A₂ := Localization.Away (f * g)
  let M₁ := LocalizedModule (Submonoid.powers f) M
  let M₂ := LocalizedModule (Submonoid.powers (f * g)) M
  let : Algebra A₁ A₂ := (IsLocalization.Away.awayToAwayRight f g).toAlgebra
  have : IsScalarTower R A₁ A₂ := IsScalarTower.of_algebraMap_eq fun r ↦
    (IsLocalization.Away.awayToAwayRight_eq f g r).symm
  let : Module A₁ M₂ := Module.compHom M₂ (algebraMap A₁ A₂)
  have : IsScalarTower A₁ A₂ M₂ := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  have : IsScalarTower R A₁ M₂ := IsScalarTower.of_algebraMap_smul fun r m ↦ by
    change algebraMap A₁ A₂ (algebraMap R A₁ r) • m = r • m
    rw [← IsScalarTower.algebraMap_apply, algebraMap_smul]
  let mk₁ := LocalizedModule.mkLinearMap (Submonoid.powers f) M
  let mk₂ := LocalizedModule.mkLinearMap (Submonoid.powers (f * g)) M
  have hu : ∀ x : Submonoid.powers f, IsUnit (algebraMap R (Module.End R M₂) x) := by
    rintro ⟨_, n, rfl⟩
    have h := IsLocalizedModule.map_units mk₂
      (⟨(f * g) ^ n, n, rfl⟩ : Submonoid.powers (f * g))
    simp only [mul_pow, map_mul] at h
    exact (((Commute.all (f ^ n) (g ^ n)).map (algebraMap R (Module.End R M₂))).isUnit_mul_iff.mp
      h).1
  let ψ : M₁ →ₗ[A₁] M₂ := (IsLocalizedModule.lift (Submonoid.powers f) mk₁ mk₂ hu
    ).extendScalarsOfIsLocalization (Submonoid.powers f) A₁
  have hb : IsBaseChange A₂ ((ψ : M₁ →ₗ[R] M₂) ∘ₗ mk₁) := by
    have : (ψ : M₁ →ₗ[R] M₂) ∘ₗ mk₁ = mk₂ := IsLocalizedModule.lift_comp _ _ _ hu
    rw [this]
    exact IsLocalizedModule.isBaseChange (Submonoid.powers (f * g)) A₂ mk₂
  exact (IsBaseChange.of_comp (IsLocalizedModule.isBaseChange (Submonoid.powers f) A₁ mk₁)
    hb).free

end Away

section AwayFiltration

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- If the successive quotients of a filtration as in `free_of_filtration` become free after
inverting `f`, then so does `M`: localization preserves the filtration and its quotients. -/
private theorem free_away_of_filtration (f : R) (F : ℕ → Submodule R M) (hmono : Monotone F)
    (h0 : F 0 = ⊥) (htop : ⨆ k, F k = ⊤)
    (hfree : ∀ k, Module.Free (Localization.Away f)
      (LocalizedModule (Submonoid.powers f) (F (k + 1) ⧸ (F k).comap (F (k + 1)).subtype))) :
    Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) M) := by
  let A := Localization.Away f
  let T := Submonoid.powers f
  let mk := LocalizedModule.mkLinearMap T M
  let F' : ℕ → Submodule A (LocalizedModule T M) := fun k ↦ (F k).localized' A T mk
  have hmono' : Monotone F' := fun i j hij ↦
    (Submodule.localized'gi A T mk).gc.monotone_l (hmono hij)
  refine free_of_filtration F' hmono' (by simp [F', h0])
    (by simp only [F', ← Submodule.localized'_iSup, htop, Submodule.localized'_top])
    fun k ↦ ?_
  let ν := (F (k + 1)).toLocalized' A T mk
  let P := (F k).comap (F (k + 1)).subtype
  have key : ∀ (m : F (k + 1)) (t : T),
      ((IsLocalizedModule.mk' ν m t : F' (k + 1)) : LocalizedModule T M) =
        IsLocalizedModule.mk' mk (m : M) t := by
    intro m t
    symm
    rw [IsLocalizedModule.mk'_eq_iff]
    rw [← Submodule.coe_smul_of_tower, IsLocalizedModule.mk'_cancel']
    rfl
  have heq : P.localized' A T ν = (F' k).comap (F' (k + 1)).subtype := by
    ext x
    simp only [Submodule.mem_localized', Submodule.mem_comap, Submodule.subtype_apply]
    constructor
    · rintro ⟨m, hm, t, rfl⟩
      exact ⟨m, hm, t, (key m t).symm⟩
    · rintro ⟨m, hm, t, hx⟩
      refine ⟨⟨m, hmono k.le_succ hm⟩, hm, t, Subtype.ext ?_⟩
      rw [key]
      exact hx
  have := hfree k
  have : Module.Free A (F' (k + 1) ⧸ P.localized' A T ν) :=
    free_of_isLocalizedModule_away f (P.toLocalizedQuotient' A T ν)
  exact Module.Free.of_equiv (Submodule.quotEquivOfEq _ _ heq)

end AwayFiltration

section Generic

variable {R : Type*} [CommRing R]

/-- At a minimal prime of a reduced ring the local ring is a field. -/
private theorem isField_localization_of_mem_minimalPrimes [IsReduced R] {p : Ideal R}
    [p.IsPrime] (hp : p ∈ minimalPrimes R) : IsField (Localization.AtPrime p) := by
  rw [IsLocalRing.isField_iff_maximalIdeal_eq,
    ← IsLocalization.AtPrime.map_eq_maximalIdeal p (Localization.AtPrime p),
    ← IsLocalization.AtPrime.radical_map_of_mem_minimalPrimes (Localization.AtPrime p) p ⊥ hp,
    Ideal.map_bot]
  exact nilradical_eq_zero (Localization.AtPrime p)

/-- The base case: a finite module over a Noetherian ring becomes free after inverting some
`f ∉ p`, if `R_p` is a field. -/
private theorem exists_free_away_of_finite [IsNoetherianRing R] (p : Ideal R) [p.IsPrime]
    (hp : IsField (Localization.AtPrime p)) (N : Type*) [AddCommGroup N] [Module R N]
    [Module.Finite R N] :
    ∃ f ∉ p, Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) N) := by
  have : Module.Free (Localization.AtPrime p) (LocalizedModule p.primeCompl N) := by
    let := hp.toField
    infer_instance
  have := Module.finitePresentation_of_finite R N
  obtain ⟨r, hr, hfree, -⟩ := Module.FinitePresentation.exists_free_localizedModule_powers
    p.primeCompl (LocalizedModule.mkLinearMap p.primeCompl N) (Localization.AtPrime p)
  exact ⟨r, hr, hfree⟩

/-- **The one-generator step.** Let `S` be generated over a Noetherian ring `S'` by one element
`x`, and suppose that every finite `S'`-module becomes free over `R` after inverting some
`f ∉ p`. Then so does every finite `S`-module. -/
private theorem exists_free_away_of_adjoin_singleton {S' S : Type*} {M : Type w} [CommRing S']
    [CommSemiring S] [Algebra R S'] [Algebra S' S] [IsNoetherianRing S'] (p : Ideal R) [p.IsPrime]
    (x : S) (hx : Algebra.adjoin S' {x} = ⊤) [AddCommGroup M] [Module S M] [Module S' M]
    [Module R M] [IsScalarTower S' S M] [IsScalarTower R S' M] [Module.Finite S M]
    (IH : ∀ (N : Type w) [AddCommGroup N] [Module S' N] [Module R N] [IsScalarTower R S' N]
      [Module.Finite S' N],
      ∃ f ∉ p, Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) N)) :
    ∃ f ∉ p, Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) M) := by
  obtain ⟨t, ht⟩ := Module.Finite.fg_top (R := S) (M := M)
  let F₀ : Submodule S' M := span S' (t : Set M)
  let lx : M →ₗ[S'] M := (LinearMap.lsmul S M x).restrictScalars S'
  obtain ⟨F, hF0, hFs⟩ : ∃ F : ℕ → Submodule S' M, F 0 = ⊥ ∧ ∀ k, F (k + 1) = F₀ ⊔ (F k).map lx :=
    ⟨fun k ↦ Nat.rec ⊥ (fun _ P ↦ F₀ ⊔ P.map lx) k, rfl, fun _ ↦ rfl⟩
  have hF₀ : ∀ k, F₀ ≤ F (k + 1) := fun k ↦ hFs k ▸ le_sup_left
  have hlx : ∀ k, ∀ m ∈ F k, x • m ∈ F (k + 1) := fun k m hm ↦
    hFs k ▸ le_sup_right (a := F₀) ⟨m, hm, rfl⟩
  have hmono : Monotone F := by
    refine monotone_nat_of_le_succ fun k ↦ ?_
    induction k with
    | zero => rw [hF0]; exact bot_le
    | succ k ih => rw [hFs k, hFs (k + 1)]; exact sup_le_sup_left (Submodule.map_mono ih) _
  have hfg : ∀ k, (F k).FG := by
    intro k
    induction k with
    | zero => rw [hF0]; exact fg_bot
    | succ k ih => rw [hFs]; exact (fg_span t.finite_toSet).sup (ih.map _)
  have hdir := hmono.directed_le
  have htop : ⨆ k, F k = ⊤ := by
    have hsmul : ∀ s : S, ∀ m ∈ ⨆ k, F k, s • m ∈ ⨆ k, F k := by
      intro s
      have hs : s ∈ Algebra.adjoin S' {x} := hx ▸ Algebra.mem_top
      induction hs using Algebra.adjoin_induction with
      | mem y hy =>
        rw [Set.mem_singleton_iff.mp hy]
        intro m hm
        obtain ⟨k, hk⟩ := (Submodule.mem_iSup_of_directed F hdir).mp hm
        exact Submodule.mem_iSup_of_mem (k + 1) (hlx k m hk)
      | algebraMap c =>
        intro m hm
        rw [algebraMap_smul]
        exact Submodule.smul_mem _ c hm
      | add a b _ _ ha hb =>
        intro m hm
        rw [add_smul]
        exact add_mem (ha m hm) (hb m hm)
      | mul a b _ _ ha hb =>
        intro m hm
        rw [mul_smul]
        exact ha _ (hb m hm)
    let N : Submodule S M :=
      { toAddSubmonoid := (⨆ k, F k).toAddSubmonoid
        smul_mem' := hsmul }
    have hN : (⊤ : Submodule S M) ≤ N := by
      rw [← ht, span_le]
      intro m hm
      exact Submodule.mem_iSup_of_mem 1 (hF₀ 0 (subset_span hm))
    exact eq_top_iff.mpr fun m _ ↦ hN Submodule.mem_top
  -- The successive quotients, and multiplication by `x` between them.
  let Q : ℕ → Type w := fun k ↦ F (k + 1) ⧸ (F k).comap (F (k + 1)).subtype
  have : ∀ k, Module.Finite S' (F k) := fun k ↦ Module.Finite.iff_fg.mpr (hfg k)
  let φ : ∀ k, Q k →ₗ[S'] Q (k + 1) := fun k ↦
    Submodule.mapQ _ _ (lx.restrict fun m hm ↦ hlx (k + 1) m hm) fun m hm ↦ hlx k m hm
  have hφ : ∀ k, Function.Surjective (φ k) := by
    intro k
    rintro ⟨⟨m, hm⟩⟩
    rw [hFs (k + 1)] at hm
    obtain ⟨a, ha, _, ⟨b, hb, rfl⟩, hab⟩ := Submodule.mem_sup.mp hm
    refine ⟨Submodule.Quotient.mk ⟨b, hb⟩, ?_⟩
    change Submodule.Quotient.mk _ = Submodule.Quotient.mk _
    rw [Submodule.Quotient.eq]
    change x • b - m ∈ F (k + 1)
    have : x • b - m = -a := by rw [← hab]; change x • b - (a + x • b) = -a; abel
    rw [this]
    exact neg_mem (hF₀ k ha)
  obtain ⟨ψ, hψ0, hψs⟩ : ∃ ψ : ∀ k, Q 0 →ₗ[S'] Q k,
      ψ 0 = LinearMap.id ∧ ∀ k, ψ (k + 1) = φ k ∘ₗ ψ k :=
    ⟨fun k ↦ Nat.rec (motive := fun k ↦ Q 0 →ₗ[S'] Q k) LinearMap.id (fun k ψk ↦ φ k ∘ₗ ψk) k,
      rfl, fun _ ↦ rfl⟩
  have hψ : ∀ k, Function.Surjective (ψ k) := by
    intro k
    induction k with
    | zero => rw [hψ0]; exact Function.surjective_id
    | succ k ih => rw [hψs]; exact (hφ k).comp ih
  -- The kernels of `ψ k` stabilize, so `φ k` is an isomorphism from some `K` on.
  have : IsNoetherian S' (Q 0) := isNoetherian_of_isNoetherianRing_of_finite S' (Q 0)
  obtain ⟨K, hK⟩ := monotone_stabilizes_iff_noetherian.mpr this
    ⟨fun k ↦ LinearMap.ker (ψ k), monotone_nat_of_le_succ fun k ↦ by
      rw [hψs]; exact LinearMap.ker_le_ker_comp _ _⟩
  have hinj : ∀ k, K ≤ k → Function.Injective (φ k) := by
    intro k hk
    rw [← LinearMap.ker_eq_bot, eq_bot_iff]
    intro y hy
    obtain ⟨z, rfl⟩ := hψ k y
    have hz : z ∈ LinearMap.ker (ψ (k + 1)) := by
      rw [LinearMap.mem_ker, hψs, LinearMap.comp_apply]
      exact hy
    have h₁ : LinearMap.ker (ψ K) = LinearMap.ker (ψ (k + 1)) := hK (k + 1) (by omega)
    have h₂ : LinearMap.ker (ψ K) = LinearMap.ker (ψ k) := hK k hk
    rw [← h₁, h₂] at hz
    exact hz
  -- One `f ∉ p` for the finitely many quotients `Q 0, …, Q K`, hence for all of them.
  choose g hgp hgfree using fun k ↦ IH (Q k)
  obtain ⟨f, hfp, hfd⟩ : ∃ f ∉ p, ∀ k ≤ K, g k ∣ f :=
    ⟨∏ k ∈ Finset.range (K + 1), g k,
      Submonoid.prod_mem p.primeCompl fun k _ ↦ hgp k,
      fun k hk ↦ Finset.dvd_prod_of_mem g (Finset.mem_range.mpr (by omega))⟩
  have hQle : ∀ k ≤ K, Module.Free (Localization.Away f)
      (LocalizedModule (Submonoid.powers f) (Q k)) := by
    intro k hk
    obtain ⟨c, hc⟩ := hfd k hk
    subst hc
    have := hgfree k
    exact free_away_mul (g k) c
  have hQge : ∀ j, Module.Free (Localization.Away f)
      (LocalizedModule (Submonoid.powers f) (Q (K + j))) := by
    intro j
    induction j with
    | zero => exact hQle K le_rfl
    | succ j ih =>
      exact free_away_of_linearEquiv f
        ((LinearEquiv.ofBijective (φ (K + j)) ⟨hinj _ (by omega), hφ _⟩).restrictScalars R)
  have hQ : ∀ k, Module.Free (Localization.Away f)
      (LocalizedModule (Submonoid.powers f) (Q k)) := by
    intro k
    rcases le_or_gt k K with hk | hk
    · exact hQle k hk
    · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hk.le
      exact hQge j
  refine ⟨f, hfp, free_away_of_filtration f (fun k ↦ (F k).restrictScalars R)
    (fun i j hij ↦ hmono hij) (by simp [hF0]) ?_ fun k ↦ hQ k⟩
  refine eq_top_iff.mpr fun m _ ↦ ?_
  obtain ⟨k, hk⟩ := (Submodule.mem_iSup_of_directed F hdir).mp (htop ▸ Submodule.mem_top)
  exact Submodule.mem_iSup_of_mem k hk

/-- Generic freeness for an algebra generated by `n` elements, by induction on `n`. -/
private theorem exists_free_away_of_adjoin_eq_top [IsNoetherianRing R] (p : Ideal R) [p.IsPrime]
    (hp : IsField (Localization.AtPrime p)) (n : ℕ) :
    ∀ {S : Type v} [CommRing S] [Algebra R S] (g : Fin n → S),
      Algebra.adjoin R (Set.range g) = ⊤ →
      ∀ (M : Type w) [AddCommGroup M] [Module S M] [Module R M] [IsScalarTower R S M]
        [Module.Finite S M],
        ∃ f ∉ p, Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) M) := by
  induction n with
  | zero =>
    intro S _ _ g hg M _ _ _ _ _
    have : Module.Finite R S := by
      rw [Set.range_eq_empty, Algebra.adjoin_empty] at hg
      refine ⟨?_⟩
      rw [← Algebra.top_toSubmodule, ← hg, Algebra.toSubmodule_bot, Submodule.one_eq_span]
      exact fg_span_singleton 1
    have : Module.Finite R M := Module.Finite.trans S M
    exact exists_free_away_of_finite p hp M
  | succ n ih =>
    intro S _ _ g hg M _ _ _ _ _
    let S' := Algebra.adjoin R (Set.range (Fin.tail g))
    have : IsNoetherianRing S' := isNoetherianRing_of_fg
      (Subalgebra.fg_def.mpr ⟨_, Set.finite_range _, rfl⟩)
    let g' : Fin n → S' := fun i ↦ ⟨Fin.tail g i, Algebra.subset_adjoin ⟨i, rfl⟩⟩
    have hg' : Algebra.adjoin R (Set.range g') = ⊤ := by
      convert Algebra.adjoin_adjoin_coe_preimage (R := R) (s := Set.range (Fin.tail g)) using 2
      ext y
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨i, rfl⟩
      · rintro ⟨i, hi⟩
        exact ⟨i, Subtype.ext hi⟩
    have hx : Algebra.adjoin S' {g 0} = ⊤ := by
      rw [← Fin.cons_self_tail g, Fin.range_cons, Set.insert_eq, Set.union_comm,
        Algebra.adjoin_union_eq_adjoin_adjoin] at hg
      exact Subalgebra.restrictScalars_injective R
        (hg.trans (Subalgebra.restrictScalars_top R).symm)
    exact exists_free_away_of_adjoin_singleton p (g 0) hx fun N _ _ _ _ _ ↦ ih g' hg' N

end Generic

section Main

variable {R : Type u} (S : Type v) {M : Type w} [CommRing R] [IsNoetherianRing R] [CommRing S]
  [Algebra R S] [Algebra.FiniteType R S] [AddCommGroup M] [Module R M] [Module S M]
  [IsScalarTower R S M] [Module.Finite S M]

include S

/-- **Generic freeness at a prime.** Let `R` be Noetherian, `S` a finite type `R`-algebra and
`M` a finite `S`-module. If `p` is a prime of `R` whose local ring `R_p` is a field, then `M_f`
is free over `R_f` for some `f ∉ p`.

Both hypotheses on `R` are used; see the module docstring, which also gives witnesses that the
condition on `R_p` cannot be dropped. -/
theorem exists_notMem_free_localizedModule_away_of_finiteType (p : Ideal R) [p.IsPrime]
    (hp : IsField (Localization.AtPrime p)) :
    ∃ f ∉ p, Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) M) := by
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := R) (A := S)
  refine exists_free_away_of_adjoin_eq_top p hp s.card (fun i ↦ (s.equivFin.symm i : S)) ?_ M
  convert hs
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    exact (s.equivFin.symm i).2
  · intro hx
    exact ⟨s.equivFin ⟨x, hx⟩, by simp⟩

/-- **Generic freeness at a minimal prime of a reduced ring.** Let `R` be a reduced Noetherian
ring, `S` a finite type `R`-algebra and `M` a finite `S`-module. For every minimal prime `p`
of `R`, `M_f` is free over `R_f` for some `f ∉ p`.

This is the pointwise content of Stacks Lemma 051Z for Noetherian `R`: the `D(f)` so obtained,
one for each of the finitely many minimal primes, cover a dense open of `Spec R`. -/
@[stacks 051Z "pointwise, for Noetherian `R`"]
theorem exists_notMem_free_localizedModule_away_of_mem_minimalPrimes [IsReduced R] (p : Ideal R)
    (hp : p ∈ minimalPrimes R) :
    ∃ f ∉ p, Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) M) := by
  have : p.IsPrime := hp.1.1
  exact exists_notMem_free_localizedModule_away_of_finiteType S p
    (isField_localization_of_mem_minimalPrimes hp)

/-- **Generic freeness** (Stacks Lemma 051R). Let `R` be a Noetherian domain, `S` a finite
type `R`-algebra and `M` a finite `S`-module. Then `M_f` is free over `R_f` for some nonzero
`f ∈ R`. -/
@[stacks 051R]
theorem exists_free_localizedModule_away_of_finiteType [IsDomain R] :
    ∃ f : R, f ≠ 0 ∧
      Module.Free (Localization.Away f) (LocalizedModule (Submonoid.powers f) M) := by
  obtain ⟨f, hf, h⟩ := exists_notMem_free_localizedModule_away_of_mem_minimalPrimes S (M := M)
    (⊥ : Ideal R) (by rw [IsDomain.minimalPrimes_eq_singleton_bot]; rfl)
  exact ⟨f, fun h0 ↦ hf (h0 ▸ Submodule.zero_mem _), h⟩

end Main

end Module
