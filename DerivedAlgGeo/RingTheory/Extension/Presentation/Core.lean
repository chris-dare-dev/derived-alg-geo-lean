import Mathlib.Algebra.Module.FinitePresentation
import Mathlib.RingTheory.Extension.Presentation.Core
import Mathlib.RingTheory.TensorProduct.IsBaseChangePi
import Mathlib.RingTheory.TensorProduct.IsBaseChangeRightExact

/-!
# Noetherian models of a finitely presented algebra and module

Mathlib's `Mathlib/RingTheory/Extension/Presentation/Core.lean` descends a presentation of an
`R`-algebra `A` to any subring `R₀ ⊆ R` containing the coefficients of its relations. This file
adds the module half: a finitely presented `A`-module descends along the same kind of subring.

## Main results

* `Module.FinitePresentation.exists_noetherian_model`: EGA IV₃ (8.9.1) for one algebra and one
  module, the module half of Stacks 00R1.

## Implementation notes

The algebra half is `Algebra.Presentation.tensorModelOfHasCoeffsEquiv`. For the module half choose
a presentation `Aᵐ --Φ--> Aⁿ → M → 0`. The entries of `Φ` lie in `A`, which is a quotient of a
polynomial ring and has no coefficients, so each is lifted to `MvPolynomial ι R` first. The
subalgebra `R₀` is generated by the coefficients of the relations of the presentation of `A` and of
these lifts. The module model is the cokernel of the matrix of `R₀`-coefficient lifts over the
model of `A`, and base change along `R₀ → R` is right exact
(`IsBaseChange.of_right_exact`).

As in Mathlib, the base change is written `R ⊗[R₀] -`, with `R` on the left.

## References

* EGA IV₃, (8.9.1), as used in step I of the proof of (11.2.6.1)
* [Stacks: Tag 00R1](https://stacks.math.columbia.edu/tag/00R1)

## Tags

finite presentation, Noetherian approximation, descent
-/

open TensorProduct Matrix

universe u

namespace Module.FinitePresentation

/-- **EGA IV₃ (8.9.1)**, **Stacks 00R1** for one algebra and one module. If `A` is a finitely
presented `R`-algebra and `M` a finitely presented `A`-module, then there are a finitely
generated `ℤ`-subalgebra `R₀ ⊆ R` (so `R₀` is Noetherian), a finite type `R₀`-algebra `A₀` and a
finite `A₀`-module `M₀` with `R ⊗[R₀] A₀ ≃ₐ[R] A` and `R ⊗[R₀] M₀ ≃ₗ[R] M`.

The algebra half is `Algebra.Presentation.tensorModelOfHasCoeffsEquiv`; the module half is
built here as the cokernel of a matrix over `A₀`.

Both finite presentation hypotheses are load-bearing. Let `k` be a field and
`R = k[y₁, y₂, …]`. For `(a)`, take `A = R/(y₁, y₂, …) ≅ k` and `M = A`; for `(b)`, take `A = R`
and `M = R/(y₁, y₂, …)`. Any `R₀` lies in some `k[y₁, …, y_N]`, so `R ⊗[R₀] M₀` is a polynomial
ring in `y_{N+1}, …` over `k[y₁, …, y_N] ⊗[R₀] M₀`, on which `y_{N+1}` acts injectively unless the
module is zero. But `y_{N+1}` kills `M ≠ 0`. -/
theorem exists_noetherian_model {R A M : Type u} [CommRing R] [CommRing A] [Algebra R A]
    [Algebra.FinitePresentation R A]
    [AddCommGroup M] [Module A M] [Module R M] [IsScalarTower R A M]
    [Module.FinitePresentation A M] :
    ∃ (R₀ : Subalgebra ℤ R) (A₀ : Type u) (_ : CommRing A₀) (_ : Algebra R₀ A₀)
      (M₀ : Type u) (_ : AddCommGroup M₀) (_ : Module R₀ M₀) (_ : Module A₀ M₀)
      (_ : IsScalarTower R₀ A₀ M₀),
      R₀.FG ∧ Algebra.FiniteType R₀ A₀ ∧ Module.Finite A₀ M₀ ∧
        Nonempty (R ⊗[R₀] A₀ ≃ₐ[R] A) ∧ Nonempty (R ⊗[R₀] M₀ ≃ₗ[R] M) := by
  classical
  obtain ⟨n, m, f, g, hf, hfg⟩ := Module.FinitePresentation.exists_fin' A M
  let P := Algebra.Presentation.ofFinitePresentation R A
  -- lifts of the entries of the matrix of `g` to polynomials over `R`
  have hlift : ∀ ij : Fin n × Fin m, ∃ p : MvPolynomial _ R,
      MvPolynomial.aeval P.val p = LinearMap.toMatrix' g ij.1 ij.2 := fun ij =>
    P.aeval_val_surjective _
  choose p hp using hlift
  let C : Set R := P.coeffs ∪ ⋃ ij, ((p ij).coeffs : Set R)
  have hCfin : C.Finite :=
    P.finite_coeffs.union (Set.finite_iUnion fun _ => Finset.finite_toSet _)
  let R₀ : Subalgebra ℤ R := Algebra.adjoin ℤ C
  have hR₀ : R₀.FG := ⟨hCfin.toFinset, by simp [R₀]⟩
  have hmem : ∀ x ∈ C, ∃ y : R₀, algebraMap R₀ R y = x := fun x hx =>
    ⟨⟨x, Algebra.subset_adjoin hx⟩, rfl⟩
  have : P.HasCoeffs R₀ := ⟨fun x hx => hmem x (Or.inl hx)⟩
  have hq : ∀ ij, ∃ q : MvPolynomial _ R₀, MvPolynomial.map (algebraMap R₀ R) q = p ij :=
    fun ij => MvPolynomial.mem_range_map_iff_coeffs_subset.mpr fun x hx =>
      hmem x (Or.inr (Set.mem_iUnion.2 ⟨ij, hx⟩))
  choose q hq using hq
  let A₀ := P.ModelOfHasCoeffs R₀
  let e : R ⊗[R₀] A₀ ≃ₐ[R] A := P.tensorModelOfHasCoeffsEquiv R₀
  let ρ : A₀ →ₐ[R₀] A := (e.toAlgHom.restrictScalars R₀).comp Algebra.TensorProduct.includeRight
  have hρ : ∀ x : MvPolynomial _ R₀, ρ (Ideal.Quotient.mk _ x) =
      MvPolynomial.aeval P.val (MvPolynomial.map (algebraMap R₀ R) x) := by
    intro x
    rw [MvPolynomial.aeval_map_algebraMap]
    change e (1 ⊗ₜ[R₀] Ideal.Quotient.mk _ x) = _
    rw [← P.tensorModelOfHasCoeffsEquiv_symm_tmul R₀ x]
    exact e.apply_symm_apply _
  let W : Matrix (Fin n) (Fin m) A₀ := Matrix.of fun i j => Ideal.Quotient.mk _ (q (i, j))
  have hW : W.map ρ = LinearMap.toMatrix' g := by
    ext i j
    simp [W, hρ, hq, hp]
  let Φ₀ : (Fin m → A₀) →ₗ[A₀] (Fin n → A₀) := Matrix.mulVecLin W
  let K : Submodule A₀ (Fin n → A₀) := LinearMap.range Φ₀
  -- the map `A₀ⁿ → Aⁿ`, and the maps it induces
  let h₁ : (Fin m → A₀) →ₗ[R₀] (Fin m → A) := ρ.toLinearMap.compLeft (Fin m)
  let h₂ : (Fin n → A₀) →ₗ[R₀] (Fin n → A) := ρ.toLinearMap.compLeft (Fin n)
  have hg : ∀ y, g y = LinearMap.toMatrix' g *ᵥ y := fun y => by
    have := LinearMap.congr_fun (Matrix.toLin'_toMatrix' g) y
    rw [Matrix.toLin'_apply'] at this
    exact this.symm
  have hcomm₁ : h₂.comp (Φ₀.restrictScalars R₀) =
      ((g.restrictScalars R).restrictScalars R₀).comp h₁ := by
    refine LinearMap.ext fun x => funext fun i => ?_
    change ρ.toRingHom ((W *ᵥ x) i) = g (ρ.toRingHom ∘ x) i
    rw [RingHom.map_mulVec, hg]
    exact congrFun (congrArg (· *ᵥ (ρ.toRingHom ∘ x)) hW) i
  have hker : K.restrictScalars R₀ ≤ LinearMap.ker ((f.restrictScalars R₀).comp h₂) := by
    rintro _ ⟨y, rfl⟩
    have h := LinearMap.congr_fun hcomm₁ y
    simp only [LinearMap.comp_apply] at h
    change f (h₂ (Φ₀ y)) = 0
    rw [show h₂ (Φ₀ y) = g (h₁ y) from h]
    exact (hfg (g (h₁ y))).2 ⟨h₁ y, rfl⟩
  let h₃ : (Fin n → A₀) ⧸ K →ₗ[R₀] M :=
    (K.restrictScalars R₀).liftQ ((f.restrictScalars R₀).comp h₂) hker
  have hcomm₂ : h₃.comp (K.mkQ.restrictScalars R₀) =
      ((f.restrictScalars R).restrictScalars R₀).comp h₂ :=
    LinearMap.ext fun y => by
      change (K.restrictScalars R₀).liftQ _ hker ((K.restrictScalars R₀).mkQ y) = _
      exact LinearMap.congr_fun ((K.restrictScalars R₀).liftQ_mkQ _ hker) y
  have hbc₀ : IsBaseChange R ρ.toLinearMap := IsBaseChange.of_equiv e.toLinearEquiv fun x => rfl
  have hbc₃ : IsBaseChange R h₃ :=
    IsBaseChange.of_right_exact R h₁ h₂ h₃ (f := Φ₀.restrictScalars R₀)
      (g := K.mkQ.restrictScalars R₀) (f' := g.restrictScalars R) (g' := f.restrictScalars R)
      hcomm₁ hcomm₂ (hbc₀.finitePow (Fin m)) (hbc₀.finitePow (Fin n))
      (LinearMap.exact_map_mkQ_range Φ₀) K.mkQ_surjective hfg hf
  exact ⟨R₀, A₀, inferInstance, inferInstance, (Fin n → A₀) ⧸ K, inferInstance, inferInstance,
    inferInstance, inferInstance, hR₀, inferInstance, inferInstance, ⟨e⟩, ⟨hbc₃.equiv⟩⟩

end Module.FinitePresentation
